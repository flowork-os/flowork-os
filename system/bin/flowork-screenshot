#!/usr/bin/env bash
# =============================================================================
# 📸 Flowork Sovereign OS — Headless Direct-to-Disk Screenshot Tool
# Captures desktop or window directly to $HOME/Pictures/Screenshots without GUI dialog
# Co-authored-by: Flowork OS <agent@floworkos.com>
# =============================================================================
set -e

SCREENSHOT_DIR="${FLOWORK_SCREENSHOT_DIR:-/opt/floworkos/screenshots}"
mkdir -p "$SCREENSHOT_DIR"

MODE="full"
DELAY=0
OUTPUT_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--area)
      MODE="area"
      shift
      ;;
    -w|--window)
      MODE="window"
      shift
      ;;
    -f|--file)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    -d|--delay)
      DELAY="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$OUTPUT_FILE" ]; then
  TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
  OUTPUT_FILE="$SCREENSHOT_DIR/screenshot_${TIMESTAMP}.png"
fi

# Ensure parent directory exists
mkdir -p "$(dirname "$OUTPUT_FILE")"

# Execute capture without ANY interactive dialog
if [ "$MODE" = "area" ]; then
  if command -v gnome-screenshot >/dev/null 2>&1; then
    gnome-screenshot -a -f "$OUTPUT_FILE"
  elif command -v maim >/dev/null 2>&1; then
    maim -s "$OUTPUT_FILE"
  elif command -v scrot >/dev/null 2>&1; then
    scrot -s "$OUTPUT_FILE"
  fi
elif [ "$MODE" = "window" ]; then
  if command -v gnome-screenshot >/dev/null 2>&1; then
    gnome-screenshot -w -f "$OUTPUT_FILE"
  elif command -v maim >/dev/null 2>&1; then
    maim -i "$(xdotool getactivewindow 2>/dev/null)" "$OUTPUT_FILE"
  elif command -v scrot >/dev/null 2>&1; then
    scrot -u "$OUTPUT_FILE"
  fi
else
  if command -v gnome-screenshot >/dev/null 2>&1; then
    gnome-screenshot -f "$OUTPUT_FILE"
  elif command -v maim >/dev/null 2>&1; then
    maim "$OUTPUT_FILE"
  elif command -v scrot >/dev/null 2>&1; then
    scrot "$OUTPUT_FILE"
  elif command -v import >/dev/null 2>&1; then
    import -window root "$OUTPUT_FILE"
  fi
fi

if [ -f "$OUTPUT_FILE" ]; then
  echo "$OUTPUT_FILE"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -i "$OUTPUT_FILE" "Screenshot Saved" "Captured to $(basename "$OUTPUT_FILE")" 2>/dev/null || true
  fi
  exit 0
else
  echo "❌ Error: Failed to capture screenshot to $OUTPUT_FILE" >&2
  exit 1
fi
