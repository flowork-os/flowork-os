        for cat_title, tools in categories:
            cat_box = self.build_category_box(cat_title, tools)
            body_box.pack_start(cat_box, False, False, 0)

    def build_header(self):
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        hdr.get_style_context().add_class("hub-header")

        # Title & Subtitle
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label="🛡️ FLOWORK CYBER HUB — HEAVY ARSENAL")
        title.set_halign(Gtk.Align.START)
        title.get_style_context().add_class("hub-title")

        sub = Gtk.Label(label="Sovereign Pentest, Exploitation, Reconnaissance & Forensics Command Center")
        sub.set_halign(Gtk.Align.START)
        sub.get_style_context().add_class("hub-subtitle")

        vbox.pack_start(title, False, False, 0)
        vbox.pack_start(sub, False, False, 0)
        hdr.pack_start(vbox, True, True, 0)

        # Status badge
        badge = Gtk.Label(label="METASPLOIT: ACTIVE  |  CAP_RAW: OK  |  ARSENAL: 18+ TOOLS")
        badge.get_style_context().add_class("status-badge")
        hdr.pack_end(badge, False, False, 0)

        return hdr

    def build_quick_target_card(self):
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        frame.get_style_context().add_class("card-frame")

        label = Gtk.Label(label="🎯 TARGET QUICK ENGAGEMENT CONSOLE")
        label.set_halign(Gtk.Align.START)
        label.get_style_context().add_class("section-label")
        frame.pack_start(label, False, False, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.target_entry = Gtk.Entry()
        self.target_entry.set_placeholder_text("Enter Target IP or Domain (e.g. 192.168.1.1 or scanme.nmap.org)...")
        self.target_entry.get_style_context().add_class("target-entry")
        row.pack_start(self.target_entry, True, True, 0)

        btn_scan = Gtk.Button(label="⚡ Nmap Recon")
        btn_scan.get_style_context().add_class("btn-primary-action")
        btn_scan.connect("clicked", self.on_quick_scan_clicked)
        row.pack_start(btn_scan, False, False, 0)

        btn_nikto = Gtk.Button(label="🔍 Nikto Scan")
        btn_nikto.get_style_context().add_class("btn-launch")
        btn_nikto.connect("clicked", self.on_quick_nikto_clicked)
        row.pack_start(btn_nikto, False, False, 0)

        btn_fuzz = Gtk.Button(label="🕷️ FFUF Fuzz")
        btn_fuzz.get_style_context().add_class("btn-launch")
        btn_fuzz.connect("clicked", self.on_quick_fuzz_clicked)
        row.pack_start(btn_fuzz, False, False, 0)

        frame.pack_start(row, False, False, 0)
        return frame

    def build_category_box(self, title, tools):
        cat_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl = Gtk.Label(label=title)
        lbl.set_halign(Gtk.Align.START)
        lbl.get_style_context().add_class("section-label")
        cat_box.pack_start(lbl, False, False, 0)

        for name, desc, cmd, is_gui, mode in tools:
            tool_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            tool_card.get_style_context().add_class("card-frame")

            info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            t_name = Gtk.Label(label=f"{name}  [{mode}]")
            t_name.set_halign(Gtk.Align.START)
            t_name.get_style_context().add_class("tool-name")

            t_desc = Gtk.Label(label=desc)
            t_desc.set_halign(Gtk.Align.START)
            t_desc.get_style_context().add_class("tool-desc")

            info_box.pack_start(t_name, False, False, 0)
            info_box.pack_start(t_desc, False, False, 0)
            tool_card.pack_start(info_box, True, True, 0)

            # Check if installed
            lookup_cmd = "radare2" if cmd == "r2" else cmd
            installed = shutil.which(lookup_cmd) is not None
            if installed:
                btn = Gtk.Button(label=f"Launch {name}")
                btn.get_style_context().add_class("btn-launch")
                btn.connect("clicked", self.make_tool_launcher(cmd, is_gui, name))
                tool_card.pack_end(btn, False, False, 0)
            else:
                lbl_inst = Gtk.Label(label="[ Belum Terpasang ]")
                lbl_inst.get_style_context().add_class("tool-desc")
                tool_card.pack_end(lbl_inst, False, False, 0)

            cat_box.pack_start(tool_card, False, False, 0)

        return cat_box

    def make_tool_launcher(self, cmd, is_gui, name):
        def handler(button):
            if is_gui:
                subprocess.Popen([cmd])
            else:
                term = shutil.which("alacritty") or "x-terminal-emulator"
                if cmd == "msfconsole":
                    subprocess.Popen([term, "--title", "Metasploit Console (msfconsole)", "-e", "bash", "-c", "msfconsole; read -p 'Press Enter to exit...'"])
                elif cmd == "msfvenom":
                    subprocess.Popen([term, "--title", "MSFVenom Payload Generator", "-e", "bash", "-c", "msfvenom -l payloads | head -n30; echo ''; echo 'Type msfvenom command:'; read vcmd; eval msfvenom $vcmd; read -p 'Press Enter to exit...'"])
                elif cmd == "tcpdump":
                    subprocess.Popen([term, "--title", "TCPDump Live Sniffer", "-e", "bash", "-c", "sudo tcpdump -i any -n; read -p 'Press Enter to exit...'"])
                elif cmd == "ettercap":
                    subprocess.Popen([term, "--title", "Ettercap MITM", "-e", "bash", "-c", "sudo ettercap -T -q; read -p 'Press Enter to exit...'"])
                elif cmd == "hashcat":
                    subprocess.Popen([term, "--title", "Hashcat Benchmark", "-e", "bash", "-c", "hashcat -b; read -p 'Press Enter to exit...'"])
                elif cmd == "r2":
                    subprocess.Popen([term, "--title", "Radare2 Disassembler", "-e", "bash", "-c", "echo '=== RADARE2 DISASSEMBLER ==='; echo 'Usage: r2 /path/to/binary'; r2 -h; echo ''; bash"])
                elif cmd == "proxychains4":
                    subprocess.Popen([term, "--title", "Proxychains & Tor", "-e", "bash", "-c", "echo '=== PROXYCHAINS + TOR ROUTER ==='; echo 'Starting tor service...'; sudo systemctl start tor; echo 'Tor status: ACTIVE'; echo 'Usage: proxychains4 <command> (e.g. proxychains4 curl ifconfig.me)'; bash"])
                elif cmd.startswith("impacket-"):
                    subprocess.Popen([term, "--title", f"{name}", "-e", "bash", "-c", f"{cmd} -h; echo ''; echo 'Type {cmd} command:'; read icmd; eval {cmd} $icmd; read -p 'Press Enter to exit...'"])
                else:
                    subprocess.Popen([term, "--title", f"{name} Console", "-e", "bash", "-c", f"{cmd} -h || {cmd} --help; echo ''; echo 'Type {cmd} command:'; read subcmd; eval {cmd} $subcmd; read -p 'Press Enter to exit...'"])
        return handler

    def on_quick_scan_clicked(self, button):
        target = self.target_entry.get_text().strip()
        if not target:
            target = "127.0.0.1"
        term = shutil.which("alacritty") or "x-terminal-emulator"
        cmd = f"echo '=== FLOWORK CYBER RECON: {target} ==='; nmap -sV -sC -T4 {target}; echo ''; read -p 'Press Enter to exit...'"
        subprocess.Popen([term, "--title", f"Flowork Nmap: {target}", "-e", "bash", "-c", cmd])

    def on_quick_nikto_clicked(self, button):
        target = self.target_entry.get_text().strip()
        if not target:
            target = "127.0.0.1"
        term = shutil.which("alacritty") or "x-terminal-emulator"
        cmd = f"echo '=== FLOWORK NIKTO WEB SCAN: {target} ==='; nikto -h {target}; echo ''; read -p 'Press Enter to exit...'"
        subprocess.Popen([term, "--title", f"Flowork Nikto: {target}", "-e", "bash", "-c", cmd])

    def on_quick_fuzz_clicked(self, button):
        target = self.target_entry.get_text().strip()
        if not target:
            target = "127.0.0.1"
        term = shutil.which("alacritty") or "x-terminal-emulator"
        cmd = f"echo '=== FLOWORK FFUF FUZZER: {target} ==='; ffuf -u http://{target}/FUZZ -w /usr/share/wordlists/dirb/common.txt 2>/dev/null || ffuf -u http://{target}/FUZZ -w /usr/share/wordlists/common.txt; echo ''; read -p 'Press Enter to exit...'"
        subprocess.Popen([term, "--title", f"Flowork FFUF: {target}", "-e", "bash", "-c", cmd])

def main():
    app = CyberHubWindow()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
