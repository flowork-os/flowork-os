                ("MSFVenom", "Standalone payload generator, shellcode encoder & stager", "msfvenom", False, "Terminal"),
            ]),
            ("🌐 Network Reconnaissance & Packet Sniffing", [
                ("Wireshark", "Interactive GUI packet analyzer (Non-root capture enabled)", "wireshark", True, "GUI"),
