            ("🕷️ Web Application & Bug Bounty", [
                ("ffuf", "Ultra-fast web endpoint & parameter fuzzer (Go-based)", "ffuf", False, "Terminal"),
                ("Gobuster", "High-concurrency directory, DNS & virtual host brute-forcer", "gobuster", False, "Terminal"),
                ("SQLMap", "Automated SQL injection vulnerability detector & database extractor", "sqlmap", False, "Terminal"),
                ("Nikto", "Comprehensive web server vulnerability, dangerous file & CGI scanner", "nikto", False, "Terminal"),
                ("Dirb", "Web content scanner with active wordlists in /usr/share/wordlists", "dirb", False, "Terminal"),
            ]),
