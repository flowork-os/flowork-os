                ("Impacket WMIExec", "Semi-interactive WMI shell execution on Windows targets", "impacket-wmiexec", False, "Terminal"),
            ]),
            ("🔬 Reverse Engineering & Binary Forensics", [
                ("Flowork Inspector (fl-inspect)", "Deep binary, Electron ASAR, APK, ELF, Sourcemap & secret auditing suite", "fl-inspect", False, "Terminal"),
                ("Radare2", "Complete command-line reverse engineering framework & disassembler", "r2", False, "Terminal"),
                ("Binwalk", "Firmware analysis, steganography & file extraction tool", "binwalk", False, "Terminal"),
