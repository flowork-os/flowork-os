[Unit]
Description=FlowFS Semantic Vector Indexer Daemon
Documentation=man:flowfs-search(1)
After=default.target

[Service]
Type=simple
ExecStart=/opt/floworkos/bin/flowfs-indexer-daemon
Restart=always
RestartSec=60
Nice=19
CPUWeight=20
IOWeight=20
Slice=background.slice

[Install]
WantedBy=default.target
