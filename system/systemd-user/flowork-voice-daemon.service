[Unit]
Description=Flowork OS Sovereign Conversational Voice Daemon (PersonaPlex :8998)
After=pipewire.service pulseaudio.service sound.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/floworkos/engine/personaplex/voice_daemon.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
