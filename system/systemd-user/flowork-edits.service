[Unit]
Description=Flowork Sovereign OS Edits Asset Streaming Daemon (:3456)
Documentation=https://floworkos.com
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/floworkos/apps/flowork-edits
ExecStart=/opt/floworkos/bin/flowork-edits-daemon
Restart=on-failure
RestartSec=2s
Environment=FLOWORK_EDITS_PORT=3456
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
