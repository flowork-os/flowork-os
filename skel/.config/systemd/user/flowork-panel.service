[Unit]
Description=Flowork OS Top Glass Header Panel
After=default.target

[Service]
Environment=DISPLAY=:0
Environment=XDG_CURRENT_DESKTOP=Flowork
Environment=PATH=/opt/floworkos/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/xfce4-panel --disable-wm-check
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
