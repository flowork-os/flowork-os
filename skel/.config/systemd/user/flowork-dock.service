[Unit]
Description=Flowork OS Sovereign Muelle Glass Dock
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XDG_CURRENT_DESKTOP=Flowork
ExecStart=/opt/floworkos/bin/flowork-muelle-dock
KillMode=process
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target default.target
