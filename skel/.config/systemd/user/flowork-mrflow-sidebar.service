[Unit]
Description=Mr. Flow Sovereign Companion Sidebar Service
After=graphical-session.target flowork-session.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=/usr/bin/python3 /opt/floworkos/apps/mrflow-sidebar/bin/mrflow-sidebar.py daemon
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
