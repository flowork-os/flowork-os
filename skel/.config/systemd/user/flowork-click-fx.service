[Unit]
Description=Flowork OS Pure Optical Crystal Click & Focus FX Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XDG_CURRENT_DESKTOP=Flowork
ExecStart=/opt/floworkos/bin/flowork-click-fx daemon
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target default.target
