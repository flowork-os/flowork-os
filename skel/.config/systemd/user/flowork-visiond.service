[Unit]
Description=Flowork Sovereign OS Local Vision-Cortex Daemon (:18095)
Documentation=https://floworkos.com
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/floworkos
ExecStart=/usr/bin/python3 /opt/floworkos/daemon/flowork_visiond.py --daemon
Restart=always
RestartSec=2s
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
