[Unit]
Description=Flowork Sovereign OS XSETTINGS Daemon
Documentation=https://floworkos.com
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=/usr/bin/xsettingsd
Restart=always
RestartSec=1s

[Install]
WantedBy=default.target
