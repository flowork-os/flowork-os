[Unit]
Description=Flowork OS Muelle Launch Effect Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XDG_CURRENT_DESKTOP=Flowork
ExecStart=/usr/bin/python3 /opt/floworkos/theme/flowork-muelle-daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target default.target
