[Desktop Entry]
Version=1.0
Type=Application
Name=EffectCraft
GenericName=VFX & Motion Graphics Studio
Comment=Visual effects, motion graphics, and particle compositor in pure Rust
Exec=/opt/floworkos/bin/effectcraft %F
Icon=/opt/floworkos/icons/effectcraft.png
Terminal=false
Categories=Flowork;AudioVideo;Video;Graphics;
MimeType=video/mp4;video/x-matroska;image/png;
StartupNotify=true
StartupWMClass=effectcraft
