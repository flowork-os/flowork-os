[Desktop Entry]
Version=1.0
Type=Application
Name=TraceDraw
GenericName=Vector Illustration & Print Layout Studio (Pure Rust)
Comment=Open-source clean-room vector editor written from scratch in pure Rust (.cdr, .ai, .svg, print layout)
Exec=/opt/floworkos/bin/vectorcraft %F
Icon=/opt/floworkos/icons/tracedraw.png
Terminal=false
Categories=Flowork;Graphics;VectorGraphics;Design;
MimeType=image/svg+xml;application/pdf;image/x-eps;application/coreldraw;application/x-cdr;
StartupNotify=true
StartupWMClass=tracedraw
