[Desktop Entry]
Version=1.0
Type=Application
Name=FilmCraft
GenericName=Video Editor & Compositor
Comment=High-performance non-linear video editing and timeline compositor in pure Rust
Exec=/opt/floworkos/bin/filmcraft %F
Icon=/opt/floworkos/icons/filmcraft.png
Terminal=false
Categories=Flowork;AudioVideo;Video;AudioVideoEditing;
MimeType=video/mp4;video/x-matroska;video/quicktime;video/webm;
StartupNotify=true
StartupWMClass=filmcraft
