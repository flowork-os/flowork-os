# Antigravity & Agent IDE Exclusions
core/agent/
agent/
core/agents/
agents/
core/apps/agent/
apps/agent/
core/apps/agent.desktop
apps/agent.desktop
skel/.local/share/applications/agent.desktop
skel/.local/share/applications/Antigravity.desktop
skel/.local/share/applications/antigravity.desktop
*antigravity*
*Antigravity*

# Transient Runtime State & Live QC Artifacts
*.pid
.last_alert
.state.json
foundry_test_result.json
core/.flowork/foundry_test_result.json
test_config.json
core/test_config.json

# Docs & Private Documents Exclusions
/docs/
/docs/**
core/docs/
core/docs/**
/documents/
/documents/**
core/documents/
core/documents/**

# Generated Videos & Media Deliverables Anti-Leak
videos/
videos/**
finish/
finish/**
core/documents/videos/
core/documents/videos/**
*STICKMAN*
*COASTER*
*RAILROADS*

# ARTEX Pentesting Runtime Data & Secret Exclusions
core/apps/artex/data/*
!core/apps/artex/data/.gitkeep
core/apps/artex/bin/jwt.key
