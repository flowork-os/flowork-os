# Flowork OS Sovereign Exclusions & Anti-Leak Shield
.gitignore
*roadmap*
*ROADMAP*
roadmap.md
*flowork.dev*
*token*
*vault.json*
*.key
*.pem
*.pfx
id_rsa
id_ed25519
*.db
*.db-*
*.db-shm
*.db-wal
*.sqlite*
*.blend
*.blend1
.bash_history
.cache/
.npm/
.rustup/
.gemini/
target/
node_modules/
__pycache__/
*.pyc
*.pyo
*.log
.system_generated/
*.tmp
*.bak
*.iso
iso-builder/output/
flowork-iso-build/
output/
initrd
linux-rust/
antigravity
language_server
user_data/
user_data*/
*user_data*
venv/
.venv/

# Sovereign Forbidden Folders Content Exclusions (Folders preserved via .gitkeep)
skel/Documents/*
!skel/Documents/.gitkeep
skel/Downloads/*
!skel/Downloads/.gitkeep
skel/Pictures/*
!skel/Pictures/.gitkeep
skel/Videos/*
!skel/Videos/.gitkeep

core/screenshots/*
!core/screenshots/.gitkeep
screenshots/*
!screenshots/.gitkeep

core/history/chats/*
!core/history/chats/.gitkeep
history/chats/*
!history/chats/.gitkeep

core/connector/data/*
!core/connector/data/.gitkeep
connector/data/*
!connector/data/.gitkeep

# Android Subsystem & Play Store Credentials / User Session Exclusions
.android/
*.android*
*.avd
*.avd/
*.qcow2
userdata-qemu*
cache.img*
encryptionkey*
*.lock
waydroid/
anbox/

