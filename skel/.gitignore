core/apps/photocraft/bin/
core/apps/solidcraft/bin/
core/apps/soundcraft/bin/
core/apps/texturecraft/bin/
core/apps/vectorcraft/bin/
core/apps/wordcraft/bin/
core/apps/gputaskman/runtime/
core/apps/openscreen/squashfs-root/
*.AppImage
*.apk
*.xapk
*apk_pulled*
*.gguf
*.safetensors
