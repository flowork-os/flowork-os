{
  "name": "tracker_update_task",
  "description": "Update status or metadata of an existing tracked task node.",
  "parametersJsonSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "ID of task to update."
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "completed",
          "blocked"
        ]
      }
    },
    "required": [
      "task_id",
      "status"
    ]
  },
  "activation": "conditional",
  "triggers": {
    "keywords": [
      "tracker",
      "dependency graph",
      "task graph",
      "workflow tracker",
      "gantt",
      "project milestones",
      "task management"
    ],
    "exclude_keywords": [
      "simple script",
      "no tracking",
      "standalone task"
    ],
    "behavior": {
      "files": [
        ".flowork/tracker",
        ".gemini/tracker"
      ]
    }
  }
}
