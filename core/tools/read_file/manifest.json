{
  "name": "read_file",
  "description": "Read file contents with line numbers and optional line slice (start_line, end_line).",
  "parametersJsonSchema": {
    "type": "object",
    "properties": {
      "file_path": {
        "type": "string",
        "description": "Path to file to read."
      },
      "start_line": {
        "type": "integer",
        "description": "Optional start line (1-indexed)."
      },
      "end_line": {
        "type": "integer",
        "description": "Optional end line (1-indexed)."
      }
    },
    "required": [
      "file_path"
    ]
  },
  "activation": "always",
  "triggers": {
    "keywords": [
      "read",
      "inspect",
      "view",
      "file",
      "examine",
      "content"
    ],
    "exclude_keywords": [],
    "behavior": {}
  }
}
