#!/bin/sh
# =============================================================================
# 👑 FLOWORK OS — GRUB SNAPSHOT INTEGRATION HOOK (42_flowork_snapshots)
# Dynamically enumerates Btrfs and Time-Lock recovery snapshots into GRUB boot menu.
# =============================================================================
set -e

INDEX_FILE="/.snapshots/snapshots_index.json"
FALLBACK_INDEX="${HOME}/.local/share/flowork/snapshots/snapshots_index.json"

if [ -f "$INDEX_FILE" ]; then
    ACTIVE_INDEX="$INDEX_FILE"
elif [ -f "$FALLBACK_INDEX" ]; then
    ACTIVE_INDEX="$FALLBACK_INDEX"
else
    exit 0
fi

cat << 'EOF'
submenu 'Flowork OS — Time-Lock Recovery Snapshots (Auto-Rollback)' --class flowork --class recovery {
EOF

python3 -c '
import json, re, sys
index_path = sys.argv[1]
def safe_tok(val, default):
    cleaned = re.sub(r"[^A-Za-z0-9_.:-]", "_", str(val or ""))
    return cleaned or default
try:
    with open(index_path, "r", encoding="utf-8") as f:
        snaps = json.load(f)
    for s in reversed(snaps[-8:]):
        if str(s.get("fstype", "")).lower() != "btrfs":
            continue
        sid = safe_tok(s.get("id"), "unknown")
        tag = safe_tok(s.get("tag"), "manual")
        ts = safe_tok(s.get("timestamp"), "")
        print(f"""    menuentry '\''Flowork OS Snapshot [{sid}] ({tag}) - {ts}'\'' {{
        echo '\''Rolling back to snapshot: {sid}...'\''
        linux /vmlinuz root=LABEL=FLOWORK_ROOT ro rootflags=subvol=/.snapshots/@root_{sid}_{tag} quiet splash
        initrd /initrd.img
    }}""")
except Exception:
    pass
' "$ACTIVE_INDEX"

cat << 'EOF'
}
EOF
