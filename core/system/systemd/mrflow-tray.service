[Unit]
Description=MrFlow Desktop Header Systray Indicator
After=graphical-session.target mrflow-router.service
Wants=mrflow-router.service

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=/usr/local/bin/mrflow-tray-menu
Restart=on-failure
RestartSec=2s
KillMode=process

[Install]
WantedBy=default.target
