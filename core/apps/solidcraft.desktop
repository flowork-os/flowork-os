[Desktop Entry]
Version=1.0
Type=Application
Name=SolidCraft
GenericName=Solid B-Rep Mechanical CAD
Comment=Boundary representation (B-Rep) solid mechanical CAD and precision assembly modeler
Exec=/opt/floworkos/bin/solidcraft %F
Icon=/opt/floworkos/icons/solidcraft.png
Terminal=false
Categories=X-Flowork;Graphics;Engineering;3DGraphics;
MimeType=model/step;model/iges;application/sla;
StartupNotify=true
StartupWMClass=solidcraft

Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix solidcraft
