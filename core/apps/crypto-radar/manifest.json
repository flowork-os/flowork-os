{
  "template": "quantum-glass",
  "version": "1.0.0",
  "author": "Flowork OS Sovereign Engine",
  "runtime": "python-webkit2-gtk",
  "css_theme": "quantum-glass-v1",
  "capabilities": [
    "gui",
    "local_ipc",
    "sovereign_bridge"
  ],
  "defaults": {
    "width": 860,
    "height": 580,
    "category": "Utility",
    "icon": "\u26a1"
  },
  "permissions": {
    "profile": "standard",
    "allow_network": true,
    "ipc_neural_bus": true,
    "bus_topics_allow": [
      "app.status",
      "market.*"
    ],
    "read_paths": [],
    "write_paths": [
      "~/.flowork/data/crypto-radar"
    ]
  }
}
