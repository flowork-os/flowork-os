[Desktop Entry]
Version=1.0
Type=Application
Name=WordCraft
GenericName=Word Processor & Typography
Comment=Elegant document processor, typography workbench, and publishing studio in pure Rust
Exec=/opt/floworkos/bin/wordcraft %F
Icon=/opt/floworkos/icons/wordcraft.png
Terminal=false
Categories=Flowork;Office;WordProcessor;TextEditor;
MimeType=application/vnd.oasis.opendocument.text;application/pdf;text/plain;text/markdown;
StartupNotify=true
StartupWMClass=wordcraft

Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix wordcraft
