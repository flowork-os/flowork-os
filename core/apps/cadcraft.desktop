[Desktop Entry]
Version=1.0
Type=Application
Name=CadCraft
GenericName=Parametric CAD Modeler
Comment=2D/3D Computer-Aided Design (CAD) and parametric engineering modeler in pure Rust
Exec=/opt/floworkos/bin/cadcraft %F
Icon=/opt/floworkos/icons/cadcraft.png
Terminal=false
Categories=Flowork;Graphics;Engineering;3DGraphics;
MimeType=model/step;model/iges;application/sla;model/obj;
StartupNotify=true
StartupWMClass=cadcraft

Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix cadcraft
