[Desktop Entry]
Name=Screenshot
Comment=Interactive Snipping Tool with Copy and Open Popup
Exec=/usr/local/bin/flowork-screenshot-gui
Icon=accessories-screenshot
Terminal=false
Type=Application
Categories=Utility;Graphics;
StartupNotify=false
Keywords=screenshot;snapshot;capture;screen;snip;

Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix screenshot
