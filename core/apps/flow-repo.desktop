[Desktop Entry]
Version=1.0
Type=Application
Name=FlowRepo
GenericName=GitHub Historical Vault
Comment=Sovereign GitHub Historical Vault & Open-Source Hall of Fame (2008-2026)
Exec=/opt/floworkos/bin/flow-repo
Icon=/opt/floworkos/icons/flow-repo.png
Terminal=false
Categories=X-Flowork;Development;Utility;
Keywords=github;trending;vault;history;repo;hall-of-fame;open-source;flowork;
StartupNotify=true

Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix flow-repo
