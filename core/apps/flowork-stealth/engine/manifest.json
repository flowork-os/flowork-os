{
  "manifest_version": 3,
  "name": "Flowork Sovereign Stealth Engine",
  "version": "1.0.0",
  "description": "Sovereign Anti-Detect Fingerprint Masking & Hardware Isolation Engine",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["stealth.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["stealth.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
