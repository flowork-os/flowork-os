PROFILES_DIR = BASE_DIR / "profiles"
ENGINE_DIR = BASE_DIR / "engine"
DB_FILE = BASE_DIR / "profiles.json"
CHROME_BIN = "/usr/local/bin/google-chrome"
if not os.path.exists(CHROME_BIN):
    CHROME_BIN = "/opt/google/chrome/google-chrome"

