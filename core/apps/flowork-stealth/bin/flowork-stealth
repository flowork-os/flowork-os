def load_db():
    if not DB_FILE.exists():
        return {}
    try:
        with open(DB_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {}

def save_db(data):
    with open(DB_FILE, "w") as f:
        json.dump(data, f, indent=2)

def create_profile(name, preset_key="win11-rtx4070", proxy=None, notes=""):
    db = load_db()
    slug = name.lower().replace(" ", "-")

    preset = PRESETS.get(preset_key, PRESETS["win11-rtx4070"])
    prof_dir = PROFILES_DIR / slug
    user_data = prof_dir / "user_data"
    ext_dir = prof_dir / "extension"

    user_data.mkdir(parents=True, exist_ok=True)
    ext_dir.mkdir(parents=True, exist_ok=True)

    # Copy extension core files
    shutil.copy(ENGINE_DIR / "manifest.json", ext_dir / "manifest.json")
    shutil.copy(ENGINE_DIR / "loader.js", ext_dir / "loader.js")

    # Generate unique seeds
    canvas_seed = random.randint(10000, 999999)
    audio_seed = random.randint(10000, 999999)

    cfg = {
        "profileId": slug,
        "profileName": name,
        "preset": preset_key,
        "os": preset["os"],
        "platform": preset["platform"],
        "userAgent": preset["userAgent"],
        "appVersion": preset["appVersion"],
        "hardwareConcurrency": preset["hardwareConcurrency"],
        "deviceMemory": preset["deviceMemory"],
        "webglVendor": preset["webglVendor"],
        "webglRenderer": preset["webglRenderer"],
        "screenWidth": preset["screenWidth"],
        "screenHeight": preset["screenHeight"],
        "screenColorDepth": 24,
        "screenPixelDepth": 24,
        "canvasSeed": canvas_seed,
        "audioSeed": audio_seed,
        "disableWebRTCLeak": True,
        "proxy": proxy or "",
        "notes": notes
    }

    # Generate atomic stealth.js with embedded config
    template_path = ENGINE_DIR / "stealth.template.js"
    if template_path.exists():
        with open(template_path, "r") as f:
            template_code = f.read()
    else:
        with open(ENGINE_DIR / "stealth.js", "r") as f:
            template_code = f.read()

    cfg_snippet = f"const cfg = {json.dumps(cfg, indent=2)};"
    stealth_code = template_code.replace("// CONFIGURATION_INJECTION_TARGET", cfg_snippet)

    with open(ext_dir / "stealth.js", "w") as f:
        f.write(stealth_code)

    db[slug] = cfg
    save_db(db)
    print(f"[+] Successfully configured Stealth Profile: '{name}' (ID: {slug})")
    print(f"    - Hardware Persona: {preset['name']}")
    print(f"    - Canvas Seed: {canvas_seed} | Audio Seed: {audio_seed}")
    print(f"    - Proxy: {proxy or 'Direct Connection'}")
    return True

def list_profiles():
    db = load_db()
    if not db:
        print("[*] No stealth profiles found. Create one with: flowork-stealth create <name>")
        return
    print("\n" + "=" * 78)
    print(f"{'PROFILE ID':<18} | {'PERSONA':<24} | {'PROXY':<20} | {'STATUS'}")
    print("=" * 78)
    for slug, p in db.items():
        preset_info = PRESETS.get(p.get("preset"), {}).get("name", p.get("os", "Unknown"))
        proxy_info = p.get("proxy") or "DIRECT"
        print(f"{slug:<18} | {preset_info[:24]:<24} | {proxy_info[:20]:<20} | READY")
    print("=" * 78 + "\n")

def delete_profile(slug):
    db = load_db()
    if slug not in db:
        print(f"[!] Profile '{slug}' not found.")
        return False
    prof_dir = PROFILES_DIR / slug
    if prof_dir.exists():
        shutil.rmtree(prof_dir, ignore_errors=True)
    del db[slug]
    save_db(db)
    print(f"[+] Deleted profile '{slug}'.")
    return True

def launch_profile(slug, target_url=None):
    db = load_db()
    if slug not in db:
        print(f"[!] Profile '{slug}' not found. Please create it first.")
        return False

    p = db[slug]
    prof_dir = PROFILES_DIR / slug
    user_data = prof_dir / "user_data"
    
    # Save config.json
    prof_dir.mkdir(parents=True, exist_ok=True)
    cfg_file = prof_dir / "config.json"
    with open(cfg_file, "w") as f:
        json.dump(p, f, indent=2)

    url = target_url or "https://iphey.com"
    runner_script = BASE_DIR / "bin" / "stealth_runner.py"
    camoufox_python = "/opt/floworkos/apps/camoufox/venv/bin/python3"
    if not os.path.exists(camoufox_python):
        camoufox_python = sys.executable

    print(f"[🚀] Launching Flowork Sovereign Stealth Profile: '{p.get('profileName', slug)}'...")
    print(f"     Target URL: {url}")
    print(f"     Engine    : Camoufox C++ Native Anti-Detect")
    print(f"     Persona   : {p.get('os', 'windows').upper()} ({p.get('preset', 'custom')})")

    # Launch detached process
    subprocess.Popen(
        [camoufox_python, str(runner_script), slug, url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        preexec_fn=os.setpgrp
    )
    return True

def launch_gui():
    gui_script = BASE_DIR / "gui" / "flowork-stealth-gui.py"
    if gui_script.exists():
        subprocess.Popen([sys.executable, str(gui_script)], preexec_fn=os.setpgrp)
    else:
        print(f"[!] GUI script not found at {gui_script}")

def main():
    parser = argparse.ArgumentParser(description="Flowork Sovereign Anti-Detect & Stealth Browser Controller")
    subparsers = parser.add_subparsers(dest="command")

    # List
    subparsers.add_parser("list", help="List all stealth browser profiles")

    # Create
    create_parser = subparsers.add_parser("create", help="Create a new isolated stealth profile")
    create_parser.add_argument("name", help="Profile name or identifier")
    create_parser.add_argument("--preset", default="win11-rtx4070", choices=list(PRESETS.keys()), help="Hardware identity preset")
    create_parser.add_argument("--proxy", default="", help="Proxy URL (e.g., http://ip:port or socks5://ip:port)")
    create_parser.add_argument("--notes", default="", help="Notes or tags for this profile")

    # Launch
    launch_parser = subparsers.add_parser("launch", help="Launch a stealth browser profile")
    launch_parser.add_argument("name", help="Profile slug or ID")
    launch_parser.add_argument("--url", default="https://pixelscan.net", help="Starting URL (default: https://pixelscan.net)")

    # Delete
    del_parser = subparsers.add_parser("delete", help="Delete a stealth profile and its sandbox data")
    del_parser.add_argument("name", help="Profile slug or ID")

    # GUI
    subparsers.add_parser("gui", help="Open the Flowork Stealth Glass HUD Dashboard GUI")

    args = parser.parse_args()

    if args.command == "list":
        list_profiles()
    elif args.command == "create":
        create_profile(args.name, args.preset, args.proxy, args.notes)
    elif args.command == "launch":
        launch_profile(args.name, args.url)
    elif args.command == "delete":
        delete_profile(args.name)
    elif args.command == "gui":
        launch_gui()
    else:
        if os.environ.get("DISPLAY"):
            launch_gui()
        else:
            parser.print_help()

if __name__ == "__main__":
    main()
