[Desktop Entry]
Type=Application
Version=1.0
Name=Flowork Android Subsystem
GenericName=Android Subsystem Manager
Comment=Manage and run Android applications on Flowork OS
Exec=/opt/floworkos/bin/flowork-apk gui
