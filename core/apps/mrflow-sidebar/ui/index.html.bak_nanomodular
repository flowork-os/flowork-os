function extractAgentReason(toolName, params, event) {
  if (params) {
    if (params.reason) return params.reason;
    if (params.Description) return params.Description;
    if (params.description) return params.description;
    if (params.Instruction) return params.Instruction;
    if (params.toolAction) return params.toolAction;
    if (params.toolSummary) return params.toolSummary;
    if (params.command) return `Menjalankan perintah shell: ${params.command.substring(0, 80)}`;
    if (params.file_path) return `Membaca dan memindai isi berkas: ${params.file_path}`;
    if (params.target || params.TargetFile) return `Menulis dan mengompilasi berkas: ${params.target || params.TargetFile}`;
    if (params.query || params.pattern) return `Mencari referensi pola: "${params.query || params.pattern}"`;
    if (params.url) return `Menavigasi halaman web: ${params.url}`;
    if (params.skill_name) return `Mengaktifkan modul kapabilitas SOP: ${params.skill_name}`;
    if (params.prompt || params.Prompt) return `Mendelegasikan tugas ke sub-agen: ${(params.prompt || params.Prompt).substring(0, 80)}`;
    if (params.task_title || params.title) return `Memperbarui status DAG pipeline: ${(params.task_title || params.title).substring(0, 80)}`;
    if (params.question) return `Meminta klarifikasi arsitektur: ${params.question.substring(0, 80)}`;
  }
  if (event && event.thought) return event.thought;
  return getToolInfo(toolName).defaultReason;
}

