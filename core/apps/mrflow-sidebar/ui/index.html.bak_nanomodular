// Safe Markdown Parser
function formatMarkdown(text) {
  if (!text) return "";

  const codeBlocks = [];
  let html = text.replace(/```([a-zA-Z0-9_\-\+]*)\n([\s\S]*?)```/g, (match, lang, code) => {
    const idx = codeBlocks.length;
    codeBlocks.push({ lang: (lang || "sh").trim().toLowerCase(), code: code.trim() });
    return `__CODE_BLOCK_${idx}__`;
  });

  const imgBlocks = [];
  html = html.replace(/!\[(.*?)\]\((file:\/\/\/.*?|https?:\/\/.*?|\/.*?)\)/g, (match, alt, src) => {
    const idx = imgBlocks.length;
    imgBlocks.push({ alt: (alt || "").trim(), src: (src || "").trim() });
    return `__IMG_BLOCK_${idx}__`;
  });

  html = html
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

  html = html.replace(/^### (.*$)/gim, '<h4 style="color:#ffffff;margin:6px 0 3px 0;font-size:11.5px;">$1</h4>');
  html = html.replace(/^## (.*$)/gim, '<h3 style="color:#ffffff;margin:8px 0 4px 0;font-size:12.5px;">$1</h3>');
  html = html.replace(/^# (.*$)/gim, '<h2 style="color:#ffffff;margin:10px 0 5px 0;font-size:13.5px;">$1</h2>');

  html = html.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
  html = html.replace(/\*(.*?)\*/g, "<em>$1</em>");
  html = html.replace(/`([^`]+)`/g, '<code class="inline-code">$1</code>');

  html = html.replace(/^\s*[\-\*]\s+(.*)$/gim, "<li>$1</li>");
  html = html.replace(/(<li>.*<\/li>)/s, "<ul>$1</ul>");

  html = html.split("\n\n").map(p => {
    p = p.trim();
    if (!p) return "";
    if (p.startsWith("<h") || p.startsWith("<ul>") || p.startsWith("__CODE_BLOCK_") || p.startsWith("__IMG_BLOCK_")) return p;
    return `<p>${p.replace(/\n/g, "<br>")}</p>`;
  }).join("");

  html = html.replace(/__IMG_BLOCK_(\d+)__/g, (match, idx) => {
    const b = imgBlocks[idx];
    const imgSrc = b.src.startsWith('/') ? 'file://' + b.src : b.src;
    return `
      <div class="chat-markdown-img" onclick="window.openImageModal('${b.src}')">
        <img src="${imgSrc}" alt="${escapeHtml(b.alt)}" />
        <div style="font-size:9.5px;color:var(--text-dim);padding:3px 6px;display:flex;align-items:center;justify-content:space-between;">
          <span>🔍 ${escapeHtml(b.alt || 'Screenshot')}</span>
          <span style="color:var(--cyan-bright);font-size:8.5px;">Click to zoom</span>
        </div>
      </div>
    `;
  });

  html = html.replace(/__CODE_BLOCK_(\d+)__/g, (match, idx) => {
    const b = codeBlocks[idx];
    const escapedCode = b.code
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");

    const blockId = "cb_" + Math.random().toString(36).substring(2, 9);
    return `
      <div class="code-block-wrapper" id="${blockId}">
        <div class="code-header">
          <span>${b.lang.toUpperCase()}</span>
          <div class="code-actions">
            <button class="btn-code" onclick="copySnippet('${blockId}')">📋 Copy</button>
          </div>
        </div>
        <pre><code class="raw-code">${escapedCode}</code></pre>
      </div>
    `;
  });

  return html;
}

window.copySnippet = function(blockId) {
  const el = document.getElementById(blockId);
  if (!el) return;
  const raw = el.querySelector(".raw-code").innerText;
  navigator.clipboard.writeText(raw).then(() => {
    const btn = el.querySelector(".btn-code");
    const orig = btn.innerText;
    btn.innerText = "✓ Copied";
    setTimeout(() => { btn.innerText = orig; }, 1500);
  });
};

// ==============================================================================
// MESSAGE ACTIONS: COPY, FORWARD, RETRY
// ==============================================================================
window.copyMessageBubble = function(btn) {
  const msgDiv = btn.closest(".message");
  if (!msgDiv) return;
  const bubble = msgDiv.querySelector(".bubble");
  if (!bubble) return;
  const clone = bubble.cloneNode(true);
  clone.querySelectorAll(".tools-group-card, .agent-screenshot-card, .user-attached-preview, .code-header").forEach(el => el.remove());
  const rawText = clone.innerText.trim();

  navigator.clipboard.writeText(rawText).then(() => {
    btn.classList.add("copied");
    btn.innerHTML = `<span style="font-size:9px;color:var(--green-matrix);font-weight:bold;">✓</span>`;
    setTimeout(() => {
      btn.classList.remove("copied");
      btn.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
    }, 1500);
  });
};

window.forwardMessageBubble = function(btn) {
  const msgDiv = btn.closest(".message");
  if (!msgDiv) return;
  const bubble = msgDiv.querySelector(".bubble");
  if (!bubble) return;
  const clone = bubble.cloneNode(true);
  clone.querySelectorAll(".tools-group-card, .agent-screenshot-card, .user-attached-preview, .code-header").forEach(el => el.remove());
  const rawText = clone.innerText.trim();

  userInput.value = rawText;
  userInput.focus();
  userInput.style.height = "20px";
  userInput.style.height = Math.min(userInput.scrollHeight, 110) + "px";
};

window.retryMessageBubble = function(btn) {
  const msgDiv = btn.closest(".message");
  if (!msgDiv) return;
  const isUser = msgDiv.classList.contains("user");
  let promptToResend = "";

  if (isUser) {
    const clone = msgDiv.querySelector(".bubble").cloneNode(true);
    clone.querySelectorAll(".user-attached-preview").forEach(el => el.remove());
    promptToResend = clone.innerText.trim();
  } else {
    let prev = msgDiv.previousElementSibling;
    while (prev) {
      if (prev.classList.contains("message") && prev.classList.contains("user")) {
        const clone = prev.querySelector(".bubble").cloneNode(true);
        clone.querySelectorAll(".user-attached-preview").forEach(el => el.remove());
        promptToResend = clone.innerText.trim();
        break;
      }
      prev = prev.previousElementSibling;
    }
  }

  if (promptToResend) {
    userInput.value = promptToResend;
    sendMessage();
  }
};

// ==============================================================================
// REAL OPERATIONAL TOOL METADATA & REASON EXTRACTOR
// ==============================================================================
function getToolInfo(toolName) {
  const name = (toolName || "").toLowerCase();

  if (name === "thinking") {
    return {
      icon: "🧠",
      label: "Nalar & Perencanaan Agen",
      defaultReason: "Menganalisa instruksi pengguna dan memformulasikan rencana eksekusi..."
    };
  }

  if (name.includes("read") || name.includes("view")) {
    return {
      icon: "📄",
      label: "Inspeksi Berkas (read_file)",
      defaultReason: "Membaca dan memindai baris kode untuk memeriksa struktur program."
