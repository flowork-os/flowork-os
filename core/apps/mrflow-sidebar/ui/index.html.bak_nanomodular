let stageTimerInterval = null;
let stageStartTime = 0;
let isHistoryToggledInStage = false;

function openExecutionStage(toolName, reasonText, targetPath, metaInfo, initialBodyHtml) {
  const stage = document.getElementById("executionFocusStage");
  const chat = document.getElementById("chatContainer");
  const icon = document.getElementById("stageIcon");
  const nameEl = document.getElementById("stageToolName");
  const badge = document.getElementById("stageStatusBadge");
  const timer = document.getElementById("stageTimer");
  const reasonEl = document.getElementById("stageReasonText");
  const pathEl = document.getElementById("stageTargetPath");
  const metaEl = document.getElementById("stageMetaInfo");
  const bodyEl = document.getElementById("stageViewportBody");

  if (!stage || !chat) return;

  // Sembunyikan riwayat chat saat tool aktif agar user fokus pada tool yang sedang berjalan
  isHistoryToggledInStage = false;
  chat.style.display = "none";
  stage.style.display = "flex";

  const info = getToolInfo(toolName);
  if (icon) icon.textContent = info.icon;
  if (nameEl) nameEl.textContent = info.label;
  if (badge) {
    badge.className = "stage-status-badge running";
    badge.textContent = "RUNNING";
  }
  if (reasonEl) {
    reasonEl.textContent = reasonText || info.defaultReason;
  }
  if (pathEl) {
    pathEl.textContent = targetPath || toolName;
  }
  if (metaEl) {
    metaEl.textContent = metaInfo || "Live Stream";
  }
  if (bodyEl) {
    bodyEl.innerHTML = initialBodyHtml || `<div style="color:#64748b;font-style:italic;">Memulai operasi ${escapeHtml(toolName)}...</div>`;
  }

  if (stageTimerInterval) clearInterval(stageTimerInterval);
  stageStartTime = Date.now();
  if (timer) timer.textContent = "0.0s";
  stageTimerInterval = setInterval(() => {
    const elapsed = ((Date.now() - stageStartTime) / 1000).toFixed(1);
    if (timer) timer.textContent = `${elapsed}s`;
  }, 100);
}

function updateExecutionStageResult(status, outputText) {
  const badge = document.getElementById("stageStatusBadge");
  const bodyEl = document.getElementById("stageViewportBody");

  if (stageTimerInterval) {
    clearInterval(stageTimerInterval);
    stageTimerInterval = null;
  }

  if (badge) {
    if (status === "error") {
      badge.className = "stage-status-badge error";
      badge.textContent = "✕ GAGAL";
    } else {
      badge.className = "stage-status-badge success";
      badge.textContent = "✓ SELESAI";
    }
  }

  if (bodyEl && outputText) {
    const outBox = document.createElement("div");
    outBox.className = "term-stdout-stream";
    outBox.style.marginTop = "8px";
    outBox.style.paddingTop = "8px";
    outBox.style.borderTop = "1px solid rgba(255,255,255,0.08)";
    outBox.textContent = String(outputText).substring(0, 1500) + (String(outputText).length > 1500 ? "\n...[truncated]" : "");
    bodyEl.appendChild(outBox);
    bodyEl.scrollTop = bodyEl.scrollHeight;
  }
}

function closeExecutionStage() {
  const stage = document.getElementById("executionFocusStage");
  const chat = document.getElementById("chatContainer");

  if (stageTimerInterval) {
    clearInterval(stageTimerInterval);
    stageTimerInterval = null;
  }

  if (stage) stage.style.display = "none";
  if (chat) chat.style.display = "block";
}

// Tombol toggle lihat chat / eksekusi
const btnToggleHistory = document.getElementById("btnToggleHistoryInStage");
if (btnToggleHistory) {
  btnToggleHistory.onclick = () => {
    const stage = document.getElementById("executionFocusStage");
    const chat = document.getElementById("chatContainer");
    isHistoryToggledInStage = !isHistoryToggledInStage;
    if (isHistoryToggledInStage) {
      chat.style.display = "block";
      stage.style.display = "none";
      btnToggleHistory.textContent = "Lihat Eksekusi ⚡";
    } else {
      chat.style.display = "none";
      stage.style.display = "flex";
      btnToggleHistory.textContent = "Lihat Chat 💬";
    }
  };
}

