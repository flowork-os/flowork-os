// ==============================================================================
let activeTaskTimerInterval = null;
let activeTaskStartTime = 0;
let lastActiveToolCardId = null;

function showActiveTaskBar(toolName, commandOrSnippet, toolCardId) {
  const bar = document.getElementById("activeTaskBar");
  const label = document.getElementById("activeTaskLabel");
  const cmd = document.getElementById("activeTaskCmd");
  const timer = document.getElementById("activeTaskTimer");

  if (!bar) return;

  bar.style.display = "flex";
  lastActiveToolCardId = toolCardId;

  const info = getToolInfo(toolName);

  if (label) {
    if (toolName === "thinking") {
      label.innerHTML = `<span>🧠</span> <span>Nalar Agen:</span>`;
    } else if (toolName === "run_shell_command" || toolName === "bash" || toolName === "terminal" || toolName === "run_command") {
      label.innerHTML = `<span>💻</span> <span>Terminal:</span>`;
    } else {
      label.innerHTML = `<span>${info.icon}</span> <span>${escapeHtml(toolName)}:</span>`;
    }
  }

  if (cmd) {
    cmd.textContent = commandOrSnippet || "mengeksekusi...";
  }

  if (activeTaskTimerInterval) {
    clearInterval(activeTaskTimerInterval);
    activeTaskTimerInterval = null;
  }

  activeTaskStartTime = Date.now();
  const currentStart = activeTaskStartTime;
  if (timer) timer.textContent = "0s";

  activeTaskTimerInterval = setInterval(() => {
    const elapsedSec = Math.floor((Date.now() - activeTaskStartTime) / 1000);
    if (timer) timer.textContent = `${elapsedSec}s`;
  }, 1000);

  // Safeguard: auto-hide setelah maksimal 30 detik agar tidak pernah bocor atau jalan terus
  setTimeout(() => {
    if (activeTaskStartTime === currentStart) {
      hideActiveTaskBar();
    }
  }, 30000);
}

function updateActiveTaskBarFinished(status) {
  const label = document.getElementById("activeTaskLabel");
  if (activeTaskTimerInterval) {
    clearInterval(activeTaskTimerInterval);
    activeTaskTimerInterval = null;
  }
  const elapsedSec = Math.floor((Date.now() - activeTaskStartTime) / 1000);
  if (label) {
    if (status === "error") {
      label.innerHTML = `<span style="color:var(--crimson-danger)">✕ Gagal (${elapsedSec}s)</span>`;
    } else {
      label.innerHTML = `<span style="color:var(--green-matrix)">✓ Selesai (${elapsedSec}s)</span>`;
    }
  }
  setTimeout(() => {
    hideActiveTaskBar();
  }, 1500);
}

function hideActiveTaskBar() {
  const bar = document.getElementById("activeTaskBar");
  if (bar) bar.style.display = "none";
  if (activeTaskTimerInterval) {
    clearInterval(activeTaskTimerInterval);
    activeTaskTimerInterval = null;
  }
}

function hideActiveTaskBar() {
  const bar = document.getElementById("activeTaskBar");
  if (bar) bar.style.display = "none";
  if (activeTaskTimerInterval) {
    clearInterval(activeTaskTimerInterval);
    activeTaskTimerInterval = null;
  }
}

const btnScrollToActiveTask = document.getElementById("btnScrollToActiveTask");
if (btnScrollToActiveTask) {
  btnScrollToActiveTask.addEventListener("click", () => {
    if (lastActiveToolCardId) {
      const el = document.getElementById(lastActiveToolCardId);
      if (el) {
        const groupCard = el.closest(".tools-group-card");
        if (groupCard) groupCard.open = true;
        el.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }
  });
}

// ==============================================================================
// PINNED PENDING QUEUE LOGIC (ANTIGRAVITY STYLE)
// ==============================================================================
let pendingQueue = [];

function updatePendingQueueUI() {
  const tray = document.getElementById("pendingQueueTray");
  const list = document.getElementById("pendingQueueList");
  const countEl = document.getElementById("pendingCount");

  if (!tray || !list) return;

  if (pendingQueue.length === 0) {
    tray.style.display = "none";
    list.innerHTML = "";
    return;
  }

  tray.style.display = "block";
  if (countEl) countEl.textContent = pendingQueue.length;
  list.innerHTML = "";

  pendingQueue.forEach((item, idx) => {
    const card = document.createElement("div");
    card.className = "pending-item-card";
    const imgTag = item.attachedImg ? `📎 [Screenshot] ` : "";
    card.innerHTML = `
      <div class="pending-item-text" title="${escapeHtml(item.text)}">
        <span style="color:var(--amber-warn);font-size:9px;margin-right:4px;">#${idx+1}</span>
        ${imgTag}${escapeHtml(item.text || "Attached image inquiry")}
      </div>
      <div class="pending-item-actions">
        <button class="btn-pending-action" onclick="editPendingMessage(${idx})" title="Edit back into input">✏️</button>
        <button class="btn-pending-action cancel" onclick="removePendingMessage(${idx})" title="Cancel pending message">✕</button>
      </div>
    `;
    list.appendChild(card);
  });
}

window.removePendingMessage = function(index) {
  pendingQueue.splice(index, 1);
  updatePendingQueueUI();
};

window.editPendingMessage = function(index) {
  const item = pendingQueue.splice(index, 1)[0];
  if (item) {
    userInput.value = item.text || "";
    if (item.attachedImg) {
      attachedUserImage = item.attachedImg;
      if (attachmentThumb && attachmentPreview) {
        attachmentThumb.src = item.attachedImg.thumbnail || ('file://' + item.attachedImg.path);
        attachmentName.textContent = item.attachedImg.filename || "Screenshot";
        attachmentSize.textContent = (item.attachedImg.size_kb || item.attachedImg.sizeKb || "Compressed") + " KB";
        attachmentPreview.style.display = "flex";
      }
    }
    userInput.focus();
    userInput.style.height = "20px";
    userInput.style.height = Math.min(userInput.scrollHeight, 110) + "px";
  }
  updatePendingQueueUI();
};

function processNextPendingMessage() {
  if (pendingQueue.length > 0 && !isGenerating) {
    const nextItem = pendingQueue.shift();
    updatePendingQueueUI();
    executeSendMessage(nextItem.text, nextItem.attachedImg);
  }
}

// ==============================================================================
// MESSAGE BUBBLE GENERATOR
// ==============================================================================
function appendMessage(role, content, attachedImg = null, tools = null) {
  heroBanner.style.display = "none";

  const msgDiv = document.createElement("div");
  msgDiv.className = `message ${role}`;

  const metaDiv = document.createElement("div");
  metaDiv.className = "message-meta";
  metaDiv.textContent = role === "user" ? "YOU" : "MR. FLOW (AGENT)";
  msgDiv.appendChild(metaDiv);

  const bubbleDiv = document.createElement("div");
  bubbleDiv.className = "bubble";

  if (attachedImg) {
    const previewBox = document.createElement("div");
    previewBox.className = "user-attached-preview";
    previewBox.onclick = () => window.openImageModal(attachedImg.path);
    const kb = attachedImg.size_kb || attachedImg.sizeKb || "";
    previewBox.innerHTML = `
      <img src="${attachedImg.thumbnail || ('file://' + attachedImg.path)}" />
      <span class="user-attached-tag">📎 ${escapeHtml(attachedImg.filename || 'Screenshot')} ${kb ? '(' + kb + ' KB)' : ''}</span>
    `;
    bubbleDiv.appendChild(previewBox);
  }

  // If past session tools exist, bundle into unified collapsed container
  if (tools && tools.length > 0) {
    const groupCard = document.createElement("details");
    groupCard.className = "tools-group-card";
    const toolCount = tools.length;
    const hasError = tools.some(t => t.status === "error");
    const statusCls = hasError ? "error" : "success";
    const statusTxt = hasError ? "✕ Error" : "✓ Selesai";

    let itemsHtml = "";
    tools.forEach(t => {
      const pStr = t.args ? (typeof t.args === "object" ? JSON.stringify(t.args, null, 2) : t.args) : "";
      const rStr = t.result || "";
      const isErr = t.status === "error";
      let summaryCmd = "";
      if (t.args) {
        if (t.args.command) summaryCmd = t.args.command.substring(0, 35);
        else if (t.args.file_path) summaryCmd = t.args.file_path.substring(0, 35);
        else if (t.args.filename) summaryCmd = t.args.filename.substring(0, 35);
      }
      itemsHtml += `
        <div class="tool-item-card">
          <div class="tool-item-header">
            <div class="tool-name-info">
              <span>⚙️</span>
              <strong>${escapeHtml(t.name || 'Tool')}</strong>
              ${summaryCmd ? `<span class="tool-cmd-snippet">(${escapeHtml(summaryCmd)})</span>` : ''}
            </div>
            <span class="tool-badge ${isErr ? 'error' : 'success'}">${isErr ? '✕ FAILED' : '✓ EXECUTED'}</span>
          </div>
          ${pStr ? `<div class="tool-param-box">${escapeHtml(pStr)}</div>` : ''}
          ${rStr ? `<div class="tool-result-box">${escapeHtml(rStr)}</div>` : ''}
        </div>
      `;
    });

    groupCard.innerHTML = `
      <summary class="tools-group-header">
        <div class="tools-group-title">
          <span class="tools-chevron">▶</span>
          <span>🛠️ Eksekusi Tools</span>
          <span class="tools-count-badge">${toolCount} tool${toolCount > 1 ? 's' : ''}</span>
        </div>
        <span class="tools-group-status ${statusCls}">${statusTxt}</span>
      </summary>
      <div class="tools-group-items">${itemsHtml}</div>
    `;
    bubbleDiv.appendChild(groupCard);
  }

  if (content || !attachedImg) {
    const textDiv = document.createElement("div");
    textDiv.innerHTML = role === "user" ? escapeHtml(content) : formatMarkdown(content);
    bubbleDiv.appendChild(textDiv);
  }

  msgDiv.appendChild(bubbleDiv);

  // Bottom action bar (di bawah chat bubble)
  const footerRow = document.createElement("div");
  footerRow.className = "msg-footer-row";
  footerRow.innerHTML = `
    <div class="msg-action-bar">
      <button class="btn-msg-action" onclick="window.copyMessageBubble(this)" title="Copy message text">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </button>
      <button class="btn-msg-action" onclick="window.forwardMessageBubble(this)" title="Forward / Quote into input">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 14 20 9 15 4"></polyline><path d="M4 20v-7a4 4 0 0 1 4-4h12"></path></svg>
      </button>
      <button class="btn-msg-action" onclick="window.retryMessageBubble(this)" title="${role === 'user' ? 'Resend this prompt' : 'Regenerate response'}">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
      </button>
    </div>
  `;
  msgDiv.appendChild(footerRow);

  chatContainer.appendChild(msgDiv);
  chatContainer.scrollTop = chatContainer.scrollHeight;

  return bubbleDiv;
}

function escapeHtml(str) {
  return (str || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/\n/g, "<br>");
}

// ==============================================================================
// UNIFIED AGENT EVENT HANDLER (FROM MR. FLOW CLI STREAM)
// ==============================================================================
window.onAgentEvent = function(event) {
  if (!event) return;

  if (event.type === "init") {
    currentSessionId = event.session_id || currentSessionId;
    sessionStatus.textContent = `Session: ${currentSessionId.substring(0, 8)}...`;
    return;
  }

  if (!currentAssistantBubble && (event.type === "message" || event.type === "tool_use")) {
    currentAssistantBubble = appendMessage("assistant", "");
  }

  // Clear initial streaming dots or thinking HUD if real content or tool arrives
  if (currentAssistantBubble) {
    const thinking = currentAssistantBubble.querySelector(".agent-thinking-hud");
    if (thinking) {
      thinking.remove();
      if (window._thinkingTimerInterval) {
        clearInterval(window._thinkingTimerInterval);
        window._thinkingTimerInterval = null;
      }
    }
    const dots = currentAssistantBubble.querySelector(".streaming-dots");
    if (dots && dots.parentElement) {
      dots.parentElement.remove();
    }
  }

  if (event.type === "tool_use") {
    const toolCardId = "tool_" + (event.tool_id || Math.random().toString(36).substring(2, 9));
    const toolName = event.tool_name || "Tool";
    const params = event.parameters ? JSON.stringify(event.parameters, null, 2) : "";

    let summaryCmd = "";
    if (event.parameters) {
      if (event.parameters.command) summaryCmd = event.parameters.command.substring(0, 45);
      else if (event.parameters.file_path) summaryCmd = event.parameters.file_path.substring(0, 45);
      else if (event.parameters.filename) summaryCmd = event.parameters.filename.substring(0, 45);
    }

    // 1. Ekstrak Reason / Tujuan Nyata & Visual Operasional Nyata
    const reason = extractAgentReason(toolName, event.parameters, event);
    const realVis = generateRealToolVisual(toolName, event.parameters);

    // 2. Buka Focused Execution Stage (Chat history disembunyikan agar user fokus pada tool ini saja)
    openExecutionStage(toolName, reason, realVis.targetPath, realVis.metaInfo, realVis.html);

    // 3. Update pinned task bar
    showActiveTaskBar(toolName, summaryCmd || toolName, toolCardId);

    // 4. Catat ke assistant bubble secara terstruktur untuk arsip
    let groupCard = currentAssistantBubble.querySelector(".tools-group-card");
    if (!groupCard) {
      groupCard = document.createElement("details");
      groupCard.className = "tools-group-card";
      groupCard._toolCount = 0;
      groupCard.innerHTML = `
        <summary class="tools-group-header">
          <div class="tools-group-title">
            <span class="tools-chevron">▶</span>
            <span>🛠️ Eksekusi Tools</span>
            <span class="tools-count-badge">1 tool</span>
          </div>
          <span class="tools-group-status running">RUNNING...</span>
        </summary>
        <div class="tools-group-items"></div>
      `;
      if (activeTextContainer) {
        currentAssistantBubble.insertBefore(groupCard, activeTextContainer);
      } else {
        currentAssistantBubble.appendChild(groupCard);
      }
    }

    groupCard._toolCount = (groupCard._toolCount || 0) + 1;
    const countBadge = groupCard.querySelector(".tools-count-badge");
    if (countBadge) {
      countBadge.textContent = `${groupCard._toolCount} tool${groupCard._toolCount > 1 ? 's' : ''}`;
    }
    const groupStatus = groupCard.querySelector(".tools-group-status");
    if (groupStatus) {
      groupStatus.className = "tools-group-status running";
      groupStatus.textContent = "RUNNING...";
    }

    const itemsContainer = groupCard.querySelector(".tools-group-items");
    const toolItem = document.createElement("div");
    toolItem.className = "tool-item-card";
    toolItem.id = toolCardId;
    toolItem.innerHTML = `
      <div class="tool-item-header">
        <div class="tool-name-info">
          <span>⚙️</span>
          <strong>${escapeHtml(toolName)}</strong>
          ${summaryCmd ? `<span class="tool-cmd-snippet">(${escapeHtml(summaryCmd)})</span>` : ''}
        </div>
        <span class="tool-badge running">RUNNING</span>
      </div>
      <div class="tool-reason-snippet" style="padding:4px 8px;font-size:8.5px;color:var(--cyan-bright);background:rgba(0,0,0,0.2);border-bottom:1px dashed rgba(255,255,255,0.05);">${escapeHtml(reason)}</div>
      ${params ? `<div class="tool-param-box">${escapeHtml(params)}</div>` : ''}
      <div class="tool-result-box" id="${toolCardId}_res" style="display:none;">Waiting for output...</div>
    `;

    itemsContainer.appendChild(toolItem);
  }

  else if (event.type === "tool_result") {
    const toolCardId = "tool_" + (event.tool_id || "");
    const toolCard = document.getElementById(toolCardId);
    const outText = event.output ? (typeof event.output === "object" ? JSON.stringify(event.output, null, 2) : event.output) : "[No output]";

    // Update Focused Execution Stage dengan hasil riil
    updateExecutionStageResult(event.status, outText);

    if (toolCard) {
      const badge = toolCard.querySelector(".tool-badge");
      if (badge) {
        if (event.status === "error") {
          badge.className = "tool-badge error";
          badge.textContent = "✕ FAILED";
        } else {
          badge.className = "tool-badge success";
          badge.textContent = "✓ EXECUTED";
        }
      }

      const resBox = document.getElementById(`${toolCardId}_res`);
      if (resBox) {
        resBox.textContent = outText;
        resBox.style.display = "block";
      }

      // Update pinned active task bar status
      updateActiveTaskBarFinished(event.status);

      // Check groupCard overall status
      const groupCard = toolCard.closest(".tools-group-card");
      if (groupCard) {
        const allBadges = groupCard.querySelectorAll(".tool-item-card .tool-badge");
        let anyRunning = false;
        let anyError = false;
        allBadges.forEach(b => {
          if (b.classList.contains("running")) anyRunning = true;
          if (b.classList.contains("error")) anyError = true;
        });
        const groupStatus = groupCard.querySelector(".tools-group-status");
        if (groupStatus) {
          if (anyRunning) {
            groupStatus.className = "tools-group-status running";
            groupStatus.textContent = "RUNNING...";
          } else if (anyError) {
            groupStatus.className = "tools-group-status error";
            groupStatus.textContent = "✕ Error";
          } else {
            groupStatus.className = "tools-group-status success";
            groupStatus.textContent = "✓ Selesai";
          }
        }
      }

      // Check if tool is screenshot to display screenshot card
      const outStr = String(event.output || "");
      if (outStr.includes("Pictures/Screenshots") && (outStr.includes(".png") || outStr.includes(".jpg"))) {
        const match = outStr.match(/(\/[^\s"']+\/Pictures\/Screenshots\/[^\s"']+\.(png|jpg|jpeg))/i);
        if (match && match[1]) {
          renderAgentScreenshotCard(match[1]);
        }
      }
    }
  }

  else if (event.type === "message" && event.role === "assistant") {
    // Pesan teks asisten mulai masuk: tutup execution stage dan kembali ke tampilan chat
    closeExecutionStage();

    if (event.content) {
      if (!activeTextContainer) {
        activeTextContainer = document.createElement("div");
        activeTextContainer.className = "bubble-text";
        activeTextContainer._rawText = "";
        currentAssistantBubble.appendChild(activeTextContainer);
      }
      activeTextContainer._rawText += event.content;
      activeTextContainer.innerHTML = formatMarkdown(activeTextContainer._rawText);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }
  }

  else if (event.type === "done" || event.type === "result") {
    isGenerating = false;
    btnSend.classList.remove("spinning");
    btnSend.title = "Send (Enter)";
    sessionStatus.textContent = "Sovereign Agent: Ready";
    closeExecutionStage();
    hideActiveTaskBar();
    if (window._thinkingTimerInterval) {
      clearInterval(window._thinkingTimerInterval);
      window._thinkingTimerInterval = null;
    }

    if (currentAssistantBubble) {
      const groupCard = currentAssistantBubble.querySelector(".tools-group-card");
      if (groupCard) {
        const groupStatus = groupCard.querySelector(".tools-group-status");
        if (groupStatus && groupStatus.classList.contains("running")) {
          const anyError = groupCard.querySelector(".tool-badge.error");
          if (anyError) {
            groupStatus.className = "tools-group-status error";
            groupStatus.textContent = "✕ Error";
          } else {
            groupStatus.className = "tools-group-status success";
            groupStatus.textContent = "✓ Selesai";
          }
        }
      }
    }
    userInput.focus();
    chatContainer.scrollTop = chatContainer.scrollHeight;

    // Process pending messages queue if any!
    setTimeout(processNextPendingMessage, 300);
  }

  else if (event.type === "error") {
    isGenerating = false;
    btnSend.classList.remove("spinning");
    btnSend.title = "Send (Enter)";
    sessionStatus.textContent = "Error";
    hideActiveTaskBar();
    if (window._thinkingTimerInterval) {
      clearInterval(window._thinkingTimerInterval);
      window._thinkingTimerInterval = null;
    }

    if (currentAssistantBubble) {
      const errP = document.createElement("p");
      errP.style.color = "var(--crimson-danger)";
      errP.innerHTML = `<strong>⚠️ Error:</strong> ${escapeHtml(event.message || "Execution error")}`;
      currentAssistantBubble.appendChild(errP);
    }
    userInput.focus();

    // Process pending messages queue if any!
    setTimeout(processNextPendingMessage, 300);
  }
};

// ==============================================================================
// SEND MESSAGE & QUEUEING ENGINE
// ==============================================================================
function sendMessage() {
  const text = userInput.value.trim();
  if (!text && !attachedUserImage) return;

  const imgToSend = attachedUserImage;
  attachedUserImage = null;
  attachmentPreview.style.display = "none";
  attachmentThumb.src = "";
  userInput.value = "";
  userInput.style.height = "20px";

  // If agent is currently executing, queue this message!
  if (isGenerating) {
    pendingQueue.push({
      text: text,
      attachedImg: imgToSend,
      timestamp: Date.now()
    });
    updatePendingQueueUI();
    return;
  }

  // Not generating: execute immediately
  executeSendMessage(text, imgToSend);
}

function executeSendMessage(text, imgToSend) {
  appendMessage("user", text, imgToSend);

  isGenerating = true;
  btnSend.classList.add("spinning");
  btnSend.title = "Agent is executing... (Type to queue next message)";
  sessionStatus.textContent = "Mr. Flow Thinking & Executing...";

  activeTextContainer = null;
  currentAssistantBubble = appendMessage("assistant", "");
  currentAssistantBubble.innerHTML = `<div class="bubble-text" style="color:#64748b;font-style:italic;">Mr. Flow sedang memproses instruksi...</div>`;

  // Buka Focused Execution Stage untuk nalar awal agen (History disembunyikan agar user fokus)
  openExecutionStage(
    "thinking",
    `Menganalisa instruksi: "${(text || '').substring(0, 80)}"`,
    "Mr. Flow Autonomous Engine",
    "Perencanaan Langkah",
    `<div class="thinking-stage-view">
       <div class="thinking-stage-title">
         <span>🧠</span> <span>Mengevaluasi konteks workspace & menyusun rencana eksekusi...</span>
       </div>
       <div class="thinking-stage-body">
         Memeriksa status direktori dan menyiapkan verifikasi file atau perintah sistem...
       </div>
     </div>`
  );

  let promptToSend = text;
  if (imgToSend && imgToSend.path) {
    const kb = imgToSend.size_kb || imgToSend.sizeKb || "";
    promptToSend = `[User Attached Screenshot: ${imgToSend.path} (${kb} KB compressed)]\n${text || "Tolong analisa screenshot ini."}`;
  }

  // Delegate directly to Python to execute /usr/local/bin/mrflow
  sendPyBridge("send_agent_message", {
    prompt: promptToSend,
    sessionId: currentSessionId,
    workspace: currentWorkspace
  });
}

btnSend.addEventListener("click", sendMessage);

// Initial load
userInput.focus();
hideActiveTaskBar();
closeExecutionStage();
sendPyBridge("get_initial_state");
</script>
