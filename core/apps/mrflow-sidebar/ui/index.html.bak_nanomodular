// Send message to Python via WebKit pybridge
function sendPyBridge(action, payload = {}) {
  try {
    if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.pybridge) {
      window.webkit.messageHandlers.pybridge.postMessage(JSON.stringify({ action, ...payload }));
    }
  } catch (err) {
    console.error("PyBridge error:", err);
  }
}

