let thinkingLogStreamInterval = null;

function startThinkingLogStream() {
  stopThinkingLogStream();
  const track = document.querySelector(".fl-brain-log-track");
  if (!track) return;

  let logIndex = Math.floor(Math.random() * FLOWORK_TELEMETRY_LOGS.length);
  let startTime = Date.now();

  thinkingLogStreamInterval = setInterval(() => {
    const t = document.querySelector(".fl-brain-log-track");
    if (!t) {
      stopThinkingLogStream();
      return;
    }

    const item = FLOWORK_TELEMETRY_LOGS[logIndex % FLOWORK_TELEMETRY_LOGS.length];
    logIndex++;
    const elapsed = ((Date.now() - startTime) / 1000).toFixed(3);

    const row = document.createElement("div");
    row.className = "fl-brain-log-row";
    row.innerHTML = `<span class="fl-log-time">${elapsed}s</span> <span class="fl-log-tag ${item.cls}">[${item.tag}]</span> ${escapeHtml(item.text)}`;

    t.appendChild(row);

    // Keep strictly max 20 elements to prevent any squishing or DOM overflow
    while (t.children.length > 20) {
      t.removeChild(t.firstChild);
    }

    t.scrollTop = t.scrollHeight;
  }, 40);
}

function stopThinkingLogStream() {
  if (thinkingLogStreamInterval) {
    clearInterval(thinkingLogStreamInterval);
    thinkingLogStreamInterval = null;
  }
}

