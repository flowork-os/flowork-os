window.copyMessageBubble = function(btn) {
  const msgDiv = btn.closest(".message");
  if (!msgDiv) return;
  const bubble = msgDiv.querySelector(".bubble");
  if (!bubble) return;
  const clone = bubble.cloneNode(true);
  clone.querySelectorAll(".tools-group-card, .agent-screenshot-card, .user-attached-preview, .code-header").forEach(el => el.remove());
  const rawText = clone.innerText.trim();

  navigator.clipboard.writeText(rawText).then(() => {
    btn.classList.add("copied");
    btn.innerHTML = `<span style="font-size:9px;color:var(--green-matrix);font-weight:bold;">✓</span>`;
    setTimeout(() => {
      btn.classList.remove("copied");
      btn.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
    }, 1500);
  });
};

window.forwardMessageBubble = function(btn) {
  const msgDiv = btn.closest(".message");
  if (!msgDiv) return;
  const bubble = msgDiv.querySelector(".bubble");
  if (!bubble) return;
  const clone = bubble.cloneNode(true);
  clone.querySelectorAll(".tools-group-card, .agent-screenshot-card, .user-attached-preview, .code-header").forEach(el => el.remove());
  const rawText = clone.innerText.trim();

  userInput.value = rawText;
  userInput.focus();
  userInput.style.height = "20px";
  userInput.style.height = Math.min(userInput.scrollHeight, 110) + "px";
};

window.retryMessageBubble = function(btn) {
  const msgDiv = btn.closest(".message");
  if (!msgDiv) return;
  const isUser = msgDiv.classList.contains("user");
  let promptToResend = "";

  if (isUser) {
    const clone = msgDiv.querySelector(".bubble").cloneNode(true);
    clone.querySelectorAll(".user-attached-preview").forEach(el => el.remove());
    promptToResend = clone.innerText.trim();
  } else {
    let prev = msgDiv.previousElementSibling;
    while (prev) {
      if (prev.classList.contains("message") && prev.classList.contains("user")) {
        const clone = prev.querySelector(".bubble").cloneNode(true);
        clone.querySelectorAll(".user-attached-preview").forEach(el => el.remove());
        promptToResend = clone.innerText.trim();
        break;
      }
      prev = prev.previousElementSibling;
    }
  }

  if (promptToResend) {
    userInput.value = promptToResend;
    sendMessage();
  }
};

// ==============================================================================
// REAL OPERATIONAL TOOL METADATA & REASON EXTRACTOR
// ==============================================================================
function getToolInfo(toolName) {
  const name = (toolName || "").toLowerCase();

  // 1. Directory Tree & Inode Traverser
  if (name.includes("list_dir") || name.includes("directory") || name.includes("dir_tree") || name === "ls") {
    return {
      icon: "📁",
      label: "Eksplorasi Inode & Direktori (list_directory)",
      defaultReason: "Memindai struktur pohon direktori dan atribut inode berkas target."
    };
  }

  // 2. Read Many Files (Batch Ingestion)
  if (name.includes("read_many") || name.includes("batch_read") || name.includes("many_files")) {
    return {
      icon: "📚",
      label: "Pemuatan Batch Multi-Berkas (read_many_files)",
      defaultReason: "Membaca paralel beberapa berkas secara asinkron via descriptor readv."
    };
  }

  // 3. Background Process Table
  if (name.includes("list_background") || name.includes("background_process") || name.includes("proc_table") || name.includes("ps_aux")) {
    return {
      icon: "📊",
      label: "Tabel Proses Kernel PID (list_background_processes)",
      defaultReason: "Menginspeksi status /proc/[pid]/stat dan penggunaan memori daemon latar."
    };
  }

  // 4. Background Output Ring Buffer
  if (name.includes("read_background") || name.includes("background_output") || name.includes("ring_buffer") || name.includes("tail_log")) {
    return {
      icon: "📟",
      label: "Streaming Ring-Buffer Daemon (read_background_output)",
      defaultReason: "Membaca stream output non-blocking dari circular FIFO buffer latar."
    };
  }

  // 5. AT-SPI Desktop Wireframe
  if (name.includes("agent_desktop") || name.includes("desktop_app") || name.includes("atspi") || name.includes("accessibility_tree")) {
    return {
      icon: "🖥️",
      label: "Inspektor AT-SPI OS Desktop (agent_desktop)",
      defaultReason: "Memeriksa pohon aksesibilitas AT-SPI dan bounding box jendela X11/Wayland."
    };
  }

  // 6. CDP Input (Click / Fill / Type)
  if (name.includes("click") || name.includes("fill") || name.includes("type_text") || name.includes("hover") || name.includes("press_key")) {
    return {
      icon: "🎯",
      label: "Injeksi Input Sintetis CDP (browser_click)",
      defaultReason: "Menginjeksi koordinat klik dan simulasi pengetikan low-level via DevTools."
    };
  }

  // 7. Network Waterfall
  if (name.includes("network") || name.includes("waterfall") || name.includes("har") || name.includes("requests")) {
    return {
      icon: "🌊",
      label: "Waterfall Trafik Jaringan (browser_list_network_requests)",
      defaultReason: "Merekam timeline request HTTP, status code, dan latensi muatan halaman."
    };
  }

  // 8. Snapshot A11y Tree
  if (name.includes("snapshot") || name.includes("dom_tree") || name.includes("a11y_tree")) {
    return {
      icon: "🌳",
      label: "Snapshot Pohon A11y DOM (browser_take_snapshot)",
      defaultReason: "Mengekstrak hierarki pohon aksesibilitas semantik dengan identifikasi @ref."
    };
  }

