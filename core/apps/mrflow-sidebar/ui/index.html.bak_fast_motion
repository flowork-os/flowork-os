function openExecutionStage(toolName, reasonText, targetPath, metaInfo, initialBodyHtml) {
  const stage = document.getElementById("executionFocusStage");
  const chat = document.getElementById("chatContainer");
  const icon = document.getElementById("stageIcon");
  const nameEl = document.getElementById("stageToolName");
  const badge = document.getElementById("stageStatusBadge");
