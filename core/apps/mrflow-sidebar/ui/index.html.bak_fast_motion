let isDragging = false;
let startX = 0;
let startWidth = 460;

dragHandle.addEventListener("mousedown", (e) => {
  isDragging = true;
  startX = e.screenX;
  startWidth = window.innerWidth;
  dragHandle.classList.add("dragging");
  document.body.style.cursor = "ew-resize";
  e.preventDefault();
});

