{
  "manifest_version": 3,
  "name": "Flowork Sovereign Web-Conduit",
  "version": "1.0.0",
  "description": "High-speed sovereign bridge connecting Gemini Web, Claude, and ChatGPT directly to Flowork OS daemon for terminal execution and desktop control.",
  "permissions": [
    "storage",
    "notifications",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:18090/*",
    "http://localhost:18090/*",
    "ws://127.0.0.1:9099/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flowork Sovereign Web-Conduit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
