[Desktop Entry]
Name=Launchpad
Comment=Flowork Sovereign Spotlight & Application Launchpad
Exec=/usr/local/bin/flowork-launchpad
Icon=view-app-grid
Terminal=false
Type=Application
Categories=System;Utility;

Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix launchpad
