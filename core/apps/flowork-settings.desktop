[Desktop Entry]
Name=Flowork Settings
Comment=Sovereign Flowork OS System Settings & Control Center
Exec=flowork-settings
Icon=preferences-system
Terminal=false
Type=Application
Categories=Settings;HardwareSettings;DesktopSettings;
Keywords=settings;control;hardware;system;preferences;
StartupNotify=true

Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix settings
