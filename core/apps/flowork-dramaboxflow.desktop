[Desktop Entry]
Version=1.0
Type=Application
Name=DramaBox & Melolo Flow
GenericName=Short Drama Video Player
Comment=Streaming 1.845+ DramaBox & 3.400+ Melolo short dramas dengan akses katalog lengkap & unlocked streaming
Exec=/opt/floworkos/bin/dramaboxflow %U
Icon=/opt/floworkos/icons/dramaboxflow.png
Terminal=false
Categories=X-Flowork;AudioVideo;Player;Network;Video;
Keywords=drama;dramabox;melolo;video;player;short;series;streaming;nonton;film;reels;
StartupNotify=true
StartupWMClass=dramaboxflow
Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix dramaboxflow
