#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — SMART APPLICATION RUNNER: Craft Anything
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
CACHE_DIR="${HOME}/.cache/flowork"
mkdir -p "$CACHE_DIR"
chmod 700 "$CACHE_DIR" 2>/dev/null || true
CACHE_BIN="${CACHE_DIR}/.craft_anything_gui"
BIN_DIR="/opt/floworkos/apps/craft-anything/bin"
XZ_PAYLOAD="$BIN_DIR/craft-anything.xz"

if [ ! -f "$CACHE_BIN" ] || [ "$XZ_PAYLOAD" -nt "$CACHE_BIN" ]; then
    TMP_BIN="$(mktemp "${CACHE_DIR}/.craft_anything_gui.XXXXXX")"
    if xz -dc "$XZ_PAYLOAD" > "$TMP_BIN"; then
        chmod 700 "$TMP_BIN"
        mv -f "$TMP_BIN" "$CACHE_BIN"
    else
        rm -f "$TMP_BIN"
        exit 1
    fi
fi

if [ "${1:-}" = "--foreground" ] || [ "${1:-}" = "-f" ]; then
    shift
    exec "$CACHE_BIN" "$@"
else
    nohup "$CACHE_BIN" "$@" >/dev/null 2>&1 &
fi
