#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — SOVEREIGN SMART APPLICATION RUNNER: SherlockCraft
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"

if [ "$1" = "--foreground" ] || [ "$1" = "-f" ]; then
    shift
    exec python3 "/opt/floworkos/apps/sherlockcraft/bin/app.py" --app-dir "/opt/floworkos/apps/sherlockcraft" --title "SherlockCraft" "$@"
else
    # Detached execution: instant fallback without hanging caller
    nohup python3 "/opt/floworkos/apps/sherlockcraft/bin/app.py" --app-dir "/opt/floworkos/apps/sherlockcraft" --title "SherlockCraft" "$@" >/dev/null 2>&1 &
fi
