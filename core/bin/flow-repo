#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — SOVEREIGN SMART APPLICATION RUNNER: FlowRepo
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"

if [ "$1" = "--foreground" ] || [ "$1" = "-f" ]; then
    shift
    exec python3 "/opt/floworkos/apps/flow-repo/bin/app.py" --app-dir "/opt/floworkos/apps/flow-repo" --title "FlowRepo" "$@"
else
    # Detached execution: instant fallback without hanging caller
    nohup python3 "/opt/floworkos/apps/flow-repo/bin/app.py" --app-dir "/opt/floworkos/apps/flow-repo" --title "FlowRepo" "$@" >/dev/null 2>&1 &
fi
