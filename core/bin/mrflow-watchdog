#!/usr/bin/env python3
"""
⚡ MRFLOW AUTONOMOUS SELF-HEALING & ACTIVE TRIGGER SENTINEL
Autonomous monitoring and self-healing daemon for Flowork OS.
Monitors sysd, connector :9099, memory pressure, and cleans stale shm artifacts proactively.
"""

import sys
import os
import time
import json
import subprocess
import urllib.request

WATCHDOG_CONFIG_PATH = os.path.expanduser("~/.flowork/prompts/watchdog_config.json")
SYSTEM_CONFIG_PATH = "/opt/floworkos/prompts/watchdog_config.json"
SIGNAL_FILE = "/tmp/flowork_active_trigger.json"
ICON_PATH = "/usr/share/icons/hicolor/128x128/apps/mrflow-router.png"
SENTINEL_ENGINE = "/opt/floworkos/tools/self_healing_sentinel/run.py"

def load_config():
    target = WATCHDOG_CONFIG_PATH if os.path.exists(WATCHDOG_CONFIG_PATH) else SYSTEM_CONFIG_PATH
    if os.path.exists(target):
        try:
            with open(target, 'r') as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "enabled": True,
        "interval_sec": 30,
        "self_healing_enabled": True
    }

def run_self_healing_tick():
    """Runs single self-healing diagnosis and triage cycle."""
    if not os.path.exists(SENTINEL_ENGINE):
        return
    try:
        proc = subprocess.run(
            [sys.executable, SENTINEL_ENGINE],
            input=json.dumps({"action": "heal"}),
            capture_output=True,
            text=True,
            timeout=10
        )
        if proc.returncode == 0:
            res = json.loads(proc.stdout)
            if res.get("initial_health") != "healthy":
                send_awakening_signal("SelfHealingSentinel", f"Autonomous triage: {', '.join(res.get('actions_taken', []))}")
    except Exception as e:
        print(f"[Sentinel] Self-healing tick error: {e}", file=sys.stderr)

def send_awakening_signal(source, instruction):
    """Writes active trigger signal and dispatches desktop notification."""
    data = {
        "active": True,
        "timestamp": int(time.time()),
        "source": source,
        "instruction": instruction
    }
    try:
        with open(SIGNAL_FILE, 'w') as f:
            json.dump(data, f, indent=2)
    except Exception as e:
        print(f"[Watchdog] Error writing signal: {e}", file=sys.stderr)

    # Native Desktop Notification
    try:
        env = dict(os.environ)
        if "DISPLAY" not in env or not env["DISPLAY"]:
            env["DISPLAY"] = ":0"
        subprocess.Popen([
            "notify-send",
            "-i", ICON_PATH if os.path.exists(ICON_PATH) else "dialog-warning",
            "-u", "normal",
            f"⚡ MrFlow Sentinel [{source}]",
            instruction
        ], env=env)
    except Exception:
        pass

def main():
    print("⚡ [MrFlow Watchdog Sentinel] Autonomous Self-Healing Daemon Online.")
    while True:
        cfg = load_config()
        if not cfg.get("enabled", True):
            time.sleep(10)
            continue

        interval = cfg.get("interval_sec", 30)

        # 1. Proactive Self-Healing Triage
        if cfg.get("self_healing_enabled", True):
            run_self_healing_tick()

        # 2. Clear expired trigger signals (> 5 minutes)
        if os.path.exists(SIGNAL_FILE):
            try:
                with open(SIGNAL_FILE, 'r') as f:
                    sig = json.load(f)
                if time.time() - sig.get("timestamp", 0) > 300:
                    os.unlink(SIGNAL_FILE)
            except Exception:
                pass

        time.sleep(interval)

if __name__ == "__main__":
    main()
