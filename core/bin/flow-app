#!/usr/bin/env python3
"""
👑 FLOWORK OS — SOVEREIGN APP-ON-DEMAND CLI ENGINE (flow-app)
Synthesize, test, register, and launch bespoke native desktop applications instantly.
Enforces the Sovereign '*flow' application naming ecosystem identity.
Universal root: /opt/floworkos
"""

import sys
import os
import json
import shutil
import subprocess
import argparse
import re

FLOWORK_ROOT = "/opt/floworkos"
APPS_DIR = os.path.join(FLOWORK_ROOT, "apps")
BIN_DIR = os.path.join(FLOWORK_ROOT, "bin")
ICONS_DIR = os.path.join(FLOWORK_ROOT, "icons")
TEMPLATE_DIR = os.path.join(APPS_DIR, "craft-anything", "templates", "quantum-glass")
APPS_REGISTRY = os.path.join(APPS_DIR, "apps.json")
SYSTEM_APPLICATIONS = "/usr/share/applications"


def sanitize_app_id(app_id):
    """
    Sanitizes app_id and enforces the Sovereign '*flow' suffix identity.
    Example: 'notes' -> 'notesflow', 'disk' -> 'diskflow', 'codeflow' -> 'codeflow'.
    """
    clean = re.sub(r'[^a-z0-9_-]', '', app_id.lower().strip())
    if not clean:
        clean = f"app_{int(os.times().elapsed)}"
    
    # If the app already exists on disk under APPS_DIR, preserve exact name
    if os.path.isdir(os.path.join(APPS_DIR, clean)):
        return clean

    # Enforce '*flow' suffix for new synthesis
    if not clean.endswith("flow"):
        clean = f"{clean}flow"
        
    return clean


def format_display_name(name, app_id):
    """
    Ensures the display name feels native and aligns with the Flowork ecosystem.
    """
    trimmed = name.strip()
    if not trimmed:
        # Generate from app_id (e.g. notesflow -> Notes Flow)
        base = app_id[:-4] if app_id.endswith("flow") else app_id
        return f"{base.capitalize()} Flow"
    if not trimmed.lower().endswith("flow"):
        return f"{trimmed} Flow"
    return trimmed


def create_app(raw_app_id, name, desc="", icon="⚡", category="Utility", version="1.0.0", force=False):
    app_id = sanitize_app_id(raw_app_id)
    display_name = format_display_name(name, app_id)
    target_dir = os.path.join(APPS_DIR, app_id)

    if os.path.exists(target_dir):
        if not force:
            print(f"❌ Error: App directory already exists at {target_dir}. Use --force to overwrite.", file=sys.stderr)
            return 1
        shutil.rmtree(target_dir)

    print(f"⚡ Synthesizing Sovereign Flow App [{app_id}] from Quantum Glass template...")
    shutil.copytree(TEMPLATE_DIR, target_dir)

    # Replace placeholders in index.html
    html_path = os.path.join(target_dir, "ui", "index.html")
    with open(html_path, "r", encoding="utf-8") as f:
        content = f.read()

    content = content.replace("{{APP_NAME}}", display_name)
    content = content.replace("{{APP_ICON}}", icon)
    content = content.replace("{{APP_DESCRIPTION}}", desc or f"Sovereign JIT application synthesized for Flowork OS.")
    content = content.replace("{{APP_VERSION}}", version)

    with open(html_path, "w", encoding="utf-8") as f:
        f.write(content)

    # Create app metadata manifest
    manifest = {
        "id": app_id,
        "name": display_name,
        "description": desc,
        "icon": icon,
        "category": category,
        "version": version,
        "synthesized_at": subprocess.check_output(["date", "-Iseconds"]).decode().strip(),
        "runtime": "python-webkit2-gtk",
        "entry": {
            "runner": f"/opt/floworkos/apps/{app_id}/bin/app.py",
            "ui": f"/opt/floworkos/apps/{app_id}/ui/index.html"
        }
    }
    with open(os.path.join(target_dir, "app.json"), "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)

    # Ensure runner is executable
    runner_path = os.path.join(target_dir, "bin", "app.py")
    os.chmod(runner_path, 0o755)

    # Create Launcher Script in /opt/floworkos/bin/<app-id>
    launcher_path = os.path.join(BIN_DIR, app_id)
    with open(launcher_path, "w", encoding="utf-8") as f:
        f.write(f"""#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — SOVEREIGN SMART APPLICATION RUNNER: {display_name}
# ==============================================================================
export DISPLAY="${{DISPLAY:-:0}}"

if [ "$1" = "--foreground" ] || [ "$1" = "-f" ]; then
    shift
    exec python3 "{runner_path}" --app-dir "{target_dir}" --title "{display_name}" "$@"
else
    # Detached execution: instant fallback without hanging caller
    nohup python3 "{runner_path}" --app-dir "{target_dir}" --title "{display_name}" "$@" >/dev/null 2>&1 &
fi
""")
    os.chmod(launcher_path, 0o755)

    print(f"✓ App directory synthesized: {target_dir}")
    print(f"✓ Launcher script generated: {launcher_path}")
    return 0


def test_app(raw_app_id):
    app_id = sanitize_app_id(raw_app_id)
    target_dir = os.path.join(APPS_DIR, app_id)
    runner_path = os.path.join(target_dir, "bin", "app.py")

    if not os.path.exists(runner_path):
        print(f"❌ Error: App runner not found at {runner_path}", file=sys.stderr)
        return 1

    print(f"🔍 Testing headless initialization of [{app_id}]...")
    test_env = os.environ.copy()
    if not test_env.get("DISPLAY"):
        test_env["DISPLAY"] = ":0"
    cmd = [sys.executable, runner_path, "--check-health", "--app-dir", target_dir]
    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=test_env)

    if res.returncode == 0:
        print(f"✓ Headless health check passed: Exit Code 0")
        return 0
    else:
        print(f"❌ Health check failed with code {res.returncode}:", file=sys.stderr)
        print(res.stderr, file=sys.stderr)
        return res.returncode


def format_xdg_categories(raw_category):
    """Normalizes XDG desktop categories without double semicolons or unregistered Flowork/Design keys."""
    tokens = []
    for part in str(raw_category or "Utility").replace(",", ";").split(";"):
        tok = part.strip()
        if not tok:
            continue
        if tok == "Flowork":
            tok = "X-Flowork"
        elif tok == "Design":
            tok = "X-Design"
        if tok not in tokens:
            tokens.append(tok)
    if "X-Flowork" not in tokens:
        tokens.insert(0, "X-Flowork")
    return ";".join(tokens) + ";"


def register_app(raw_app_id):
    app_id = sanitize_app_id(raw_app_id)
    target_dir = os.path.join(APPS_DIR, app_id)
    manifest_path = os.path.join(target_dir, "app.json")

    if not os.path.exists(manifest_path):
        print(f"❌ Error: app.json manifest not found at {manifest_path}", file=sys.stderr)
        return 1

    with open(manifest_path, "r", encoding="utf-8") as f:
        meta = json.load(f)

    name = meta.get("name", app_id)
    desc = meta.get("description", "Flowork Sovereign Application")
    category = meta.get("category", "Utility")
    xdg_categories = format_xdg_categories(category)
    launcher_path = os.path.join(BIN_DIR, app_id)
    desktop_filename = f"flowork-{app_id}.desktop"

    # Default icon fallback
    icon_path = os.path.join(ICONS_DIR, f"{app_id}.png")
    if not os.path.exists(icon_path):
        icon_path = os.path.join(ICONS_DIR, "craft-anything.png")

    desktop_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name={name}
Comment={desc}
Exec={launcher_path} %U
Icon={icon_path}
Terminal=false
Categories={xdg_categories}
StartupNotify=true
StartupWMClass={app_id}
Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix {app_id}
"""

    # 1. Write to /opt/floworkos/apps/<desktop_filename>
    local_desktop = os.path.join(APPS_DIR, desktop_filename)
    with open(local_desktop, "w", encoding="utf-8") as f:
        f.write(desktop_content)
    os.chmod(local_desktop, 0o755)

    # 2. Write to /usr/share/applications/ if writable
    if os.access(SYSTEM_APPLICATIONS, os.W_OK):
        sys_desktop = os.path.join(SYSTEM_APPLICATIONS, desktop_filename)
        with open(sys_desktop, "w", encoding="utf-8") as f:
            f.write(desktop_content)
        os.chmod(sys_desktop, 0o755)

    # 3. Update apps.json catalog if not already present
    if os.path.exists(APPS_REGISTRY):
        try:
            with open(APPS_REGISTRY, "r", encoding="utf-8") as f:
                cat = json.load(f)
            apps_list = cat.get("apps", [])
            existing = next((a for a in apps_list if a.get("id") == app_id), None)
            if not existing:
                apps_list.append({
                    "id": app_id,
                    "name": name,
                    "description": desc,
                    "category": category,
                    "version": meta.get("version", "1.0.0"),
                    "icon": meta.get("icon", "⚡"),
                    "entry": {
                        "runner": f"/opt/floworkos/bin/{app_id}",
                        "gui": f"apps/{app_id}/ui/index.html"
                    }
                })
                cat["apps"] = apps_list
                with open(APPS_REGISTRY, "w", encoding="utf-8") as f:
                    json.dump(cat, f, indent=2)
        except Exception as e:
            print(f"⚠️ Warning updating apps.json: {e}", file=sys.stderr)

    print(f"✓ Application registered to Desktop Environment: {desktop_filename}")
    return 0


def launch_app(raw_app_id):
    app_id = sanitize_app_id(raw_app_id)
    launcher_path = os.path.join(BIN_DIR, app_id)

    if not os.path.exists(launcher_path):
        print(f"❌ Error: App launcher not found at {launcher_path}", file=sys.stderr)
        return 1

    print(f"🚀 Launching Sovereign App [{app_id}]...")
    subprocess.Popen([launcher_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


def list_apps():
    print("==================================================================")
    print("👑 FLOWORK OS — SYNTHESIZED FLOW APPLICATIONS (*flow)")
    print("==================================================================")
    if not os.path.exists(APPS_DIR):
        print("Zero apps found.")
        return 0

    raw_items = sorted(os.listdir(APPS_DIR))
    # Process canonical directories before symlinks so primary app ID wins
    ordered_items = [i for i in raw_items if not os.path.islink(os.path.join(APPS_DIR, i))] + [
        i for i in raw_items if os.path.islink(os.path.join(APPS_DIR, i))
    ]

    seen_realpaths = set()
    entries = []
    for item in ordered_items:
        app_dir = os.path.join(APPS_DIR, item)
        if not os.path.isdir(app_dir):
            continue
        real_dir = os.path.realpath(app_dir)
        if real_dir in seen_realpaths:
            continue
        manifest_path = os.path.join(app_dir, "app.json")
        if os.path.exists(manifest_path):
            try:
                with open(manifest_path, "r", encoding="utf-8") as f:
                    meta = json.load(f)
                seen_realpaths.add(real_dir)
                icon = meta.get("icon", "⚡")
                name = meta.get("name", item)
                cat = meta.get("category", "General")
                ver = meta.get("version", "1.0.0")
                entries.append((item, f"{icon}  [{item}] {name} (v{ver}) — {cat}"))
            except Exception:
                pass

    entries.sort(key=lambda e: e[0])
    for _, line in entries:
        print(line)

    count = len(entries)
    if count == 0:
        print("No synthesized apps currently registered. Use 'flow-app create' to synthesize one.")
    else:
        print(f"\nTotal Synthesized Apps: {count}")
    return 0


def delete_app(raw_app_id):
    app_id = sanitize_app_id(raw_app_id)
    target_dir = os.path.join(APPS_DIR, app_id)
    launcher_path = os.path.join(BIN_DIR, app_id)
    desktop_filename = f"flowork-{app_id}.desktop"
    local_desktop = os.path.join(APPS_DIR, desktop_filename)
    sys_desktop = os.path.join(SYSTEM_APPLICATIONS, desktop_filename)

    if os.path.exists(target_dir):
        shutil.rmtree(target_dir)
        print(f"✓ Removed app directory: {target_dir}")

    if os.path.exists(launcher_path):
        os.remove(launcher_path)
        print(f"✓ Removed launcher binary: {launcher_path}")

    if os.path.exists(local_desktop):
        os.remove(local_desktop)

    if os.path.exists(sys_desktop) and os.access(sys_desktop, os.W_OK):
        os.remove(sys_desktop)

    print(f"✓ Application [{app_id}] purged cleanly.")
    return 0


def main():
    parser = argparse.ArgumentParser(description="Flowork Sovereign App-on-Demand Engine (flow-app)")
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # Create
    p_create = subparsers.add_parser("create", help="Synthesize a new sovereign flow application (*flow)")
    p_create.add_argument("app_id", help="Name or ID for the application (auto-suffixed with 'flow' if missing)")
    p_create.add_argument("--name", required=True, help="Display Name of the application")
    p_create.add_argument("--desc", default="", help="Description of the application")
    p_create.add_argument("--icon", default="⚡", help="Icon symbol or emoji")
    p_create.add_argument("--category", default="Utility", help="Desktop category")
    p_create.add_argument("--version", default="1.0.0", help="Version")
    p_create.add_argument("--force", action="store_true", help="Overwrite existing app directory")

    # Test
    p_test = subparsers.add_parser("test", help="Test application health and headless launch")
    p_test.add_argument("app_id", help="Application ID to test")

    # Register
    p_reg = subparsers.add_parser("register", help="Register application to system menu & desktop")
    p_reg.add_argument("app_id", help="Application ID to register")

    # Launch
    p_launch = subparsers.add_parser("launch", help="Launch application into workspace")
    p_launch.add_argument("app_id", help="Application ID to launch")

    # List
    subparsers.add_parser("list", help="List all synthesized applications")

    # Delete
    p_del = subparsers.add_parser("delete", help="Delete and purge a synthesized application")
    p_del.add_argument("app_id", help="Application ID to purge")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 0

    if args.command == "create":
        res = create_app(args.app_id, args.name, args.desc, args.icon, args.category, args.version, args.force)
        if res == 0:
            actual_id = sanitize_app_id(args.app_id)
            test_res = test_app(actual_id)
            if test_res == 0:
                register_app(actual_id)
                print(f"\n🎉 Flow App-on-Demand Complete: [{actual_id}] synthesized and registered with Exit Code 0!")
                print(f"👉 Launch immediately with: flow-app launch {actual_id}")
        return res
    elif args.command == "test":
        return test_app(args.app_id)
    elif args.command == "register":
        return register_app(args.app_id)
    elif args.command == "launch":
        return launch_app(args.app_id)
    elif args.command == "list":
        return list_apps()
    elif args.command == "delete":
        return delete_app(args.app_id)

    return 0


if __name__ == "__main__":
    sys.exit(main())
