#!/usr/bin/env python3
"""
👑 FLOWORK OS — SOVEREIGN SOUND FORGE CLI (flowork-sound-forge)
Command-line procedural audio synthesizer, soundscape player, and audio critic.
Powered by Earshot DSP engine. Includes Automated Video SFX Scoring.

Universal root: /opt/floworkos
Author: Flowork Architecture Board & Dr. Flow
"""

import sys
import os
import argparse
import json
import shutil
import subprocess
import tempfile

sys.path.insert(0, "/opt/floworkos/mcp/earshot")
from earshot_engine import CATALOG, render_sound, play_sound, audit_audio_file


def cmd_list():
    print("┌────────────────────────────────────────────────────────────────────────┐")
    print("│ 🎵 FLOWORK OS — SOVEREIGN PROCEDURAL SOUNDSCAPE RECIPES (EARSHOT CPU) │")
    print("├─────────────┬──────────────────────────────────────────────────────────┤")
    print("│ SOUND NAME  │ DESCRIPTION / AUDIO CHARACTERISTICS                      │")
    print("├─────────────┼──────────────────────────────────────────────────────────┤")
    for name, info in sorted(CATALOG.items()):
        print(f"│ {name:<11} │ {info['desc']:<56} │")
    print("└─────────────┴──────────────────────────────────────────────────────────┘")
    print(f"Total: {len(CATALOG)} mathematically synthesized procedural sound recipes on CPU (<10ms).")
    return 0


def cmd_play(name):
    print(f"▶️ Playing procedural sound: [{name}]...")
    ok = play_sound(name)
    if ok:
        print(f"✓ Played [{name}] via PipeWire/PulseAudio.")
        return 0
    else:
        print(f"⚠️ Audio playback daemon did not return success (running headless or audio sink busy).")
        return 0


def cmd_render(name, output_path=None, duration=None, pitch=None):
    kwargs = {}
    if duration is not None:
        kwargs["duration"] = duration
    if pitch is not None:
        kwargs["pitch"] = pitch

    try:
        out = render_sound(name, output_path=output_path, **kwargs)
        audit = audit_audio_file(out)
        print(f"✓ Rendered procedural sound [{name}] -> {out}")
        print(f"  Duration: {audit['duration_seconds']}s | Peak: {audit['peak_dbfs']} dBFS | Quality: {audit['status']}")
        return 0
    except Exception as e:
        print(f"❌ Render error: {e}", file=sys.stderr)
        return 1


def cmd_audit(file_path):
    audit = audit_audio_file(file_path)
    if "error" in audit:
        print(f"❌ Error: {audit['error']}", file=sys.stderr)
        return 1

    print("┌────────────────────────────────────────────────────────┐")
    print(f"│ 🔍 FLOWORK OS — ACOUSTIC WAVEFORM AUDIT: {os.path.basename(file_path):<13} │")
    print("├────────────────────────────────────────────────────────┤")
    print(f"│ Duration:      {audit['duration_seconds']} seconds{' ' * max(0, 32 - len(str(audit['duration_seconds'])))}│")
    print(f"│ Sample Rate:   {audit['sample_rate']} Hz{' ' * max(0, 35 - len(str(audit['sample_rate'])))}│")
    print(f"│ Peak dBFS:     {audit['peak_dbfs']} dBFS{' ' * max(0, 33 - len(str(audit['peak_dbfs'])))}│")
    print(f"│ RMS dBFS:      {audit['rms_dbfs']} dBFS{' ' * max(0, 34 - len(str(audit['rms_dbfs'])))}│")
    print(f"│ DC Offset:     {audit['dc_offset']}{' ' * max(0, 39 - len(str(audit['dc_offset'])))}│")
    print(f"│ Quality State: {audit['status'].upper()}{' ' * max(0, 35 - len(audit['status']))}│")
    print("└────────────────────────────────────────────────────────┘")
    return 0


def cmd_score(video_path, cues_str, output_video):
    """
    Automated Procedural Video SFX Scoring.
    cues_str format: "timestamp_sec:sound_name,timestamp_sec:sound_name,..."
    Example: "0.5:whoosh,2.0:thock,5.5:sub_hit,8.2:success"
    """
    if not os.path.isfile(video_path):
        print(f"❌ Error: Video file not found at {video_path}", file=sys.stderr)
        return 1

    ffmpeg_bin = shutil.which("ffmpeg")
    if not ffmpeg_bin:
        print("❌ Error: ffmpeg is not installed on system", file=sys.stderr)
        return 1

    # Parse cues
    cues = []
    for item in cues_str.split(","):
        parts = item.strip().split(":")
        if len(parts) == 2:
            try:
                t_sec = float(parts[0])
                s_name = parts[1].strip()
                if s_name in CATALOG:
                    cues.append((t_sec, s_name))
                else:
                    print(f"⚠️ Warning: Sound recipe '{s_name}' not found in catalog, skipping.", file=sys.stderr)
            except ValueError:
                pass

    if not cues:
        print("❌ Error: No valid sound cues parsed from string.", file=sys.stderr)
        return 1

    print(f"🎬 Scoring video [{os.path.basename(video_path)}] with {len(cues)} procedural SFX cues...")
    with tempfile.TemporaryDirectory(prefix="flowork_sfx_") as tmp_dir:
        inputs = ["-i", video_path]
        filter_parts = []

        for idx, (t_sec, s_name) in enumerate(cues):
            tmp_wav = os.path.join(tmp_dir, f"cue_{idx}.wav")
            render_sound(s_name, output_path=tmp_wav)
            inputs.extend(["-i", tmp_wav])

            delay_ms = int(t_sec * 1000)
            input_idx = idx + 1
            filter_parts.append(f"[{input_idx}:a]adelay={delay_ms}|{delay_ms}[sfx_{idx}]")

        sfx_labels = "".join(f"[sfx_{i}]" for i in range(len(cues)))
        total_sfx = len(cues)
        mix_filter = f"{';'.join(filter_parts)};{sfx_labels}amix=inputs={total_sfx}:normalize=0[sfx_master]"

        # Check if original video has audio stream
        probe_cmd = ["ffprobe", "-v", "error", "-select_streams", "a", "-show_entries", "stream=codec_type", "-of", "csv=p=0", video_path]
        has_orig_audio = bool(subprocess.run(probe_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True).stdout.strip())

        if has_orig_audio:
            mix_filter += f";[0:a][sfx_master]amix=inputs=2:duration=first:dropout_transition=2[aout]"
            audio_map = "[aout]"
        else:
            audio_map = "[sfx_master]"

        cmd = [ffmpeg_bin, "-y"] + inputs + [
            "-filter_complex", mix_filter,
            "-map", "0:v",
            "-map", audio_map,
            "-c:v", "copy",
            "-c:a", "aac",
            "-b:a", "192k",
            output_video
        ]

        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if res.returncode == 0:
            print(f"✓ Video successfully scored with procedural SFX: {output_video}")
            return 0
        else:
            print(f"❌ FFmpeg error (code {res.returncode}):\n{res.stderr}", file=sys.stderr)
            return res.returncode


def main():
    parser = argparse.ArgumentParser(
        description="Flowork Sovereign Sound Forge CLI (Powered by Earshot)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  flowork-sound-forge list
  flowork-sound-forge play thock
  flowork-sound-forge render sub_hit -o /opt/floworkos/sounds/sub_hit.wav
  flowork-sound-forge score input.mp4 --cues "0.5:whoosh,2.0:thock,4.5:sub_hit" -o scored.mp4
  flowork-sound-forge audit /opt/floworkos/sounds/sub_hit.wav
"""
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("list", help="List all available procedural sound effect recipes")

    p_play = sub.add_parser("play", help="Render and play sound effect through PipeWire")
    p_play.add_argument("name", help="Sound name (e.g. thock, sub_hit, riser, whoosh, glass_tap)")

    p_rend = sub.add_parser("render", help="Render procedural sound to .wav file")
    p_rend.add_argument("name", help="Sound name")
    p_rend.add_argument("-o", "--output", help="Target output .wav file path")
    p_rend.add_argument("-d", "--duration", type=float, help="Custom duration in seconds")
    p_rend.add_argument("-p", "--pitch", type=float, help="Custom frequency / pitch in Hz")

    p_aud = sub.add_parser("audit", help="Audit audio file for clipping and quality")
    p_aud.add_argument("file", help="Path to .wav file")

    p_score = sub.add_parser("score", help="Score video with timestamped procedural SFX cues")
    p_score.add_argument("video", help="Input video file path (.mp4)")
    p_score.add_argument("--cues", required=True, help="Timestamped cues: '0.5:whoosh,2.0:thock,4.5:sub_hit'")
    p_score.add_argument("-o", "--output", required=True, help="Output scored video file path")

    args = parser.parse_args()

    if not args.command:
        return cmd_list()

    if args.command == "list":
        return cmd_list()
    elif args.command == "play":
        return cmd_play(args.name)
    elif args.command == "render":
        return cmd_render(args.name, args.output, args.duration, args.pitch)
    elif args.command == "audit":
        return cmd_audit(args.file)
    elif args.command == "score":
        return cmd_score(args.video, args.cues, args.output)

    return 0


if __name__ == "__main__":
    sys.exit(main())
