# =============================================================================
# 🚀 Flowork Sovereign OS — Theme Studio & Personalization Manager
# Windows/macOS Unified Theme Standard — Zero Dull Gray / Zero Generic Hero Blue
# Pure Optical Crystal Glass HUD (GTK3 + Cairo + Picom Dual-Kawase Translucency)
# Full Live Orchestration: XFWM4 Frames, GTK 3/4 CSS, Muelle Dock, Wallpapers
# Co-authored-by: Flowork OS Architecture Board & Dr. Flow <agent@floworkos.com>
# =============================================================================

import os
import sys
import math
import time
import json
import signal
import subprocess
import threading
from pathlib import Path
from PIL import Image

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkPixbuf', '2.0')
gi.require_version('PangoCairo', '1.0')
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Pango, PangoCairo
import cairo

THEMES_CATALOG = "/opt/floworkos/theme/themes.json"
CURRENT_THEME = "/opt/floworkos/theme/current-theme.json"
THEME_ENGINE = "/opt/floworkos/bin/flowork-theme-engine"

CUSTOM_ACCENTS = [
    ("#00ff66", (0, 255, 102), "Matrix Emerald"),
    ("#00f2fe", (0, 242, 254), "Quantum Cyan"),
    ("#ff007f", (255, 0, 127), "Neon Plasma"),
    ("#ffb800", (255, 184, 0), "Solar Gold"),
    ("#b829ff", (184, 41, 255), "Cosmic Violet"),
    ("#00ffcc", (0, 255, 204), "Hyper Aqua"),
    ("#ff2d55", (255, 45, 85), "Electric Crimson"),
    ("#39ff14", (57, 255, 20), "Laser Lime")
]

def load_themes():
    if os.path.exists(THEMES_CATALOG):
        try:
            with open(THEMES_CATALOG, "r", encoding="utf-8") as f:
                return json.load(f).get("themes", [])
        except Exception:
            pass
    return []

def get_current_theme_id():
    if os.path.exists(CURRENT_THEME):
        try:
            with open(CURRENT_THEME, "r", encoding="utf-8") as f:
                data = json.load(f)
                return data.get("id", data.get("theme_id", "matrix-razor"))
        except Exception:
            pass
    return "matrix-razor"

class FloworkThemeStudio(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Flowork Theme Studio — Personalization")
        self.set_role("flowork-theme-studio")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_default_size(1040, 700)
        self.set_decorated(False)
        self.set_app_paintable(True)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.themes = load_themes()
        self.active_id = get_current_theme_id()
        self.selected_theme = self.get_theme_by_id(self.active_id)
        if not self.selected_theme and self.themes:
            self.selected_theme = self.themes[0]
            self.active_id = self.selected_theme.get("id")

        self.status_msg = "Ready. Select a theme pack to transform the operating system."
        self.is_applying = False
        self.dragging = False
        self.drag_start_x = 0
        self.drag_start_y = 0

        # Thumbnail cache
        self.thumbnails = {}
        self.load_thumbnails()

        # Connect events
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_button_press)
        self.connect("button-release-event", self.on_button_release)
        self.connect("motion-notify-event", self.on_motion_notify)
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.POINTER_MOTION_MASK
        )

        GLib.timeout_add_seconds(2, self.poll_system_theme)

    def get_theme_by_id(self, theme_id):
        for t in self.themes:
            if t.get("id") == theme_id:
                return t
        return self.themes[0] if self.themes else None

    def load_thumbnails(self):
        for t in self.themes:
            tid = t.get("id")
            w_path = t.get("wallpaper")
            if w_path and os.path.exists(w_path):
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(w_path, 170, 95, False)
                    self.thumbnails[tid] = pb
                except Exception:
                    self.thumbnails[tid] = None

    def poll_system_theme(self):
        cur = get_current_theme_id()
        if cur != self.active_id:
            self.active_id = cur
            self.queue_draw()
        return True

    def apply_theme_async(self, theme_id):
        if self.is_applying:
            return
        self.is_applying = True
        self.status_msg = f"Applying '{theme_id}' across XFWM4, GTK 3/4, Dock, Wallpaper..."
        self.queue_draw()

        def worker():
            try:
                res = subprocess.run([THEME_ENGINE, "set", theme_id], capture_output=True, text=True, timeout=15)
                time.sleep(0.1)
                GLib.idle_add(lambda: self.on_apply_done(theme_id, res.returncode == 0))
            except Exception as e:
                GLib.idle_add(lambda: self.on_apply_done(theme_id, False))

        threading.Thread(target=worker, daemon=True).start()

    def on_apply_done(self, theme_id, success):
        self.is_applying = False
        if success:
            self.active_id = theme_id
            self.selected_theme = self.get_theme_by_id(theme_id)
            self.status_msg = f"✅ Theme '{self.selected_theme.get('name')}' successfully activated!"
        else:
            self.status_msg = f"❌ Error applying theme '{theme_id}'."
        self.queue_draw()

    def on_button_press(self, widget, event):
        if event.button == 1:
            x, y = event.x, event.y
            w, h = self.get_size()

            # 1. Close button (top right: x in [w - 38, w - 14], y in [14, 38])
            if (w - 38) <= x <= (w - 14) and 14 <= y <= 38:
                Gtk.main_quit()
                return True

            # 2. Theme Cards Click (y in [180, 460])
            # Grid of 5 themes in two rows or horizontal cards
            card_y = 190.0
            card_w = 186.0
            card_h = 190.0
            card_spacing = 14.0
            start_x = 28.0

            for i, t in enumerate(self.themes):
                cx = start_x + (i % 5) * (card_w + card_spacing)
                cy = card_y + (i // 5) * (card_h + card_spacing)
                if cx <= x <= (cx + card_w) and cy <= y <= (cy + card_h):
                    self.selected_theme = t
                    self.apply_theme_async(t.get("id"))
                    return True

            # 3. Accent Customizer Swatches (y in [435, 475])
            swatch_y = 445.0
            swatch_r = 14.0
            swatch_spacing = 38.0
            swatch_start_x = 28.0 + 14.0

            for i, (hex_code, rgb, label) in enumerate(CUSTOM_ACCENTS):
                sx = swatch_start_x + i * swatch_spacing
                dist = math.hypot(x - sx, y - swatch_y)
                if dist <= swatch_r + 4.0:
                    # Apply accent to active theme
                    self.status_msg = f"Customizing accent to {label} ({hex_code})..."
                    self.selected_theme["accent_color"] = hex_code
                    self.selected_theme["accent_rgb"] = list(rgb)
                    self.apply_theme_async(self.active_id)
                    return True

            # 4. Bottom Action Buttons (y in [h - 58, h - 18])
            # Button: Apply Now
            b_apply_x = w - 210.0
            b_apply_y = h - 54.0
            if b_apply_x <= x <= (b_apply_x + 180.0) and b_apply_y <= y <= (b_apply_y + 36.0):
                if self.selected_theme:
                    self.apply_theme_async(self.selected_theme.get("id"))
                return True

            # Button: Reset Sovereign Core
            b_reset_x = w - 410.0
            b_reset_y = h - 54.0
            if b_reset_x <= x <= (b_reset_x + 180.0) and b_reset_y <= y <= (b_reset_y + 36.0):
                self.apply_theme_async("matrix-razor")
                return True

            # Drag window header
            if y <= 60.0:
                self.dragging = True
                cur_x, cur_y = self.get_position()
                self.drag_start_x = int(event.x_root) - cur_x
                self.drag_start_y = int(event.y_root) - cur_y
                return True

        return False

    def on_button_release(self, widget, event):
        if event.button == 1:
            self.dragging = False
            return True
        return False

    def on_motion_notify(self, widget, event):
        if self.dragging:
            new_x = int(event.x_root) - self.drag_start_x
            new_y = int(event.y_root) - self.drag_start_y
            self.move(new_x, new_y)
            return True
        return False

    def on_draw(self, widget, cr):
        w, h = float(self.get_size()[0]), float(self.get_size()[1])
        radius = 28.0

        cur_accent_hex = self.selected_theme.get("accent_color", "#00ff66")
        rgb = self.selected_theme.get("accent_rgb", [0, 255, 102])
        p_r, p_g, p_b = rgb[0] / 255.0, rgb[1] / 255.0, rgb[2] / 255.0
        sec_rgb = self.selected_theme.get("secondary_rgb", [0, 242, 254])
        s_r, s_g, s_b = sec_rgb[0] / 255.0, sec_rgb[1] / 255.0, sec_rgb[2] / 255.0

        # Clear
        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # 1. Main Obsidian Glass Body
        self.draw_rounded_rect(cr, 0, 0, w, h, radius)
        cr.set_source_rgba(0.012, 0.024, 0.045, 0.78)
        cr.fill_preserve()

        # Ambient Glow
        glow_grad = cairo.LinearGradient(0, 0, 0, h)
        glow_grad.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.16)
        glow_grad.add_color_stop_rgba(0.3, p_r, p_g, p_b, 0.06)
        glow_grad.add_color_stop_rgba(1.0, 0.0, 0.0, 0.0, 0.40)
        cr.set_source(glow_grad)
        cr.fill_preserve()

        # Specular Rim
        rim_grad = cairo.LinearGradient(0, 0, 0, h)
        rim_grad.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.85)
        rim_grad.add_color_stop_rgba(0.5, p_r, p_g, p_b, 0.40)
        rim_grad.add_color_stop_rgba(1.0, p_r, p_g, p_b, 0.65)
        cr.set_source(rim_grad)
        cr.set_line_width(1.5)
        cr.stroke()

        # 2. Window Header
        layout = PangoCairo.create_layout(cr)
        layout.set_text("💎 FLOWORK THEME STUDIO", -1)
        layout.set_font_description(Pango.FontDescription("Inter ExtraBold 13"))
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.98)
        cr.move_to(28.0, 22.0)
        PangoCairo.show_layout(cr, layout)

        layout.set_text("Windows-Grade Unified Theme Standard • Zero Dull Gray • Pure Optical Crystal Glass", -1)
        layout.set_font_description(Pango.FontDescription("Inter Medium 9"))
        cr.set_source_rgba(s_r, s_g, s_b, 0.85)
        cr.move_to(28.0, 44.0)
        PangoCairo.show_layout(cr, layout)

        # Active Theme Pill in Header
        pill_w = 230.0
        pill_h = 30.0
        pill_x = w - 280.0
        pill_y = 20.0
        self.draw_rounded_rect(cr, pill_x, pill_y, pill_w, pill_h, 15.0)
        cr.set_source_rgba(p_r, p_g, p_b, 0.16)
        cr.fill_preserve()
        cr.set_source_rgba(p_r, p_g, p_b, 0.60)
        cr.set_line_width(1.2)
        cr.stroke()

        # Dot in pill
        cr.arc(pill_x + 16.0, pill_y + 15.0, 5.0, 0, 2 * math.pi)
        cr.set_source_rgba(p_r, p_g, p_b, 1.0)
        cr.fill()

        active_theme_name = self.selected_theme.get("name", "Matrix Razor")
        layout.set_text(f"Active: {active_theme_name[:18]}", -1)
        layout.set_font_description(Pango.FontDescription("Inter Bold 8.5"))
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.95)
        cr.move_to(pill_x + 28.0, pill_y + 8.0)
        PangoCairo.show_layout(cr, layout)

        # Close button [✕]
        cr.arc(w - 26.0, 32.0, 11.0, 0, 2 * math.pi)
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.12)
        cr.fill_preserve()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.35)
        cr.set_line_width(1.0)
        cr.stroke()
        cr.move_to(w - 30.0, 25.0)
        layout.set_text("✕", -1)
        layout.set_font_description(Pango.FontDescription("Ubuntu Bold 9"))
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.90)
        PangoCairo.show_layout(cr, layout)

        # Divider below header
        cr.set_line_width(0.8)
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.12)
        cr.move_to(28.0, 72.0)
        cr.line_to(w - 28.0, 72.0)
        cr.stroke()

        # 3. Live Desktop Mini-Simulation Stage (Hero Preview)
        stage_x, stage_y, stage_w, stage_h = 28.0, 84.0, w - 56.0, 85.0
        self.draw_rounded_rect(cr, stage_x, stage_y, stage_w, stage_h, 14.0)
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.35)
        cr.fill_preserve()
        cr.set_source_rgba(p_r, p_g, p_b, 0.35)
        cr.set_line_width(1.0)
        cr.stroke()

        # Mini Simulated Window
        mw_x, mw_y, mw_w, mw_h = stage_x + 20.0, stage_y + 12.0, 230.0, 60.0
        self.draw_rounded_rect(cr, mw_x, mw_y, mw_w, mw_h, 10.0)
        cr.set_source_rgba(0.02, 0.04, 0.08, 0.85)
        cr.fill_preserve()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.40)
        cr.set_line_width(1.0)
        cr.stroke()

        # Mini Titlebar
        cr.rectangle(mw_x, mw_y, mw_w, 18.0)
        cr.set_source_rgba(0.08, 0.12, 0.16, 0.95)
        cr.fill()
        # Titlebar accent divider hairline
        cr.move_to(mw_x, mw_y + 18.0)
        cr.line_to(mw_x + mw_w, mw_y + 18.0)
        cr.set_source_rgba(p_r, p_g, p_b, 0.95)
        cr.set_line_width(1.2)
        cr.stroke()

        # Window Controls (Red, Accent, Orange)
        cr.arc(mw_x + 10.0, mw_y + 9.0, 3.5, 0, 2 * math.pi)
        cr.set_source_rgba(1.0, 0.25, 0.25, 1.0)
        cr.fill()
        cr.arc(mw_x + 20.0, mw_y + 9.0, 3.5, 0, 2 * math.pi)
        cr.set_source_rgba(p_r, p_g, p_b, 1.0)
        cr.fill()
        cr.arc(mw_x + 30.0, mw_y + 9.0, 3.5, 0, 2 * math.pi)
        cr.set_source_rgba(1.0, 0.75, 0.0, 1.0)
        cr.fill()

        layout.set_text("Flowork Active Window", -1)
        layout.set_font_description(Pango.FontDescription("Ubuntu Bold 7"))
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.85)
        cr.move_to(mw_x + 46.0, mw_y + 3.5)
        PangoCairo.show_layout(cr, layout)

        # Inside mini window: active sample button
        mb_x, mb_y, mb_w, mb_h = mw_x + 12.0, mw_y + 26.0, 95.0, 24.0
        self.draw_rounded_rect(cr, mb_x, mb_y, mb_w, mb_h, 6.0)
        cr.set_source_rgba(p_r, p_g, p_b, 0.25)
        cr.fill_preserve()
        cr.set_source_rgba(p_r, p_g, p_b, 0.95)
        cr.set_line_width(1.0)
        cr.stroke()
        layout.set_text("⚡ Accent Button", -1)
        layout.set_font_description(Pango.FontDescription("Ubuntu Bold 7"))
        cr.set_source_rgba(p_r, p_g, p_b, 1.0)
        cr.move_to(mb_x + 10.0, mb_y + 6.0)
        PangoCairo.show_layout(cr, layout)

        # Mini toggle switch
        msw_x, msw_y = mw_x + 125.0, mw_y + 28.0
        self.draw_rounded_rect(cr, msw_x, msw_y, 40.0, 20.0, 10.0)
        cr.set_source_rgba(p_r, p_g, p_b, 0.90)
        cr.fill()
        cr.arc(msw_x + 30.0, msw_y + 10.0, 7.5, 0, 2 * math.pi)
        cr.set_source_rgba(1.0, 1.0, 1.0, 1.0)
        cr.fill()

        # Mini Simulated Dock on the right side of stage
        md_w = 260.0
        md_h = 44.0
        md_x = stage_x + stage_w - md_w - 30.0
        md_y = stage_y + (stage_h - md_h) / 2.0
        self.draw_rounded_rect(cr, md_x, md_y, md_w, md_h, 16.0)
        cr.set_source_rgba(0.04, 0.06, 0.10, 0.82)
        cr.fill_preserve()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.40)
        cr.set_line_width(1.0)
        cr.stroke()

        # Mini dock icons & indicator dots
        for idx in range(5):
            ix = md_x + 24.0 + idx * 48.0
            iy = md_y + 20.0
            cr.arc(ix, iy, 12.0, 0, 2 * math.pi)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.18)
            cr.fill()
            if idx in (0, 1, 3):
                # Running indicator dot with active accent
                cr.arc(ix, md_y + md_h - 5.0, 2.5, 0, 2 * math.pi)
                cr.set_source_rgba(p_r, p_g, p_b, 1.0)
                cr.fill()

        # 4. Themes Collection Grid Header
        layout.set_text("SELECT SYSTEM THEME PACK (WINDOWS-GRADE UNIFIED THEME)", -1)
        layout.set_font_description(Pango.FontDescription("Inter Bold 9.5"))
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.95)
        cr.move_to(28.0, 182.0)
        PangoCairo.show_layout(cr, layout)

        # Draw 5 Theme Cards
        card_y = 205.0
        card_w = 186.0
        card_h = 200.0
        card_spacing = 14.0
        start_x = 28.0

        for i, t in enumerate(self.themes):
            tid = t.get("id")
            cx = start_x + (i % 5) * (card_w + card_spacing)
            cy = card_y + (i // 5) * (card_h + card_spacing)

            is_active = (tid == self.active_id)
            is_selected = (self.selected_theme and self.selected_theme.get("id") == tid)
            t_rgb = t.get("accent_rgb", [0, 255, 102])
            tr_r, tr_g, tr_b = t_rgb[0] / 255.0, t_rgb[1] / 255.0, t_rgb[2] / 255.0

            # Card background
            self.draw_rounded_rect(cr, cx, cy, card_w, card_h, 16.0)
            if is_active:
                cr.set_source_rgba(tr_r, tr_g, tr_b, 0.12)
            else:
                cr.set_source_rgba(0.04, 0.06, 0.10, 0.60)
            cr.fill_preserve()

            # Border
            if is_active:
                cr.set_source_rgba(tr_r, tr_g, tr_b, 0.95)
                cr.set_line_width(2.0)
            elif is_selected:
                cr.set_source_rgba(1.0, 1.0, 1.0, 0.60)
                cr.set_line_width(1.5)
            else:
                cr.set_source_rgba(1.0, 1.0, 1.0, 0.16)
                cr.set_line_width(1.0)
            cr.stroke()

            # Wallpaper Thumbnail
            pb = self.thumbnails.get(tid)
            thumb_x, thumb_y = cx + 8.0, cy + 8.0
            thumb_w, thumb_h = card_w - 16.0, 92.0

            cr.save()
            self.draw_rounded_rect(cr, thumb_x, thumb_y, thumb_w, thumb_h, 10.0)
            cr.clip()
            if pb:
                Gdk.cairo_set_source_pixbuf(cr, pb, thumb_x, thumb_y)
                cr.paint()
            else:
                cr.set_source_rgba(tr_r, tr_g, tr_b, 0.25)
                cr.paint()
            cr.restore()

            # Accent Color Swatch Pill on thumbnail
            self.draw_rounded_rect(cr, cx + 14.0, cy + 82.0, 50.0, 14.0, 7.0)
            cr.set_source_rgba(tr_r, tr_g, tr_b, 1.0)
            cr.fill()

            # Active Badge
            if is_active:
                self.draw_rounded_rect(cr, cx + card_w - 65.0, cy + 12.0, 52.0, 18.0, 9.0)
                cr.set_source_rgba(tr_r, tr_g, tr_b, 0.95)
                cr.fill()
                layout.set_text("ACTIVE", -1)
                layout.set_font_description(Pango.FontDescription("Ubuntu Bold 7"))
                cr.set_source_rgba(0.0, 0.0, 0.0, 1.0)
                cr.move_to(cx + card_w - 58.0, cy + 15.0)
                PangoCairo.show_layout(cr, layout)

            # Theme Name
            t_name = t.get("name", "Theme")
            layout.set_text(t_name, -1)
            layout.set_font_description(Pango.FontDescription("Ubuntu Bold 8.5"))
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.98)
            cr.move_to(cx + 10.0, cy + 108.0)
            PangoCairo.show_layout(cr, layout)

            # Accent Hex
            layout.set_text(f"Accent: {t.get('accent_color')}", -1)
            layout.set_font_description(Pango.FontDescription("Ubuntu Medium 7.5"))
            cr.set_source_rgba(tr_r, tr_g, tr_b, 0.90)
            cr.move_to(cx + 10.0, cy + 126.0)
            PangoCairo.show_layout(cr, layout)

            # Description (truncated)
            desc = t.get("description", "")
            if len(desc) > 52:
                desc = desc[:50] + "..."
            layout.set_text(desc, -1)
            layout.set_font_description(Pango.FontDescription("Ubuntu 7"))
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.60)
            cr.move_to(cx + 10.0, cy + 144.0)
            PangoCairo.show_layout(cr, layout)

        # 5. Live Accent Swatches Section
        layout.set_text("CUSTOMIZE ACCENT COLOR (APPLIES ACROSS XFWM4, GTK & DOCK)", -1)
        layout.set_font_description(Pango.FontDescription("Inter Bold 9.5"))
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.95)
        cr.move_to(28.0, 420.0)
        PangoCairo.show_layout(cr, layout)

        swatch_y = 450.0
        swatch_r = 13.0
        swatch_spacing = 38.0
        swatch_start_x = 28.0 + 14.0

        for i, (hex_code, s_rgb, label) in enumerate(CUSTOM_ACCENTS):
            sx = swatch_start_x + i * swatch_spacing
            sr_r, sr_g, sr_b = s_rgb[0] / 255.0, s_rgb[1] / 255.0, s_rgb[2] / 255.0

            is_sel_swatch = (hex_code.lower() == cur_accent_hex.lower())

            cr.arc(sx, swatch_y, swatch_r, 0, 2 * math.pi)
            cr.set_source_rgba(sr_r, sr_g, sr_b, 1.0)
            cr.fill_preserve()

            if is_sel_swatch:
                cr.set_source_rgba(1.0, 1.0, 1.0, 0.95)
                cr.set_line_width(2.5)
            else:
                cr.set_source_rgba(1.0, 1.0, 1.0, 0.35)
                cr.set_line_width(1.0)
            cr.stroke()

        # 6. Bottom Status & Action Bar
        cr.set_line_width(0.8)
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.12)
        cr.move_to(28.0, h - 70.0)
        cr.line_to(w - 28.0, h - 70.0)
        cr.stroke()

        # Telemetry / Status text
        layout.set_text(self.status_msg, -1)
        layout.set_font_description(Pango.FontDescription("Ubuntu Medium 8.5"))
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.85)
        cr.move_to(28.0, h - 45.0)
        PangoCairo.show_layout(cr, layout)

        # Button: Reset Sovereign Core
        b_reset_x = w - 400.0
        b_reset_y = h - 54.0
        self.draw_rounded_rect(cr, b_reset_x, b_reset_y, 170.0, 34.0, 10.0)
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.10)
        cr.fill_preserve()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.35)
        cr.set_line_width(1.0)
        cr.stroke()
        layout.set_text("↺ Reset to Sovereign Core", -1)
        layout.set_font_description(Pango.FontDescription("Ubuntu Bold 8.5"))
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.90)
        cr.move_to(b_reset_x + 16.0, b_reset_y + 9.0)
        PangoCairo.show_layout(cr, layout)

        # Button: Apply to Entire OS
        b_apply_x = w - 210.0
        b_apply_y = h - 54.0
        self.draw_rounded_rect(cr, b_apply_x, b_apply_y, 180.0, 34.0, 10.0)
        cr.set_source_rgba(p_r, p_g, p_b, 0.25)
        cr.fill_preserve()
        cr.set_source_rgba(p_r, p_g, p_b, 0.95)
        cr.set_line_width(1.4)
        cr.stroke()
        layout.set_text("⚡ Apply to Entire OS", -1)
        layout.set_font_description(Pango.FontDescription("Ubuntu Bold 8.5"))
        cr.set_source_rgba(p_r, p_g, p_b, 1.0)
        cr.move_to(b_apply_x + 24.0, b_apply_y + 9.0)
        PangoCairo.show_layout(cr, layout)

    def draw_rounded_rect(self, cr, x, y, width, height, radius):
        cr.new_sub_path()
        cr.arc(x + width - radius, y + radius, radius, -math.pi / 2, 0)
        cr.arc(x + width - radius, y + height - radius, radius, 0, math.pi / 2)
        cr.arc(x + radius, y + height - radius, radius, math.pi / 2, math.pi)
        cr.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
        cr.close_path()

def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    app = FloworkThemeStudio()
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
