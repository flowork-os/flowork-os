#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — Audacity OpenVINO AI (Native Portable Engine)
# ==============================================================================

set -e

EXEC_PATH="/opt/floworkos/apps/audacity/runtime/AppRun"

if [ ! -x "$EXEC_PATH" ]; then
    if [ -x "/opt/floworkos/bin/flowork-on-demand" ]; then
        /opt/floworkos/bin/flowork-on-demand audacity "Audacity Studio" "/opt/floworkos/icons/audacity.png"
    else
        echo "Error: Audacity executable not found at $EXEC_PATH" >&2
        exit 1
    fi
fi

if [ -x "$EXEC_PATH" ]; then
    exec "$EXEC_PATH" "$@"
fi
