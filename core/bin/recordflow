#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — SOVEREIGN SMART APPLICATION RUNNER: Recordly Flow
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"

if [ "$1" = "--foreground" ] || [ "$1" = "-f" ]; then
    shift
    exec python3 "/opt/floworkos/apps/recordflow/bin/app.py" --app-dir "/opt/floworkos/apps/recordflow" --title "Recordly Flow" "$@"
else
    # Detached execution: instant fallback without hanging caller
    nohup python3 "/opt/floworkos/apps/recordflow/bin/app.py" --app-dir "/opt/floworkos/apps/recordflow" --title "Recordly Flow" "$@" >/dev/null 2>&1 &
fi
