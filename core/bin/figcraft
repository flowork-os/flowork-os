#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — SMART APPLICATION RUNNER: figcraft
# ==============================================================================
APP_NAME="figcraft"
REPO="storytold/figcraft"
APP_DIR="/opt/floworkos/apps/figcraft"
BIN_PATH="/opt/floworkos/apps/figcraft/bin/figcraft"

# If binary is not installed yet on this PC (e.g. fresh OTA sync), auto-provision from release
if [ ! -x "$BIN_PATH" ]; then
    echo "⚡ Initializing figcraft for Flowork OS..."
    which notify-send >/dev/null 2>&1 && notify-send -i "/opt/floworkos/icons/figcraft.png" "👑 Flowork OS" "Installing figcraft on first launch... Please wait."
    
    TMP_WORK="$(mktemp -d)"
    trap 'rm -rf "$TMP_WORK"' EXIT
    
    DOWNLOAD_URL=$(python3 -c "
import urllib.request, json, ssl
ctx = ssl.create_default_context()
req = urllib.request.Request('https://api.github.com/repos/storytold/figcraft/releases/latest', headers={'User-Agent': 'FloworkOS'})
try:
    with urllib.request.urlopen(req, context=ctx, timeout=15) as r:
        data = json.loads(r.read().decode())
        assets = data.get('assets', [])
        tar_url = next((a['browser_download_url'] for a in assets if 'linux-x86_64.tar.gz' in a['name']), '')
        print(tar_url)
except Exception:
    pass
")

    if [ -n "$DOWNLOAD_URL" ]; then
        curl -fsSL "$DOWNLOAD_URL" -o "$TMP_WORK/package.tar.gz"
        mkdir -p "$TMP_WORK/extracted"
        tar -xzf "$TMP_WORK/package.tar.gz" --no-same-owner --no-same-permissions -C "$TMP_WORK/extracted"
        
        INNER=$(find "$TMP_WORK/extracted" -maxdepth 1 -mindepth 1 -type d | head -n 1)
        if [ -d "$INNER" ]; then
            mkdir -p "$APP_DIR"
            cp -rf "$INNER"/* "$APP_DIR/"
        fi
        rm -rf "$TMP_WORK"
        trap - EXIT
        chmod +x "$BIN_PATH" 2>/dev/null || true
    fi
fi

# Detached execution
if [ -x "$BIN_PATH" ]; then
    nohup "$BIN_PATH" "$@" >/dev/null 2>&1 &
fi
