def scan_all_skills():
    """Dynamically scan /opt/floworkos/skills and merge with built-in slash commands."""
    commands = list(BUILTIN_SLASH_COMMANDS)
    if not os.path.isdir(SKILLS_DIR):
        return commands
    try:
        entries = sorted(os.listdir(SKILLS_DIR))
    except Exception:
        return commands

    for entry in entries:
        skill_path = os.path.join(SKILLS_DIR, entry)
        if not os.path.isdir(skill_path):
            continue
        skill_md = os.path.join(skill_path, "SKILL.md")
        if not os.path.isfile(skill_md):
            continue
        name = entry
        description = "Sovereign Capability Package"
        domain = "general"
        keywords = []
        slash_cmd = None
        args_hint = ""
        try:
            with open(skill_md, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read(4096)
            if content.startswith("---"):
                parts = content.split("---", 2)
                if len(parts) >= 3:
                    fm = parts[1]
                    in_keywords = False
                    for line in fm.splitlines():
                        s = line.strip()
                        if s.startswith("keywords:"):
                            in_keywords = True
                            continue
                        elif in_keywords and s.startswith("-"):
                            keywords.append(s.lstrip("- ").strip())
                            continue
                        elif in_keywords and not s.startswith("-"):
                            in_keywords = False

                        if s.startswith("name:"):
                            name = s.split("name:", 1)[1].strip().strip("'\"")
                        elif s.startswith("description:"):
                            description = s.split("description:", 1)[1].strip().strip("'\"")
                        elif s.startswith("domain:"):
                            domain = s.split("domain:", 1)[1].strip().strip("'\"")
                        elif s.startswith("slash_command:"):
                            slash_cmd = s.split("slash_command:", 1)[1].strip().strip("'\"").lstrip("/")
                        elif s.startswith("args_hint:"):
                            args_hint = s.split("args_hint:", 1)[1].strip().strip("'\"")
        except Exception:
            pass

        cmd_name = slash_cmd or name
        # Avoid duplicate command entries
        if not any(c["command"].lower() == cmd_name.lower() for c in commands):
            commands.append({
                "command": cmd_name,
                "skill": name,
                "description": description,
                "domain": domain,
                "keywords": keywords[:6],
                "args_hint": args_hint
            })
    return commands


class SlashCommandsPopover(Gtk.Window):
    """Floating Pure Optical Crystal Glass popover window for live Slash Command autocomplete."""

    def __init__(self, conduit_parent):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.conduit = conduit_parent
        self.set_title("Slash Commands")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_app_paintable(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.width = 560
        self.height = 310
        self.set_default_size(self.width, self.height)

        self.filtered_commands = []
        self.active_index = 0

        # Main Layout
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.box.set_margin_start(10)
        self.box.set_margin_end(10)
        self.box.set_margin_top(8)
        self.box.set_margin_bottom(8)
        self.add(self.box)

        # Header Info Bar
        self.header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.lbl_header_title = Gtk.Label()
        self.lbl_header_title.set_markup("<span size='small' weight='bold' color='#00ff66'>⚡ SOVEREIGN SKILLS &amp; SLASH COMMANDS</span>")
        self.header_box.pack_start(self.lbl_header_title, False, False, 4)

        self.lbl_header_count = Gtk.Label()
        self.lbl_header_count.set_markup("<span size='small' color='#94a3b8'>0 ACTIVE</span>")
        self.header_box.pack_end(self.lbl_header_count, False, False, 4)
        self.box.pack_start(self.header_box, False, False, 4)

        # Scrolled list
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_hexpand(True)
        self.scrolled.set_vexpand(True)
        self.box.pack_start(self.scrolled, True, True, 2)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.set_activate_on_single_click(True)
        self.listbox.connect("row-activated", self.on_row_activated)
        self.scrolled.add(self.listbox)

        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        w, h = float(self.width), float(self.height)
        radius = 18.0
        ar, ag, ab = self.conduit.accent_rgb
        sr, sg, sb = self.conduit.sec_rgb

        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # Background Optical Glass Pill
        self.conduit.draw_rounded_pill(cr, 0, 0, w, h, radius)
        cr.set_source_rgba(0.012, 0.024, 0.038, 0.94)
        cr.fill_preserve()

        # Accent Ambient Glow
        glow = cairo.LinearGradient(0, 0, w, h)
        glow.add_color_stop_rgba(0.0, ar, ag, ab, 0.12)
        glow.add_color_stop_rgba(0.5, sr, sg, sb, 0.06)
        glow.add_color_stop_rgba(1.0, 0.0, 0.0, 0.0, 0.40)
        cr.set_source(glow)
        cr.fill_preserve()

        # Razor Specular Rim
        rim = cairo.LinearGradient(0, 0, 0, h)
        rim.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.80)
        rim.add_color_stop_rgba(0.4, ar, ag, ab, 0.45)
        rim.add_color_stop_rgba(1.0, ar, ag, ab, 0.85)
        cr.set_source(rim)
        cr.set_line_width(1.4)
        cr.stroke()

        return False

    def update_filter(self, query):
        clean_q = query.lstrip("/").strip().lower()
        all_skills = self.conduit.skills_cache
        if not clean_q:
            self.filtered_commands = all_skills
        else:
            self.filtered_commands = [
                c for c in all_skills
                if clean_q in c["command"].lower()
                or clean_q in c["skill"].lower()
                or clean_q in c.get("domain", "").lower()
                or clean_q in c.get("description", "").lower()
                or any(clean_q in kw.lower() for kw in c.get("keywords", []))
            ]

        self.lbl_header_count.set_markup(f"<span size='small' color='#94a3b8'>{len(self.filtered_commands)} ACTIVE</span>")

        # Clear existing list items
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        if not self.filtered_commands:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label()
            lbl.set_markup(f"<span size='small' color='#64748b' style='italic'>No skills match \"/{clean_q}\"</span>")
            lbl.set_padding(12, 12)
            row.add(lbl)
            self.listbox.add(row)
            self.listbox.show_all()
            return

        for idx, cmd in enumerate(self.filtered_commands):
            row = Gtk.ListBoxRow()
            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row_box.set_margin_start(8)
            row_box.set_margin_end(8)
            row_box.set_margin_top(5)
            row_box.set_margin_bottom(5)

            # Badge pill
            lbl_cmd = Gtk.Label()
            lbl_cmd.set_markup(f"<span weight='bold' color='#00ff66'>/{cmd['command']}</span>")
            lbl_cmd.set_width_chars(16)
            lbl_cmd.set_xalign(0.0)
            row_box.pack_start(lbl_cmd, False, False, 0)

            # Domain badge
            dom_text = cmd.get("domain", "general").upper()
            lbl_dom = Gtk.Label()
            lbl_dom.set_markup(f"<span size='xx-small' weight='bold' color='#00f2fe'>[{dom_text}]</span>")
            row_box.pack_start(lbl_dom, False, False, 0)

            # Description
            desc = cmd.get("description", "")
            if len(desc) > 50:
                desc = desc[:48] + "..."
            lbl_desc = Gtk.Label()
            lbl_desc.set_markup(f"<span size='small' color='#cbd5e1'>{GLib.markup_escape_text(desc)}</span>")
            lbl_desc.set_xalign(0.0)
            lbl_desc.set_hexpand(True)
            row_box.pack_start(lbl_desc, True, True, 0)

            row.add(row_box)
            row.connect("button-press-event", lambda w, ev, c=cmd["command"]: self.on_row_clicked(c))
            self.listbox.add(row)

        self.listbox.show_all()
        self.active_index = 0
        self.highlight_active_row()

    def highlight_active_row(self):
        children = self.listbox.get_children()
        if 0 <= self.active_index < len(children):
            self.listbox.select_row(children[self.active_index])
            # Scroll to make visible
            adj = self.scrolled.get_vadjustment()
            if adj:
                row = children[self.active_index]
                alloc = row.get_allocation()
                adj.clamp_page(alloc.y, alloc.y + alloc.height)

    def select_next(self):
        count = len(self.filtered_commands)
        if count > 0:
            self.active_index = (self.active_index + 1) % count
            self.highlight_active_row()

    def select_prev(self):
        count = len(self.filtered_commands)
        if count > 0:
            self.active_index = (self.active_index - 1 + count) % count
            self.highlight_active_row()

    def activate_current(self):
        if 0 <= self.active_index < len(self.filtered_commands):
            cmd = self.filtered_commands[self.active_index]
            self.conduit.apply_slash_command(cmd["command"])
            self.hide()

    def on_row_clicked(self, cmd_name):
        self.conduit.apply_slash_command(cmd_name)
        self.hide()
        return True

    def on_row_activated(self, listbox, row):
        idx = row.get_index()
        if 0 <= idx < len(self.filtered_commands):
            cmd = self.filtered_commands[idx]
            self.conduit.apply_slash_command(cmd["command"])
            self.hide()


class FloworkNeuralConduit(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Flowork Neural Conduit")
        self.set_role("flowork-neural-conduit")

        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.stick()
        self.set_app_paintable(True)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.screen_w = screen.get_width()
        self.screen_h = screen.get_height()

        self.bar_w = 980
        self.bar_h = 56
        self.pos_x = (self.screen_w - self.bar_w) // 2
        self.pos_y = self.screen_h - self.bar_h - 18

        self.set_default_size(self.bar_w, self.bar_h)
        self.move(self.pos_x, self.pos_y)

        # State
        self.is_voice_active = os.path.exists(VOICE_FLAG_FILE)
        self.is_sending = False
        self.pulse_phase = 0.0
        self.status_text = "Ready"
        self.current_attachment = None

        # Skills Cache for Slash Commands
        self.skills_cache = scan_all_skills()

        # Theme Accent Colors (Matrix Razor Sovereign Standard)
        self.accent_hex = "#00ff66"
        self.accent_rgb = (0.0, 1.0, 0.40)
        self.sec_rgb = (0.0, 0.95, 1.00)
        self.load_theme_colors()

        # Layout Container
        self.main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.main_box.set_margin_start(12)
        self.main_box.set_margin_end(12)
