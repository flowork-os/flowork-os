        self.btn_screenshot.set_size_request(38, 38)
        self.btn_screenshot.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_screenshot.connect("clicked", self.on_screenshot_clicked)
        self.lbl_screenshot = Gtk.Label()
        self.lbl_screenshot.set_markup("<span size='medium' color='#00f2fe'>📷</span>")
        self.btn_screenshot.add(self.lbl_screenshot)
        self.main_box.pack_start(self.btn_screenshot, False, False, 0)

        self.btn_attach = Gtk.Button()
        self.btn_attach.set_tooltip_text("Lampirkan Berkas atau Gambar (Attach File)")
        self.btn_attach.set_size_request(38, 38)
        self.btn_attach.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_attach.connect("clicked", self.on_attach_file_clicked)
        self.lbl_attach = Gtk.Label()
        self.lbl_attach.set_markup("<span size='medium' color='#94a3b8'>📎</span>")
        self.btn_attach.add(self.lbl_attach)
        self.main_box.pack_start(self.btn_attach, False, False, 0)

        # Separator Hairline
        sep2 = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        sep2.set_margin_start(3)
        sep2.set_margin_end(3)
        self.main_box.pack_start(sep2, False, False, 0)

        # 7. Right Cluster: Voice Mode Button (Mic / Speaker)
        self.btn_voice = Gtk.Button()
        self.btn_voice.set_size_request(38, 38)
        self.btn_voice.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_voice.connect("clicked", self.on_voice_toggle)
        self.lbl_voice = Gtk.Label()
        self.btn_voice.add(self.lbl_voice)
        self.main_box.pack_start(self.btn_voice, False, False, 0)

        # 8. Right Cluster: Send Action Button (Arrow)
        self.btn_send = Gtk.Button()
        self.btn_send.set_tooltip_text("Kirim Perintah ke Mr. Flow (Enter)")
        self.btn_send.set_size_request(38, 38)
        self.btn_send.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_send.connect("clicked", self.on_send_clicked)
        self.lbl_send = Gtk.Label()
        self.lbl_send.set_markup("<span size='medium' color='#00ff66'>➤</span>")
        self.btn_send.add(self.lbl_send)
        self.main_box.pack_start(self.btn_send, False, False, 0)

        # Drag and Drop support
        self.drag_dest_set(Gtk.DestDefaults.ALL, [], Gdk.DragAction.COPY)
        self.drag_dest_add_uri_targets()
        self.connect("drag-data-received", self.on_drag_data_received)

        # Slash Commands Popover Window
        self.slash_popover = SlashCommandsPopover(self)

        # Apply GTK CSS
        self.apply_css()

        # Enforce that only neural entry holds keyboard focus
        for btn in [self.btn_reactor, self.btn_connector, self.btn_new_chat, self.btn_history,
                    self.btn_screenshot, self.btn_attach, self.btn_voice, self.btn_send,
                    self.btn_remove_attach]:
            btn.set_can_focus(False)
        self.entry.grab_focus()

        # Connect Cairo Draw
        self.connect("draw", self.on_draw)

        # Initial UI synchronization
        self.is_sidebar_open = False
        self.is_checking_active = False
        self.update_voice_ui()
        self.sync_active_states()

        # Periodic refresh
        GLib.timeout_add(50, self.on_animation_tick)
        GLib.timeout_add_seconds(2, self.check_screen_and_theme)
        GLib.timeout_add_seconds(10, self.refresh_skills_cache)

        # Sovereign IPC Socket Server for external control (--attach, etc.)
        self.conduit_socket_path = f"/tmp/flowork-neural-conduit-{USER}.sock"
        self.start_ipc_server()

    def start_ipc_server(self):
        def _ipc_worker():
            if os.path.exists(self.conduit_socket_path):
                try:
                    os.remove(self.conduit_socket_path)
                except Exception:
                    pass
            try:
                server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                server.bind(self.conduit_socket_path)
                server.listen(5)
            except Exception as e:
                print(f"[Conduit] IPC bind error: {e}", file=sys.stderr)
                return

            while True:
                try:
                    conn, _ = server.accept()
                    try:
                        raw = conn.recv(4096)
                        if raw:
                            data = json.loads(raw.decode("utf-8"))
                            action = data.get("action")
                            if action == "attach":
                                path = data.get("path")
                                ftype = data.get("type")
                                GLib.idle_add(lambda p=path, t=ftype: self.set_attachment(p, t))
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "clear":
                                GLib.idle_add(self.clear_attachment)
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "set_text":
                                text = data.get("text", "")
                                GLib.idle_add(lambda t=text: self.entry.set_text(t))
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "show_slash":
                                q = data.get("query", "/")
                                GLib.idle_add(lambda query=q: (self.entry.set_text(query), self.show_slash_popover(query)))
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "status":
                                st = {
                                    "attachment": self.current_attachment,
                                    "voice_active": self.is_voice_active,
                                    "entry_text": self.entry.get_text()
                                }
                                try:
                                    conn.sendall(json.dumps(st).encode("utf-8") + b"\n")
                                except Exception:
                                    pass
                    finally:
                        try:
                            conn.close()
                        except Exception:
                            pass
                except Exception:
                    pass

        threading.Thread(target=_ipc_worker, daemon=True).start()

    def refresh_skills_cache(self):
        self.skills_cache = scan_all_skills()
        return True

    def load_theme_colors(self):
        if os.path.exists(CURRENT_THEME_FILE):
            try:
                with open(CURRENT_THEME_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                self.accent_hex = data.get("accent_color", "#00ff66")
                rgb = data.get("accent_rgb", [0, 255, 102])
                self.accent_rgb = (rgb[0] / 255.0, rgb[1] / 255.0, rgb[2] / 255.0)
                sec = data.get("secondary_rgb", [0, 242, 254])
                self.sec_rgb = (sec[0] / 255.0, sec[1] / 255.0, sec[2] / 255.0)
            except Exception:
                pass

    def check_screen_and_theme(self):
        self.load_theme_colors()
        self.sync_active_states()
        screen = self.get_screen()
        w = screen.get_width()
        h = screen.get_height()
        if w != self.screen_w or h != self.screen_h:
            self.screen_w = w
            self.screen_h = h
            self.pos_x = (self.screen_w - self.bar_w) // 2
            self.pos_y = self.screen_h - self.bar_h - 18
            self.move(self.pos_x, self.pos_y)
        return True

