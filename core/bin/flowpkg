            os.path.join(FLOWORK_ROOT, "installer", "calamares", "settings.conf"),
            "/etc/calamares/modules/partition.conf",
        ],
        "desktop": os.path.join(APPS_DIR, "flowork-installer.desktop"),
    },
}


def resolve_remix_target(target):
    """Resolve an installed Flowork app dir, sovereign component, or system XDG application."""
    raw_id = os.path.basename(target.strip()).removesuffix(".desktop")
    candidates = [raw_id]
    if raw_id.startswith("flowork-"):
        candidates.append(raw_id[len("flowork-"):])
    for cand in list(candidates):
        alias = REMIX_APP_ALIASES.get(cand)
        if alias and alias not in candidates:
            candidates.append(alias)

    # 1. Canonical directory under /opt/floworkos/apps/
    for cand in candidates:
        app_dir = os.path.join(APPS_DIR, cand)
        if os.path.isdir(app_dir) and not is_web_extension(app_dir):
            return {
                "kind": "flowork_app",
                "app_id": cand,
                "source_dir": app_dir,
                "manifest": load_app_manifest(app_dir),
                "seed_files": [],
                "desktop_file": next(
                    (
                        p for p in (
                            os.path.join(APPS_DIR, f"{cand}.desktop"),
                            os.path.join(APPS_DIR, f"flowork-{cand}.desktop"),
                            os.path.join(SYSTEM_APPLICATIONS, f"{cand}.desktop"),
                            os.path.join(SYSTEM_APPLICATIONS, f"flowork-{cand}.desktop"),
                        )
                        if os.path.exists(p)
                    ),
                    None,
                ),
            }

    # 2. Sovereign Flowork component / theme / system tool
    for cand in candidates:
        comp = SOVEREIGN_REMIX_COMPONENTS.get(cand)
        if comp:
            existing_seeds = [p for p in comp.get("seed_files", []) if os.path.exists(p)]
            src_dir = comp.get("source_dir")
            if src_dir and os.path.exists(src_dir) or existing_seeds:
                return {
                    "kind": "sovereign_component",
                    "app_id": cand,
                    "source_dir": src_dir if src_dir and os.path.isdir(src_dir) else "/opt/floworkos",
                    "manifest": {
                        "name": comp["name"],
                        "version": "1.0.0",
                        "category": comp["category"],
                    },
                    "seed_files": existing_seeds,
                    "desktop_file": comp["desktop"] if os.path.exists(comp.get("desktop", "")) else None,
                }

    # 3. System / XDG Desktop Entry fallback (code, google-chrome, nemo, etc.)
    desktop_candidates = []
    for base_dir in (APPS_DIR, os.path.expanduser("~/.local/share/applications"), SYSTEM_APPLICATIONS):
        for cand in candidates:
            for fname in (f"{cand}.desktop", f"flowork-{cand}.desktop", f"mrflow-{cand}.desktop"):
                p = os.path.join(base_dir, fname)
                if p not in desktop_candidates:
                    desktop_candidates.append(p)

    for dp in desktop_candidates:
        if not os.path.isfile(dp):
            continue
        entry = parse_desktop_entry(dp)
        exec_raw = entry.get("Exec", "").strip()
        # Extract executable token stripping quotes/env prefixes
        exec_tokens = exec_raw.split()
        exec_bin = ""
        for tok in exec_tokens:
            if tok == "env" or "=" in tok:
                continue
            exec_bin = tok.strip('"').strip("'")
            break
        resolved_bin = exec_bin if os.path.isabs(exec_bin) and os.path.exists(exec_bin) else shutil.which(exec_bin or "")
        seed_files = [dp]
        if resolved_bin:
            seed_files.append(resolved_bin)
        app_root = os.path.dirname(os.path.realpath(resolved_bin)) if resolved_bin else os.path.dirname(dp)
        return {
            "kind": "system_desktop_app",
            "app_id": raw_id,
            "source_dir": app_root,
            "manifest": {
                "name": entry.get("Name") or raw_id,
                "version": "system",
                "category": entry.get("Categories") or "Application",
            },
            "seed_files": seed_files,
            "desktop_file": dp,
        }

    # 4. Direct executable in PATH as last resort
    direct_bin = shutil.which(raw_id)
    if direct_bin:
        return {
            "kind": "system_binary",
            "app_id": raw_id,
            "source_dir": os.path.dirname(os.path.realpath(direct_bin)),
            "manifest": {"name": raw_id, "version": "system", "category": "Utility"},
            "seed_files": [direct_bin],
            "desktop_file": None,
        }

    return None


def install_package(flow_path):
    """Install a .flowapp package into /opt/floworkos/apps/ and register launchers."""
    try:
        meta, tar_bytes = read_package(flow_path)
    except Exception as e:
        print(f"❌ Error reading .flowapp package: {e}", file=sys.stderr)
        return 1

    app_id = meta.get("app_id")
    target_dir = os.path.join(APPS_DIR, app_id)
    os.makedirs(target_dir, exist_ok=True)

    print(f"⚡ Installing [{app_id}] to Flowork OS: {target_dir}...")
    with tarfile.open(fileobj=io.BytesIO(tar_bytes), mode="r:gz") as tar:
        tar.extractall(target_dir)

    # Save package copy inside app dir for verification/export
    pkg_copy = os.path.join(target_dir, ".package.flowapp")
    try:
        shutil.copy2(flow_path, pkg_copy)
    except Exception:
        pass

    runner_path = locate_runner(target_dir)
    if runner_path:
        os.chmod(runner_path, 0o755)

    # 1. Register CLI launcher wrapper in /opt/floworkos/bin/<app_id>
    launcher_path = os.path.join(BIN_DIR, app_id)
    with open(launcher_path, "w", encoding="utf-8") as f:
        f.write(f"""#!/usr/bin/env bash
# Flowork Sovereign App Launcher: {meta.get('name')}
exec /opt/floworkos/bin/flowpkg run "{app_id}" "$@"
""")
    os.chmod(launcher_path, 0o755)

    # 2. Register .desktop Entry
    desktop_filename = f"flowork-{app_id}.desktop"
    icon_path = os.path.join(ICONS_DIR, f"{app_id}.png")
    if not os.path.exists(icon_path):
        icon_path = os.path.join(ICONS_DIR, "craft-anything.png")
    xdg_categories = format_xdg_categories(meta.get("category", "Utility"))

    desktop_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name={meta.get('name')}
Comment={meta.get('description', 'Flowork Sovereign Application')}
Exec={launcher_path} %U
Icon={icon_path}
Terminal=false
Categories={xdg_categories}
StartupNotify=true
StartupWMClass={app_id}
Actions=Remix;

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix {app_id}
"""
    local_desktop = os.path.join(APPS_DIR, desktop_filename)
    with open(local_desktop, "w", encoding="utf-8") as f:
        f.write(desktop_content)
    os.chmod(local_desktop, 0o755)

    if os.access(SYSTEM_APPLICATIONS, os.W_OK):
        sys_desktop = os.path.join(SYSTEM_APPLICATIONS, desktop_filename)
        try:
            with open(sys_desktop, "w", encoding="utf-8") as f:
                f.write(desktop_content)
            os.chmod(sys_desktop, 0o755)
        except Exception as e:
            print(f"⚠️ Notice: Could not write system desktop file: {e}")

    print(f"🎉 Package [{app_id}] v{meta.get('version')} installed successfully!")
    print(f"👉 Direct CLI: {app_id}")
    print(f"👉 Sandboxed Run: flowpkg run {app_id}")
    return 0


def remove_package(app_id):
    """Cleanly uninstall a package without leftover residue."""
    target_dir = os.path.join(APPS_DIR, app_id)
    launcher_path = os.path.join(BIN_DIR, app_id)
    desktop_filename = f"flowork-{app_id}.desktop"
    local_desktop = os.path.join(APPS_DIR, desktop_filename)
    sys_desktop = os.path.join(SYSTEM_APPLICATIONS, desktop_filename)
    user_desktop = os.path.expanduser(f"~/.local/share/applications/{desktop_filename}")

    if not os.path.exists(target_dir) and not os.path.exists(launcher_path):
        print(f"❌ Error: App [{app_id}] is not installed.", file=sys.stderr)
        return 1

    print(f"🗑️ Removing [{app_id}] from Flowork OS...")

    # Remove application directory
    if os.path.exists(target_dir):
        shutil.rmtree(target_dir, ignore_errors=True)
        print(f"  ✓ Removed {target_dir}")

    # Remove launcher binary
    if os.path.exists(launcher_path):
        os.remove(launcher_path)
        print(f"  ✓ Removed {launcher_path}")

    # Remove desktop files
    for d in [local_desktop, sys_desktop, user_desktop]:
        if os.path.exists(d):
            try:
                os.remove(d)
                print(f"  ✓ Removed {d}")
            except Exception:
                pass

    print(f"✨ App [{app_id}] uninstalled cleanly with zero leftover residue!")
    return 0


def list_packages():
    """List all installed Craft and Sovereign applications in Flowork OS."""
    if not os.path.isdir(APPS_DIR):
        print(f"❌ Error: Apps directory does not exist: {APPS_DIR}", file=sys.stderr)
        return 1

    raw_items = sorted(os.listdir(APPS_DIR))
    # Process canonical directories before symlinks so primary directory ID takes precedence
    ordered_items = [i for i in raw_items if not os.path.islink(os.path.join(APPS_DIR, i))] + [
        i for i in raw_items if os.path.islink(os.path.join(APPS_DIR, i))
    ]

    apps = []
    seen_realpaths = set()
    seen_ids = set()
    for item in ordered_items:
        item_path = os.path.join(APPS_DIR, item)
        if os.path.isdir(item_path):
            real_path = os.path.realpath(item_path)
            if real_path in seen_realpaths:
                continue
            manifest = load_app_manifest(item_path)
            if not manifest or is_web_extension(item_path, manifest):
                continue
            app_id = manifest.get("id") or item
            if app_id in seen_ids:
                continue
            seen_realpaths.add(real_path)
            seen_ids.add(app_id)
            apps.append({
                "id": app_id,
                "name": manifest.get("name") or item,
                "version": manifest.get("version", "1.0.0"),
                "category": manifest.get("category", "General"),
                "icon": manifest.get("icon", "⚡")
            })

    apps.sort(key=lambda x: x["id"])

    print("┌──────────────────────────────────────────────────────────────────────────────────┐")
    print("│ 👑 FLOWORK OS — INSTALLED SOVEREIGN CRAFT APPLICATIONS                           │")
    print("├─────────────────────┬──────────────────────────┬──────────┬──────────────┬───────┤")
    print("│ APP ID              │ NAME                     │ VERSION  │ CATEGORY     │ STATE │")
    print("├─────────────────────┼──────────────────────────┼──────────┼──────────────┼───────┤")
    for a in apps:
        app_id = a['id'][:19]
        name = f"{a['icon']} {a['name']}"[:24]
        ver = a['version'][:8]
        cat = a['category'][:12]
        print(f"│ {app_id:<19} │ {name:<24} │ {ver:<8} │ {cat:<12} │ Ready │")
    print("└─────────────────────┴──────────────────────────┴──────────┴──────────────┴───────┘")
    print(f"Total installed sovereign applications: {len(apps)}")
    return 0


def remix_package(target, prompt=None, inspect_only=False, apply_changes=False):
    """Inspect and stage an application for on-the-fly customization and agentic remixing."""
    is_bundle = os.path.isfile(target) and (target.endswith(".flowapp") or target.endswith(".flow"))
    app_id = ""
    source_dir = ""
    target_kind = "flowork_app"
    seed_files = []
    desktop_file = None

    if is_bundle:
        try:
            meta, tar_bytes = read_package(target)
            app_id = meta.get("app_id", "app")
            stage_dir = f"/tmp/flowork_remix/{app_id}"
            os.makedirs(stage_dir, exist_ok=True)
            with tarfile.open(fileobj=io.BytesIO(tar_bytes), mode="r:gz") as tar:
                tar.extractall(stage_dir)
            source_dir = stage_dir
            manifest = meta
        except Exception as e:
            print(f"❌ Error unpacking .flowapp for remix: {e}", file=sys.stderr)
            return 1
    else:
        resolved = resolve_remix_target(target)
        if not resolved:
            print(
                f"❌ Error: App [{target}] not found in {APPS_DIR}, sovereign components, or desktop applications.",
                file=sys.stderr,
            )
            return 1
        target_kind = resolved["kind"]
        app_id = resolved["app_id"]
        source_dir = resolved["source_dir"]
        manifest = resolved["manifest"]
        seed_files = resolved.get("seed_files") or []
        desktop_file = resolved.get("desktop_file")

    name = manifest.get("name") or app_id
    version = manifest.get("version", "1.0.0")
    icon = manifest.get("icon", "⚡")
    category = manifest.get("category", "Utility")

    if target_kind == "flowork_app":
        ui_files = []
        backend_files = []
        for root, _, files in os.walk(source_dir):
            if "__pycache__" in root or ".git" in root or "target" in root:
                continue
            for f in files:
                p = os.path.join(root, f)
                rel = os.path.relpath(p, source_dir)
                if f.endswith((".html", ".css", ".js")):
                    ui_files.append(rel)
                elif f.endswith((".py", ".rs", ".sh")):
                    backend_files.append(rel)
    else:
        stage_dir = os.path.expanduser(f"~/.flowork/remixes/{app_id}")
        os.makedirs(stage_dir, exist_ok=True)
        remix_meta_path = os.path.join(stage_dir, "REMIX_CONTEXT.json")
        with open(remix_meta_path, "w", encoding="utf-8") as mf:
            json.dump(
                {
                    "app_id": app_id,
                    "kind": target_kind,
                    "name": name,
                    "source_dir": source_dir,
                    "desktop_file": desktop_file,
                    "seed_files": seed_files,
                    "override_desktop_dir": os.path.expanduser("~/.local/share/applications"),
                },
                mf,
                indent=2,
            )
        ui_files = [os.path.relpath(p, FLOWORK_ROOT) if p.startswith(FLOWORK_ROOT) else p for p in ([desktop_file] if desktop_file else [])]
        backend_files = [p for p in seed_files if p != desktop_file]
        source_dir = stage_dir

    print("┌──────────────────────────────────────────────────────────────────────────────────┐")
    print(f"│ 🛠️  FLOWORK OS — REMIX APPLICATION STUDIO: [{app_id:<36}] │")
    print("├─────────────────────┬────────────────────────────────────────────────────────────┤")
    print(f"│ Name                │ {icon} {name}")
    print(f"│ Mode / Origin       │ {target_kind} (v{version})")
    print(f"│ Category            │ {category}")
    print(f"│ Remix Workspace     │ {source_dir}")
    print(f"│ UI / Entry ({len(ui_files):<2})     │ {', '.join(ui_files[:4])}{'...' if len(ui_files) > 4 else ''}")
    print(f"│ Logic / Exec ({len(backend_files):<2})   │ {', '.join(backend_files[:4])}{'...' if len(backend_files) > 4 else ''}")
    print("└─────────────────────┴────────────────────────────────────────────────────────────┘")

    if inspect_only and not prompt:
        print("\n✓ Remix inspection complete.")
        print(f"💡 To remix this app interactively: flowpkg remix {target} --prompt \"Add feature X\"")
        return 0

    try:
        import urllib.request
        bus_port = os.environ.get("FLOWORK_BUS_PORT", "18095")
        bus_url = os.environ.get("FLOWORK_BUS_URL", f"http://127.0.0.1:{bus_port}")
        evt_data = json.dumps({
            "type": "app.remix_started",
            "app_id": app_id,
            "kind": target_kind,
            "source_dir": source_dir,
            "prompt": prompt or "Interactive Remix Session",
            "ui_files": ui_files,
            "backend_files": backend_files
        }).encode("utf-8")
        req = urllib.request.Request(f"{bus_url}/api/bus/publish", data=evt_data)
        req.add_header("Content-Type", "application/json")
        with urllib.request.urlopen(req, timeout=2) as _:
            pass
    except Exception:
        pass

    if prompt:
        print(f"\n⚡ Applying Remix Directive: \"{prompt}\"")
        notes_dir = source_dir if os.access(source_dir, os.W_OK) else os.path.expanduser(f"~/.flowork/remixes/{app_id}")
        os.makedirs(notes_dir, exist_ok=True)
        remix_log = os.path.join(notes_dir, "REMIX_NOTES.md")
        with open(remix_log, "a", encoding="utf-8") as f:
            f.write(f"\n## Remix: {time.strftime('%Y-%m-%d %H:%M:%S')}\n- Target: {app_id} ({target_kind})\n- Directive: {prompt}\n- Author: Mr. Flow\n")
        print(f"✓ Recorded remix directive in {remix_log}")

    if apply_changes and target_kind == "flowork_app":
        print(f"\n⚡ Applying changes and re-registering [{app_id}]...")
        craft_bin = "/opt/floworkos/bin/craft-app"
        if os.path.exists(craft_bin):
            subprocess.call([craft_bin, "test", app_id])
            subprocess.call([craft_bin, "register", app_id])
        print(f"✓ [{app_id}] re-registered successfully!")

    print(f"\n🎉 App [{app_id}] is ready for live remixing in: {source_dir}")
    return 0


def main():
    parser = argparse.ArgumentParser(
        description="Flowork Sovereign Application Package Engine (flowpkg)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  flowpkg build /opt/floworkos/apps/crypto-radar -o crypto-radar.flowapp
  flowpkg inspect crypto-radar.flowapp
  flowpkg install crypto-radar.flowapp
  flowpkg run crypto-radar
  flowpkg remix crypto-radar --inspect
  flowpkg remix crypto-radar --prompt "Add dark mode toggle"
  flowpkg list
  flowpkg remove crypto-radar
"""
    )
    sub = parser.add_subparsers(dest="command")

    p_build = sub.add_parser("build", help="Build a .flowapp bundle from an app directory")
    p_build.add_argument("source_dir", help="App directory containing app.json or manifest.json")
    p_build.add_argument("-o", "--output", help="Output .flowapp file path")

    p_inspect = sub.add_parser("inspect", help="Inspect a .flowapp package manifest and sandbox declarations")
    p_inspect.add_argument("flow_path", help="Path to .flowapp file")

    p_run = sub.add_parser("run", help="Run an application inside Landlock LSM sandboxed jail (file or app_id)")
    p_run.add_argument("target", help="Path to .flowapp file OR installed app_id")

    p_remix = sub.add_parser("remix", help="Inspect and stage an application for instant agentic remixing")
    p_remix.add_argument("target", help="Installed app_id OR path to .flowapp file")
    p_remix.add_argument("--prompt", help="Remix prompt or instruction to apply")
    p_remix.add_argument("--inspect", action="store_true", help="Inspect remixable files without staging")
    p_remix.add_argument("--apply", action="store_true", help="Re-test and re-register app after modifications")

    p_inst = sub.add_parser("install", help="Install a .flowapp package to Flowork OS")
    p_inst.add_argument("flow_path", help="Path to .flowapp file")

    p_rem = sub.add_parser("remove", help="Cleanly uninstall an application and its launchers")
    p_rem.add_argument("app_id", help="App ID to remove (e.g. crypto-radar)")

    sub.add_parser("list", help="List all installed sovereign craft applications")

    args, unknown = parser.parse_known_args()

    if not args.command:
        parser.print_help()
        return 0

    if args.command == "build":
        return build_package(args.source_dir, args.output)
    elif args.command == "inspect":
        return inspect_package(args.flow_path)
    elif args.command == "run":
        return run_package(args.target, unknown)
    elif args.command == "remix":
        return remix_package(args.target, prompt=args.prompt, inspect_only=args.inspect, apply_changes=args.apply)
    elif args.command == "install":
        return install_package(args.flow_path)
    elif args.command == "remove":
        return remove_package(args.app_id)
    elif args.command == "list":
        return list_packages()

    return 0


if __name__ == "__main__":
    sys.exit(main())
