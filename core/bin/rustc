#!/bin/sh
# Flowork OS Sovereign Rust Compiler Dispatcher
if [ -n "$RUSTUP_HOME" ] && [ -x "$RUSTUP_HOME/toolchains/stable-x86_64-unknown-linux-gnu/bin/rustc" ]; then
    exec "$RUSTUP_HOME/toolchains/stable-x86_64-unknown-linux-gnu/bin/rustc" "$@"
elif [ -x "$HOME/.cargo/bin/rustc" ]; then
    exec "$HOME/.cargo/bin/rustc" "$@"
else
    exec /usr/bin/rustc "$@"
fi
