        def update_subsystem_button(self):
            running = is_emulator_running()
            if running:
                self.btn_status.set_label("🟢 Subsystem Online")
                self.btn_status.get_style_context().remove_class("hud-btn-danger")
                self.btn_status.get_style_context().add_class("hud-btn-primary")
            else:
                self.btn_status.set_label("🔴 Subsystem Offline")
                self.btn_status.get_style_context().remove_class("hud-btn-primary")
                self.btn_status.get_style_context().add_class("hud-btn-danger")

        def select_category(self, cat_id):
            self.current_category = cat_id
            for c_id, btn in self.category_buttons.items():
                if c_id == cat_id:
                    btn.get_style_context().remove_class("category-pill")
                    btn.get_style_context().add_class("category-pill-active")
                else:
                    btn.get_style_context().remove_class("category-pill-active")
                    btn.get_style_context().add_class("category-pill")

            if cat_id == "installed":
                self.lbl_section_title.set_label("📦 APLIKASI ANDROID TERINSTAL DI FLOWORK OS")
                self.render_installed_apps()
            elif cat_id == "local":
                self.lbl_section_title.set_label("📂 BERKAS PAKET APK / XAPK LOKAL")
                self.render_local_packages()
            else:
                cat_titles = {
                    "featured": "🔥 APLIKASI UNGGULAN & REKOMENDASI POPULER",
                    "video": "🎬 EDITOR VIDEO, FOTO & KONTEN KREATIF",
                    "shopping": "🛍️ E-COMMERCE & MARKETPLACE RESMI",
                    "social": "💬 PERPESANAN INSTAN & MEDIA SOSIAL",
                    "tools": "🛠️ ALAT, UTILITAS & SISTEM",
                    "games": "🎮 GAME ANDROID PILIHAN TERBAIK"
                }
                self.lbl_section_title.set_label(cat_titles.get(cat_id, "KATALOG APLIKASI"))
                apps = CURATED_ECOSYSTEM.get(cat_id, [])
                self.render_app_list(apps)

        def clear_cards(self):
            for child in self.cards_container.get_children():
                self.cards_container.remove(child)

        def render_app_list(self, apps):
            self.clear_cards()
            if not apps:
                lbl_empty = Gtk.Label(label="Tidak ada aplikasi yang ditemukan.")
                lbl_empty.get_style_context().add_class("app-pkg")
                lbl_empty.set_margin_top(40)
                self.cards_container.pack_start(lbl_empty, True, True, 0)
                self.cards_container.show_all()
                return

            installed_set = get_installed_packages()

            for app in apps:
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
                card.get_style_context().add_class("app-card")

                # Icon
                icon_img = Gtk.Image()
                if os.path.exists(DEFAULT_ICON):
                    try:
                        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(DEFAULT_ICON, 46, 46, True)
                        icon_img.set_from_pixbuf(pix)
                    except Exception:
                        pass
                card.pack_start(icon_img, False, False, 0)

                fetch_icon_async(app.get("icon_url", ""), app["pkg"], icon_img, 46)

                # Metadata info
                v_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                card.pack_start(v_info, True, True, 0)

                h_top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                v_info.pack_start(h_top, False, False, 0)

                lbl_name = Gtk.Label(label=app["name"])
                lbl_name.get_style_context().add_class("app-title")
                h_top.pack_start(lbl_name, False, False, 0)

                if app.get("rating"):
                    lbl_rat = Gtk.Label(label=app["rating"])
                    lbl_rat.get_style_context().add_class("badge-rating")
                    h_top.pack_start(lbl_rat, False, False, 0)

                if app.get("cat"):
                    lbl_cat = Gtk.Label(label=app["cat"])
                    lbl_cat.get_style_context().add_class("badge-cat")
                    h_top.pack_start(lbl_cat, False, False, 0)

                lbl_dev = Gtk.Label(label=f"{app.get('dev', '')} • {app['pkg']}")
                lbl_dev.set_halign(Gtk.Align.START)
                lbl_dev.get_style_context().add_class("app-pkg")
                v_info.pack_start(lbl_dev, False, False, 0)

                if app.get("desc"):
                    lbl_desc = Gtk.Label(label=app["desc"])
                    lbl_desc.set_halign(Gtk.Align.START)
                    lbl_desc.get_style_context().add_class("app-desc")
                    lbl_desc.set_line_wrap(True)
                    lbl_desc.set_max_width_chars(70)
                    v_info.pack_start(lbl_desc, False, False, 0)

                # Progress bar for downloads
                prog_bar = Gtk.ProgressBar()
                prog_bar.set_no_show_all(True)
                v_info.pack_start(prog_bar, False, False, 0)

                lbl_prog = Gtk.Label(label="")
                lbl_prog.set_halign(Gtk.Align.START)
                lbl_prog.get_style_context().add_class("app-pkg")
                lbl_prog.set_no_show_all(True)
                v_info.pack_start(lbl_prog, False, False, 0)

                # Action button
                v_action = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                card.pack_start(v_action, False, False, 0)

                is_inst = app["pkg"] in installed_set
                btn_action = Gtk.Button()
                if is_inst:
                    btn_action.set_label("🚀 Buka")
                    btn_action.get_style_context().add_class("hud-btn-primary")
                    btn_action.connect("clicked", lambda b, p=app["pkg"]: self.launch_app(p))
                else:
                    btn_action.set_label("⬇️ Pasang")
                    btn_action.get_style_context().add_class("hud-btn-secondary")
                    btn_action.connect("clicked", lambda b, a=app, btn=btn_action, pb=prog_bar, lp=lbl_prog: self.install_app(a, btn, pb, lp))

                v_action.pack_start(btn_action, True, False, 0)

                self.cards_container.pack_start(card, False, False, 0)

            self.cards_container.show_all()

        def render_installed_apps(self):
            self.clear_cards()
            reg_data = load_registry()

            if not reg_data:
                lbl_empty = Gtk.Label(label="Belum ada aplikasi Android yang terinstal.")
                lbl_empty.get_style_context().add_class("app-pkg")
                lbl_empty.set_margin_top(40)
                self.cards_container.pack_start(lbl_empty, True, True, 0)
                self.cards_container.show_all()
                return

            for pkg, meta in reg_data.items():
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
                card.get_style_context().add_class("app-card")

                icon_img = Gtk.Image()
                icon_path = meta.get("icon", DEFAULT_ICON)
                if not os.path.exists(icon_path):
                    icon_path = DEFAULT_ICON
                try:
                    pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_path, 44, 44, True)
                    icon_img.set_from_pixbuf(pix)
                except Exception:
                    pass
                card.pack_start(icon_img, False, False, 0)

                v_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                card.pack_start(v_info, True, True, 0)

                lbl_name = Gtk.Label(label=meta.get("label", pkg))
                lbl_name.set_halign(Gtk.Align.START)
                lbl_name.get_style_context().add_class("app-title")
                v_info.pack_start(lbl_name, False, False, 0)

                lbl_sub = Gtk.Label(label=f"{pkg} • Native Desktop Window")
                lbl_sub.set_halign(Gtk.Align.START)
                lbl_sub.get_style_context().add_class("app-pkg")
                v_info.pack_start(lbl_sub, False, False, 0)

                btn_open = Gtk.Button(label="🚀 Buka Aplikasi")
                btn_open.get_style_context().add_class("hud-btn-primary")
                btn_open.connect("clicked", lambda b, p=pkg: self.launch_app(p))
                card.pack_start(btn_open, False, False, 0)

                btn_del = Gtk.Button(label="🗑️ Hapus")
                btn_del.get_style_context().add_class("hud-btn-danger")
                btn_del.connect("clicked", lambda b, p=pkg: self.uninstall_app(p))
                card.pack_start(btn_del, False, False, 0)

                self.cards_container.pack_start(card, False, False, 0)

            self.cards_container.show_all()

        def render_local_packages(self):
            self.clear_cards()
            downloads_dir = os.path.join(HOME_DIR, "Downloads")
            files = sorted(list(set(
                glob.glob(os.path.join(APK_STORAGE_DIR, "*.apk")) +
                glob.glob(os.path.join(APK_STORAGE_DIR, "*.xapk")) +
                glob.glob(os.path.join(downloads_dir, "*.apk")) +
                glob.glob(os.path.join(downloads_dir, "*.xapk"))
            )))

            if not files:
                lbl_empty = Gtk.Label(label="Tidak ada berkas APK atau XAPK di /opt/floworkos/apk atau Downloads.")
                lbl_empty.get_style_context().add_class("app-pkg")
                lbl_empty.set_margin_top(40)
                self.cards_container.pack_start(lbl_empty, True, True, 0)
                self.cards_container.show_all()
                return

            for fpath in files:
                fname = os.path.basename(fpath)
                sz_mb = os.path.getsize(fpath) / (1024 * 1024)

                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
                card.get_style_context().add_class("app-card")

                icon_img = Gtk.Image()
                if os.path.exists(DEFAULT_ICON):
                    try:
                        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(DEFAULT_ICON, 42, 42, True)
                        icon_img.set_from_pixbuf(pix)
                    except Exception:
                        pass
                card.pack_start(icon_img, False, False, 0)

                v_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                card.pack_start(v_info, True, True, 0)

                lbl_name = Gtk.Label(label=fname)
                lbl_name.set_halign(Gtk.Align.START)
                lbl_name.get_style_context().add_class("app-title")
                v_info.pack_start(lbl_name, False, False, 0)

                lbl_path = Gtk.Label(label=f"Paket Lokal • {sz_mb:.1f} MB • {fpath}")
                lbl_path.set_halign(Gtk.Align.START)
                lbl_path.get_style_context().add_class("app-pkg")
                v_info.pack_start(lbl_path, False, False, 0)

                btn_inst = Gtk.Button(label="⚡ 1-Click Pasang")
                btn_inst.get_style_context().add_class("hud-btn-primary")
                btn_inst.connect("clicked", lambda b, p=fpath: self.install_local_file(p))
                card.pack_start(btn_inst, False, False, 0)

                self.cards_container.pack_start(card, False, False, 0)

            self.cards_container.show_all()

        def on_search_submitted(self, widget):
            query = self.entry_search.get_text().strip()
            if not query:
                return

            for btn in self.category_buttons.values():
                btn.get_style_context().remove_class("category-pill-active")
                btn.get_style_context().add_class("category-pill")

            self.lbl_section_title.set_label(f"🔍 MENCARI '{query.upper()}' DI REPOSITORI ANDROID & CDN...")
            self.clear_cards()

            lbl_loading = Gtk.Label(label="⏳ Menghubungi repositori Google Play & CDN kecepatan tinggi...")
            lbl_loading.get_style_context().add_class("app-pkg")
            lbl_loading.set_margin_top(40)
            self.cards_container.pack_start(lbl_loading, True, True, 0)
            self.cards_container.show_all()

            def _search_thread():
                results = search_play_store(query, limit=18)
                def _update():
                    self.lbl_section_title.set_label(f"HASIL PENCARIAN: '{query}' ({len(results)} Aplikasi Ditemukan)")
                    self.render_app_list(results)
                GLib.idle_add(_update)

            threading.Thread(target=_search_thread, daemon=True).start()

        def on_search_reset(self, btn):
            self.entry_search.set_text("")
            self.select_category("featured")

        def install_app(self, app, btn, prog_bar, lbl_prog):
            pkg = app["pkg"]
            btn.set_sensitive(False)
            btn.set_label("⏳ Memproses...")
            prog_bar.show()
            lbl_prog.show()
            lbl_prog.set_label("Menghubungi CDN...")
            prog_bar.set_fraction(0.1)

            def _progress(msg, frac):
                def _ui():
                    lbl_prog.set_label(msg)
                    prog_bar.set_fraction(frac)
                GLib.idle_add(_ui)

            def _worker():
                try:
                    subprocess.run(["notify-send", "Flowork App Store", f"Mengunduh & memasang {app['name']}..."],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    cmd = [os.path.join(FLOWORK_ROOT, "bin/flowork-apk"), "download", pkg, "--install"]
                    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                    for line in p.stdout:
                        line = line.strip()
                        if "%" in line:
                            _progress(line, 0.5)
                    p.wait()

                    if p.returncode == 0:
                        def _done():
                            prog_bar.hide()
                            lbl_prog.hide()
                            btn.set_sensitive(True)
                            btn.set_label("🚀 Buka")
                            btn.get_style_context().remove_class("hud-btn-secondary")
                            btn.get_style_context().add_class("hud-btn-primary")
                            btn.disconnect_by_func(self.install_app)
                            btn.connect("clicked", lambda b, p=pkg: self.launch_app(p))
                        GLib.idle_add(_done)
                    else:
                        def _fail():
                            prog_bar.hide()
                            lbl_prog.set_label("Gagal memasang.")
                            btn.set_sensitive(True)
                            btn.set_label("Coba Lagi")
                        GLib.idle_add(_fail)
                except Exception as e:
                    def _err():
                        prog_bar.hide()
                        lbl_prog.set_label(f"Error: {e}")
                        btn.set_sensitive(True)
                        btn.set_label("Coba Lagi")
                    GLib.idle_add(_err)

            threading.Thread(target=_worker, daemon=True).start()

        def install_local_file(self, path):
            subprocess.run(["notify-send", "Flowork App Store", f"Memasang {os.path.basename(path)}..."],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            threading.Thread(target=lambda: subprocess.run([os.path.join(FLOWORK_ROOT, "bin/flowork-apk"), "install", path]), daemon=True).start()
            GLib.timeout_add(3000, self.render_installed_apps)

        def launch_app(self, pkg):
            threading.Thread(target=lambda: action_launch(pkg), daemon=True).start()

        def uninstall_app(self, pkg):
            action_uninstall(pkg)
            self.render_installed_apps()

        def on_direct_download(self, btn):
            target = self.entry_direct.get_text().strip()
            if not target:
                return
            subprocess.run(["notify-send", "Flowork App Store", f"Mengunduh paket '{target}'..."],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            threading.Thread(target=lambda: action_download(target, install=False), daemon=True).start()
            GLib.timeout_add(4000, lambda: self.select_category("local"))

        def on_direct_install(self, btn):
            target = self.entry_direct.get_text().strip()
            if not target:
                return
            subprocess.run(["notify-send", "Flowork App Store", f"Mengunduh & memasang '{target}'..."],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            threading.Thread(target=lambda: action_download(target, install=True), daemon=True).start()
            GLib.timeout_add(4000, lambda: self.select_category("installed"))

        def on_toggle_subsystem(self, btn):
            if is_emulator_running():
                action_stop()
            else:
                threading.Thread(target=boot_subsystem, daemon=True).start()
            GLib.timeout_add(1500, self.update_subsystem_button)

    win = GlassStoreWindow(initial_category)
    Gtk.main()

# ------------------------------------------------------------------------------
# ENTRYPOINT
# ------------------------------------------------------------------------------
def main():
    if len(sys.argv) == 1:
        if os.getenv("DISPLAY"):
            run_gui_manager("featured")
        else:
            action_status()
        return 0

    first_arg = sys.argv[1]

    if first_arg.endswith(".apk") or first_arg.endswith(".xapk") or (os.path.exists(first_arg) and os.path.isfile(first_arg)):
        apk_path = os.path.abspath(first_arg)
        if os.getenv("DISPLAY"):
            run_gui_installer(apk_path)
        else:
            action_install(apk_path)
        return 0

    if first_arg == "install":
        if len(sys.argv) < 3:
            print("Penggunaan: flowork-apk install <path_to_apk_or_xapk>")
            return 1
        apk_path = os.path.abspath(sys.argv[2])
        if os.getenv("DISPLAY"):
            run_gui_installer(apk_path)
        else:
            action_install(apk_path)
        return 0

    elif first_arg == "download":
        if len(sys.argv) < 3:
            print("Penggunaan: flowork-apk download <pkg_or_url> [--install]")
            return 1
        target = sys.argv[2]
        do_install = "--install" in sys.argv
        action_download(target, install=do_install)
        return 0

    elif first_arg == "launch":
        if len(sys.argv) < 3:
            print("Penggunaan: flowork-apk launch <package_name>")
            return 1
        action_launch(sys.argv[2])
        return 0

    elif first_arg == "uninstall":
        if len(sys.argv) < 3:
            print("Penggunaan: flowork-apk uninstall <package_name>")
            return 1
        action_uninstall(sys.argv[2])
        return 0

    elif first_arg == "list":
        reg = load_registry()
        print(f"Aplikasi Android Terinstal ({len(reg)}):")
        for pkg, info in reg.items():
            print(f"  • {info.get('label', pkg)} ({pkg})")
        return 0

    elif first_arg == "boot":
        print("Memulai Flowork Android Subsystem...")
        boot_subsystem()
        print("✓ Android Subsystem siap.")
        return 0

    elif first_arg == "stop":
        action_stop()
        return 0

    elif first_arg == "status":
        action_status()
        return 0

    elif first_arg in ["daemon", "service"]:
        action_daemon()
        return 0

    elif first_arg in ["gui", "manager"]:
        run_gui_manager("installed")
        return 0

    elif first_arg in ["store", "playstore"]:
        action_launch("com.android.vending")
        return 0

    elif first_arg in ["search", "find"]:
        if len(sys.argv) < 3:
            print("Penggunaan: flowork-apk search <kata_kunci>")
            return 1
        q = " ".join(sys.argv[2:])
        print(f"Mencari '{q}' di Google Play Store & CDN...")
        results = search_play_store(q, limit=15)
        print(f"Ditemukan {len(results)} aplikasi:")
        for r in results:
            print(f"  • {r['name']} [{r['pkg']}] {r['rating']} (Dev: {r['dev']})")
        return 0

    elif first_arg in ["volume", "vol"]:
        val = sys.argv[2] if len(sys.argv) > 2 else "max"
        return action_volume(val)

    else:
        print(f"Perintah tidak dikenal: {first_arg}")
        print("Perintah yang tersedia: store, search, install, download, launch, uninstall, list, boot, daemon, stop, status, gui, volume")
        return 1

if __name__ == "__main__":
    sys.exit(main() or 0)

