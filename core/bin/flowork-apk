def run_gui_installer(apk_path):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, GdkPixbuf

    class GlassInstallerWindow(Gtk.Window):
        def __init__(self, apk_path):
            super().__init__(title="Flowork APK Installer")
            self.apk_path = os.path.abspath(apk_path)
            self.set_default_size(520, 340)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.set_resizable(False)

            screen = self.get_screen()
            visual = screen.get_rgba_visual()
            if visual and screen.is_composited():
                self.set_visual(visual)

            css_provider = Gtk.CssProvider()
            css_data = b"""
            window {
                background-color: rgba(12, 16, 24, 0.95);
                border: 1px solid rgba(0, 255, 102, 0.40);
                border-radius: 12px;
            }
            .hud-title {
                font-family: "JetBrains Mono Bold", monospace;
                font-size: 16px;
                color: #00ff66;
            }
            .hud-sub {
                font-family: "JetBrains Mono", monospace;
                font-size: 12px;
                color: #a0aec0;
            }
            .hud-btn-primary {
                background: linear-gradient(135deg, rgba(0, 255, 102, 0.30), rgba(0, 200, 80, 0.45));
                color: #00ff66;
                border: 1px solid #00ff66;
                border-radius: 8px;
                padding: 8px 18px;
                font-family: "JetBrains Mono Bold", monospace;
            }
            .hud-btn-primary:hover {
                background: #00ff66;
                color: #000000;
            }
            .hud-btn-secondary {
                background: rgba(255, 255, 255, 0.08);
                color: #ffffff;
                border: 1px solid rgba(255, 255, 255, 0.20);
                border-radius: 8px;
                padding: 8px 18px;
                font-family: "JetBrains Mono", monospace;
            }
            progressbar progress {
                background-color: #00ff66;
                border-radius: 4px;
            }
            progressbar trough {
                background-color: rgba(255, 255, 255, 0.10);
                border-radius: 4px;
                min-height: 8px;
            }
            """
            css_provider.load_from_data(css_data)
            Gtk.StyleContext.add_provider_for_screen(screen, css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

            main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            main_box.set_margin_top(22)
            main_box.set_margin_bottom(22)
            main_box.set_margin_start(24)
            main_box.set_margin_end(24)
            self.add(main_box)

            header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
            main_box.pack_start(header_box, False, False, 0)

            self.icon_image = Gtk.Image()
            if os.path.exists(DEFAULT_ICON):
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(DEFAULT_ICON, 64, 64, True)
                self.icon_image.set_from_pixbuf(pixbuf)
            header_box.pack_start(self.icon_image, False, False, 0)

            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            header_box.pack_start(text_box, True, True, 0)

            self.lbl_title = Gtk.Label(label="Memeriksa Berkas...")
            self.lbl_title.set_halign(Gtk.Align.START)
            self.lbl_title.get_style_context().add_class("hud-title")
            text_box.pack_start(self.lbl_title, False, False, 0)

            self.lbl_pkg = Gtk.Label(label=os.path.basename(self.apk_path))
            self.lbl_pkg.set_halign(Gtk.Align.START)
            self.lbl_pkg.get_style_context().add_class("hud-sub")
            text_box.pack_start(self.lbl_pkg, False, False, 0)

            self.progress_bar = Gtk.ProgressBar()
            self.progress_bar.set_fraction(0.0)
            main_box.pack_start(self.progress_bar, False, False, 0)

            self.lbl_status = Gtk.Label(label="Siap memasang.")
            self.lbl_status.set_halign(Gtk.Align.START)
            self.lbl_status.get_style_context().add_class("hud-sub")
            main_box.pack_start(self.lbl_status, False, False, 0)

            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            btn_box.set_halign(Gtk.Align.END)
            main_box.pack_start(btn_box, False, False, 0)

            self.btn_cancel = Gtk.Button(label="Batal")
            self.btn_cancel.get_style_context().add_class("hud-btn-secondary")
            self.btn_cancel.connect("clicked", lambda b: self.destroy())
            btn_box.pack_start(self.btn_cancel, False, False, 0)

            self.btn_install = Gtk.Button(label="Pasang Aplikasi")
            self.btn_install.get_style_context().add_class("hud-btn-primary")
            self.btn_install.connect("clicked", lambda b: self.run_installation())
            btn_box.pack_start(self.btn_install, False, False, 0)

            self.connect("destroy", Gtk.main_quit)
            self.initial_inspect()

        def initial_inspect(self):
            try:
                meta = extract_apk_metadata(self.apk_path)
                self.lbl_title.set_label(meta["label"])
                self.lbl_pkg.set_label(f"{meta['package']} • {os.path.basename(self.apk_path)}")
                if os.path.exists(meta["icon"]):
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(meta["icon"], 64, 64, True)
                    self.icon_image.set_from_pixbuf(pixbuf)
            except Exception as e:
                self.lbl_status.set_label(f"Peringatan: {e}")

        def update_progress(self, message, fraction):
            GLib.idle_add(self._update_ui, message, fraction)

        def _update_ui(self, message, fraction):
            self.lbl_status.set_label(message)
            self.progress_bar.set_fraction(max(0.0, min(fraction, 1.0)))

        def run_installation(self):
            self.btn_install.set_sensitive(False)
            self.btn_cancel.set_sensitive(False)
            threading.Thread(target=self._worker_install, daemon=True).start()

        def _worker_install(self):
            try:
                action_install(self.apk_path, self.update_progress)
                time.sleep(1)
                GLib.idle_add(self.destroy)
            except Exception as e:
                self.update_progress(f"Kesalahan: {e}", 0.0)
                GLib.idle_add(lambda: self.btn_cancel.set_sensitive(True))

    win = GlassInstallerWindow(apk_path)
    win.show_all()
    Gtk.main()

