# ------------------------------------------------------------------------------
# REGISTRY HELPERS
# ------------------------------------------------------------------------------
def load_registry():
    if os.path.exists(REGISTRY_FILE):
        try:
            with open(REGISTRY_FILE, "r") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def save_registry(data):
    try:
        with open(REGISTRY_FILE, "w") as f:
            json.dump(data, f, indent=2)
    except Exception as e:
        print(f"[flowork-apk] Warning: Failed to save registry: {e}")

def get_installed_packages():
    pkgs = set(load_registry().keys())
    try:
        out = subprocess.check_output([ADB_BIN, "shell", "pm", "list", "packages", "-3"],
                                      text=True, timeout=2, stderr=subprocess.DEVNULL)
        for line in out.strip().splitlines():
            pkg = line.replace("package:", "").strip()
            if pkg:
                pkgs.add(pkg)
    except Exception:
        pass
    return pkgs

# ------------------------------------------------------------------------------
# METADATA & ICON EXTRACTION
# ------------------------------------------------------------------------------
def extract_apk_metadata(apk_path):
    if not os.path.exists(apk_path):
        raise FileNotFoundError(f"APK file not found: {apk_path}")

    if not zipfile.is_zipfile(apk_path):
        raise RuntimeError(f"Invalid or corrupted APK archive: {apk_path}")

    package_name = ""
    app_label = ""
    main_activity = ""

    # Try aapt first
    if os.path.exists(AAPT_BIN):
        cmd = [AAPT_BIN, "dump", "badging", apk_path]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if res.returncode == 0:
            output = res.stdout
            pkg_match = re.search(r"package:\s+name='([^']+)'", output)
            label_match = re.search(r"application-label(?:-[a-zA-Z_-]+)?:\s*'([^']+)'", output)
            if not label_match:
                label_match = re.search(r"application:\s+label='([^']+)'", output)
            activity_match = re.search(r"launchable-activity:\s+name='([^']+)'", output)

            if pkg_match:
                package_name = pkg_match.group(1)
            if label_match:
                app_label = label_match.group(1)
            if activity_match:
                main_activity = activity_match.group(1)

    if not package_name:
        package_name = os.path.splitext(os.path.basename(apk_path))[0]
    if not app_label:
        app_label = package_name.split(".")[-1].capitalize()

    # Extract best icon
    icon_dest_system = os.path.join(SYSTEM_ICONS_DIR, f"{package_name}.png")
    icon_dest_user = os.path.join(USER_ICONS_DIR, f"{package_name}.png")
    final_icon_path = DEFAULT_ICON

    try:
        with zipfile.ZipFile(apk_path, "r") as z:
            all_files = z.namelist()
            densities = ["xxxhdpi", "xxhdpi", "xhdpi", "hdpi", "mdpi"]
            best_entry = None

            for d in densities:
                matches = [f for f in all_files if d in f and f.lower().endswith(".png") and ("ic_launcher" in f or "icon" in f)]
                if matches:
                    best_entry = matches[0]
                    break

            if not best_entry:
                pngs = [f for f in all_files if f.lower().endswith(".png") and "res/" in f and ("ic_launcher" in f or "icon" in f)]
                if pngs:
                    best_entry = pngs[0]

            if best_entry:
                icon_bytes = z.read(best_entry)
                try:
                    with open(icon_dest_system, "wb") as f_sys:
                        f_sys.write(icon_bytes)
                    final_icon_path = icon_dest_system
                except PermissionError:
                    with open(icon_dest_user, "wb") as f_usr:
                        f_usr.write(icon_bytes)
                    final_icon_path = icon_dest_user
            else:
                if os.path.exists(icon_dest_system):
                    final_icon_path = icon_dest_system
                elif os.path.exists(icon_dest_user):
                    final_icon_path = icon_dest_user
    except Exception as e:
        print(f"[flowork-apk] Icon extraction warning for {package_name}: {e}")

    # Determine default responsive orientation based on app type
    lower_pkg = package_name.lower()
    lower_label = app_label.lower()
    if any(k in lower_pkg or k in lower_label for k in ["shopee", "tokopedia", "tiktok", "instagram", "facebook", "drama", "melolo", "whatsapp", "telegram", "bard", "gemini", "chatgpt", "openai", "deepseek", "suno", "threads", "xcorp", "twitter", "lite"]):
        orientation = "portrait"
    else:
        orientation = "landscape"

    return {
        "package": package_name,
        "label": app_label,
        "activity": main_activity,
        "icon": final_icon_path,
        "orientation": orientation,
        "apk_path": os.path.abspath(apk_path)
    }

# ------------------------------------------------------------------------------
# HARDWARE & SUBSYSTEM LIFECYCLE
# ------------------------------------------------------------------------------
def get_hardware_profile():
    profile = {"ram": 3072, "cores": 4, "gpu": "swiftshader_indirect"}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_kb = int(line.split()[1])
                    mem_mb = mem_kb // 1024
                    if mem_mb >= 15000:
                        profile["ram"] = 4096
                    elif mem_mb >= 7500:
                        profile["ram"] = 3072
                    else:
                        profile["ram"] = 2048
                    break
    except Exception:
        pass

    try:
        cores = os.cpu_count() or 4
        profile["cores"] = max(2, min(cores - 1, 8))
    except Exception:
        pass

    if os.path.exists("/dev/kvm") and os.access("/dev/kvm", os.R_OK | os.W_OK):
        profile["gpu"] = "host"
    return profile

def check_hardware_virtualization():
    """Checks if /dev/kvm is accessible. If not, inspects /proc/cpuinfo to diagnose if VT-x/AMD-V is disabled in BIOS."""
    if os.path.exists("/dev/kvm") and os.access("/dev/kvm", os.R_OK | os.W_OK):
        return True, "KVM Active"

    has_vmx = False
    try:
        with open("/proc/cpuinfo", "r") as f:
            content = f.read().lower()
            if "vmx" in content or "svm" in content:
                has_vmx = True
    except Exception:
        pass

    if has_vmx:
        msg = (
            "⚠️ [INTEL VT-x / AMD-V DISABLED IN BIOS]\n"
            "CPU Anda mendukung akselerasi virtualisasi hardware, namun fitur ini dinonaktifkan di BIOS motherboard.\n\n"
            "CARA MENGAKTIFKAN:\n"
            "1. Nyalakan ulang (restart) komputer Anda.\n"
            "2. Tekan tombol F2 atau Del saat logo komputer muncul untuk masuk ke BIOS/UEFI.\n"
            "3. Buka menu 'CPU Configuration' atau 'Advanced'.\n"
            "4. Ubah 'Intel Virtualization Technology' (VT-x) atau 'SVM Mode' menjadi ENABLED.\n"
            "5. Simpan & Keluar (F10)."
        )
        return False, msg

    return False, "Perangkat keras CPU Anda tidak mendukung virtualisasi hardware (VT-x / SVM)."

def is_emulator_running():
    res = subprocess.run(["pgrep", "-f", f"qemu-system-.*{AVD_NAME}"],
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return res.returncode == 0

def is_adb_online():
    try:
        out = subprocess.check_output([ADB_BIN, "devices"], text=True)
        for line in out.splitlines():
            if "emulator-5554" in line and "device" in line and not "offline" in line:
                return True
    except Exception:
        pass
    return False

def hide_emulator_windows(hide_main=True):
    """Unmaps all emulator canvas and auxiliary windows unconditionally so Android homescreen is 100% invisible."""
    # Never unmap or disrupt active direct hardware windowing session
    try:
        res = subprocess.run(["pgrep", "-f", "flowork-apk-direct"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0:
            return
    except Exception:
        pass
    try:
        out = subprocess.check_output("xdotool search --class 'Emulator'", shell=True, text=True).strip()
        if not out:
            return
        for wid in out.split():
            try:
                subprocess.run(["xdotool", "windowunmap", wid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["xdotool", "windowmove", wid, "5000", "5000"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
    except Exception:
        pass

def apply_android_desktop_tuning(orientation="landscape"):
    """Configures optimal window display density without letterboxing."""
    if not is_adb_online():
        return
    try:
        subprocess.run([ADB_BIN, "shell", "settings", "put", "global", "window_animation_scale", "0.5"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([ADB_BIN, "shell", "settings", "put", "global", "transition_animation_scale", "0.5"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([ADB_BIN, "shell", "settings", "put", "global", "animator_duration_scale", "0.5"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([ADB_BIN, "shell", "settings", "put", "global", "hidden_api_policy", "1"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([ADB_BIN, "shell", "settings", "put", "system", "system_locales", "id-ID"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([ADB_BIN, "shell", "settings", "put", "global", "force_desktop_mode_on_external_displays", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([ADB_BIN, "shell", "settings", "put", "global", "enable_freeform_support", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([ADB_BIN, "shell", "settings", "put", "secure", "show_ime_with_hard_keyboard", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # Eradicate mobile phone DNA: force immersive mode to hide status bar & navigation bar completely
        subprocess.run([ADB_BIN, "shell", "settings", "put", "global", "policy_control", "immersive.status=*;immersive.navigation=*"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # Suppress fullscreen swipe down bubble confirmation
        subprocess.run([ADB_BIN, "shell", "settings", "put", "secure", "immersive_mode_confirmations", "confirmed"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # Disable lockscreen so Android never sleeps into a phone lockscreen
        subprocess.run([ADB_BIN, "shell", "locksettings", "set-disabled", "true"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # Maximize default Android volume (100% / index 15) across all audio streams
        vol_cmd = (
            "settings put system volume_music 15; "
            "settings put system volume_music_speaker 15; "
            "settings put system volume_ring 7; "
            "settings put system volume_system 7; "
            "settings put system volume_alarm 7; "
            "settings put system volume_notification 7; "
            "settings put system volume_voice 5; "
            "settings put system volume_bluetooth_sco 15; "
            "settings put global audio_safe_volume_state 0; "
            "input keyevent 24 24 24 24 24 24 24 24 24 24 24 24 24 24 24"
        )
        subprocess.run([ADB_BIN, "shell", vol_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        if orientation == "portrait":
            subprocess.run([ADB_BIN, "shell", "wm", "size", "720x1280"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([ADB_BIN, "shell", "wm", "density", "240"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.run([ADB_BIN, "shell", "wm", "size", "reset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([ADB_BIN, "shell", "wm", "density", "reset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"[flowork-apk] Tuning warning: {e}")

def ensure_avd_exists():
    """Dynamically provisions the FlowOS_Desktop AVD for the current user if missing."""
    avd_dir = os.path.join(HOME_DIR, ".android/avd")
    os.makedirs(avd_dir, exist_ok=True)
    ini_file = os.path.join(avd_dir, f"{AVD_NAME}.ini")
    avd_folder = os.path.join(avd_dir, f"{AVD_NAME}.avd")

    ini_content = f"""avd.ini.encoding=UTF-8
path={avd_folder}
path.rel=avd/{AVD_NAME}.avd
target=android-34
"""
    with open(ini_file, "w") as f:
        f.write(ini_content)

    os.makedirs(avd_folder, exist_ok=True)
    config_file = os.path.join(avd_folder, "config.ini")
    if not os.path.exists(config_file):
        template_config = os.path.join(FLOWORK_ROOT, "android-sdk/avd-template/config.ini")
        if os.path.exists(template_config):
            shutil.copyfile(template_config, config_file)

def boot_subsystem(progress_cb=None):
    """Boots the native Android 14 Desktop Subsystem in background headless mode."""
    ensure_avd_exists()
    if is_emulator_running() and is_adb_online():
        hide_emulator_windows()
        return True

    # Eradicate any stale AVD lock files if emulator is not running
    avd_folder = os.path.join(HOME_DIR, f".android/avd/{AVD_NAME}.avd")
    if os.path.exists(avd_folder):
        for lf in glob.glob(os.path.join(avd_folder, "*.lock")):
            try:
                os.remove(lf)
            except Exception:
                pass


    kvm_ok, kvm_msg = check_hardware_virtualization()
    if not kvm_ok:
        print(f"\n\033[1;31m================================================================\033[0m", file=sys.stderr)
        print(f"\033[38;2;255;184;0m{kvm_msg}\033[0m", file=sys.stderr)
        print(f"\033[1;31m================================================================\033[0m\n", file=sys.stderr)
        if os.environ.get("DISPLAY"):
            try:
                subprocess.Popen([
                    "notify-send", "-u", "critical", "-t", "12000",
                    "⚠️ Flowork Android: Intel VT-x Disabled in BIOS",
                    "Akselerasi KVM tidak aktif. Silakan aktifkan Intel Virtualization Technology (VT-x) di BIOS motherboard Anda (tekan F2/Del saat boot)."
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
        accel_mode = "auto"
    else:
        accel_mode = "on"

    if progress_cb:
        if kvm_ok:
            progress_cb("Menginisialisasi Android Subsystem (KVM + HW Accel + Audio)...", 0.15)
        else:
            progress_cb("Inisialisasi Android Subsystem (Peringatan: VT-x nonaktif di BIOS)...", 0.15)

    profile = get_hardware_profile()
    env = os.environ.copy()
    env["QEMU_AUDIO_DRV"] = "pa"
    env["PULSE_SERVER"] = os.getenv("PULSE_SERVER", f"/run/user/{os.getuid()}/pulse/native")

    emu_args = [
        EMULATOR_BIN,
        "-avd", AVD_NAME,
        "-no-boot-anim",
        "-gpu", profile["gpu"],
        "-memory", str(profile["ram"]),
        "-cores", str(profile["cores"]),
        "-accel", accel_mode,
        "-netdelay", "none",
        "-netspeed", "full",
        "-no-snapshot-save",
        "-allow-host-audio",
        "-camera-front", "emulated",
        "-camera-back", "emulated",
        "-skin", "720x1280"
    ]

    subprocess.Popen(emu_args, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    for i in range(40):
        time.sleep(1)
        hide_emulator_windows()
        if progress_cb:
            pct = 0.15 + (i / 40.0) * 0.70
            progress_cb(f"Memulai runtime Android ({int(pct*100)}%)...", pct)

        if is_adb_online():
            try:
                boot_completed = subprocess.check_output(
                    [ADB_BIN, "shell", "getprop", "sys.boot_completed"],
                    text=True, stderr=subprocess.DEVNULL
                ).strip()
                if boot_completed == "1":
                    if progress_cb:
                        progress_cb("Menerapkan konfigurasi desktop...", 0.95)
                    hide_emulator_windows()
                    apply_android_desktop_tuning("landscape")
                    return True
            except Exception:
                pass

    hide_emulator_windows()
    apply_android_desktop_tuning("landscape")
    return True

def set_net_wm_icon(wid, icon_path):
    """Sets _NET_WM_ICON property on an X11 window from a PNG icon."""
    if not icon_path or not os.path.exists(icon_path):
        return
    try:
        from PIL import Image
        im = Image.open(icon_path).convert('RGBA').resize((64, 64), Image.Resampling.LANCZOS)
        w, h = im.size
        data = [str(w), str(h)]
        for y in range(h):
            for x in range(w):
                r, g, b, a = im.getpixel((x, y))
                pixel = (a << 24) | (r << 16) | (g << 8) | b
                data.append(str(pixel))
        subprocess.run(
            ["xprop", "-id", str(wid), "-f", "_NET_WM_ICON", "32c", "-set", "_NET_WM_ICON", " ".join(data)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    except Exception:
        pass

def is_secure_app(package):
    """Detects apps requiring Direct Hardware Windowing to bypass FLAG_SECURE DRM black screen."""
    if not package:
        return False
    return package in [
        "com.worldance.drama",        # Melolo
        "asia.dramapendek.melolo",
        "com.storymatrix.drama",       # DramaBox
    ]

def launch_hardware_window(label, package):
    """Direct Hardware Windowing for DRM/FLAG_SECURE apps without any custom wrapper or phone frame."""
    try:
        out = subprocess.check_output(f"xdotool search --name '{label}'", shell=True, text=True).strip()
        if out:
            wid = out.split()[-1]
            subprocess.run(["wmctrl", "-i", "-a", wid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return wid
    except Exception:
        pass

    runner_script = os.path.join(FLOWORK_ROOT, "bin/flowork-apk-direct")
    p = subprocess.Popen([runner_script, package or "com.worldance.drama", label],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return p

def launch_seamless_window(label, package=None):
    """Launches the Android app directly in a native desktop window (no phone frame, no homescreen)."""
    if is_secure_app(package):
        return launch_hardware_window(label, package)

    reg = load_registry()
    icon_path = DEFAULT_ICON
    lower_pkg = (package or "").lower()
    lower_label = (label or "").lower()

    if package == "com.android.vending" or "play store" in lower_label:
        label = "Google Play Store"
        orientation = "landscape"
        icon_path = os.path.join(FLOWORK_ROOT, "icons/google-play.png")
        wm_class = "flowork-playstore"
    elif any(k in lower_pkg or k in lower_label for k in ["capcut", "lemon", "shopee", "tokopedia", "tiktok", "instagram", "facebook", "drama", "melolo", "whatsapp", "telegram", "bard", "gemini", "chatgpt", "openai", "deepseek", "suno", "threads", "xcorp", "twitter", "lite", "inshot", "youcut", "video"]):
        orientation = "portrait"
        wm_class = f"flowork-apk-{package}" if package else "flowork-apk"
    elif package and package in reg:
        orientation = reg[package].get("orientation", "portrait")
        wm_class = f"flowork-apk-{package}"
    else:
        orientation = "landscape"
        wm_class = f"flowork-apk-{package}" if package else "flowork-apk"

    if package and package in reg and package != "com.android.vending":
        icon_path = reg[package].get("icon", DEFAULT_ICON)
    if not os.path.exists(icon_path):
        icon_path = DEFAULT_ICON

    apply_android_desktop_tuning(orientation)

    # Check if this specific app window is already active
    try:
        out = subprocess.check_output("xdotool search --class 'scrcpy_bin'", shell=True, text=True).strip()
        if not out:
            out = subprocess.check_output("xdotool search --class 'scrcpy'", shell=True, text=True).strip()
        if out:
            for wid in out.split():
                name_out = subprocess.check_output(["xdotool", "getwindowname", wid], text=True).strip()
                if name_out == label:
                    subprocess.run(["wmctrl", "-i", "-a", wid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return None
    except Exception:
        pass

    env = os.environ.copy()
    env["SDL_VIDEO_X11_WMCLASS"] = wm_class
    env["SCRCPY_ICON_PATH"] = icon_path

    win_w = "480" if orientation == "portrait" else "1280"
    win_h = "854" if orientation == "portrait" else "800"
    display_res = "720x1280/240" if orientation == "portrait" else "1280x800/240"
    start_pkg_flag = f"--start-app=+{package}" if package else "--start-app=+com.android.vending"
    cmd = [
        "/opt/floworkos/scrcpy-v3/scrcpy_bin",
        "-s", "emulator-5554",
        "--tunnel-host=127.0.0.1",
        f"--window-title={label}",
        f"--window-width={win_w}",
        f"--window-height={win_h}",
        f"--new-display={display_res}",
        "--no-vd-system-decorations",
        start_pkg_flag,
        "--mouse-bind=b---",
        "--shortcut-mod=rctrl",
        "--audio-source=playback",
        "--audio-buffer=50"
    ]
    p = subprocess.Popen(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    def monitor_and_decorate(proc, pkg, win_label, icon):
        # Inject authentic application icon into X11 window properties
        for _ in range(25):
            time.sleep(0.2)
            try:
                wids = subprocess.check_output(f"xdotool search --name '{win_label}'", shell=True, text=True).strip().split()
                if wids:
                    set_net_wm_icon(wids[0], icon)
                    break
            except Exception:
                pass

        proc.wait()
        if pkg:
            subprocess.run([ADB_BIN, "shell", "am", "force-stop", pkg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    threading.Thread(target=monitor_and_decorate, args=(p, package, label, icon_path), daemon=True).start()
    return p


# ------------------------------------------------------------------------------
# DESKTOP ENTRY GENERATION
# ------------------------------------------------------------------------------
def create_desktop_entry(meta):
    package = meta["package"]
    label = meta["label"]
    icon_path = meta.get("icon", DEFAULT_ICON)
    clean_label = re.sub(r'[^a-zA-Z0-9_-]', '_', label)
    desktop_name = f"flowork-apk-{package}.desktop"
    target_user_file = os.path.join(USER_APPS_DIR, desktop_name)
    target_system_file = os.path.join(SYSTEM_APPS_DIR, desktop_name)

    categories = "X-Flowork-APK;AudioVideo;Utility;Network;"
    content = f"""[Desktop Entry]
Type=Application
Version=1.0
Name={label}
GenericName=Android Application
Comment=Android App {label} on Flowork OS
Exec={FLOWORK_ROOT}/bin/flowork-apk launch {package}
Icon={icon_path}
Terminal=false
Categories={categories}
Keywords=android;apk;mobile;{clean_label.lower()};
StartupNotify=true
StartupWMClass=flowork-apk-{package}
"""

    with open(target_user_file, "w") as f:
        f.write(content)
    os.chmod(target_user_file, 0o755)

    try:
        with open(target_system_file, "w") as f:
            f.write(content)
        os.chmod(target_system_file, 0o755)
    except PermissionError:
        pass

    subprocess.run(["update-desktop-database", USER_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return target_user_file

# ------------------------------------------------------------------------------
# HIGH-SPEED CDN DOWNLOAD & PLAY STORE SEARCH
# ------------------------------------------------------------------------------
def search_play_store(query, limit=18):
    """Scrapes Google Play Store web search for apps, returning real metadata & icons."""
    url = f"https://play.google.com/store/search?q={urllib.parse.quote(query)}&c=apps&hl=id"
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        }
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            content = resp.read().decode("utf-8", errors="ignore")
    except Exception as e:
        print("[flowork-apk] Search network error:", e)
        return []

    matches = list(re.finditer(r'/store/apps/details\?id=([a-zA-Z0-9._]+)', content))
    seen = set()
    results = []

    for m in matches:
        pkg = m.group(1)
        if pkg in seen or pkg.startswith("com.google.android."):
            continue
        seen.add(pkg)

        idx = m.start()
        chunk = content[idx:idx+2200]

        name = ""
        m_name = re.search(r'class="DdYX5">([^<]+)</span>', chunk)
        if m_name:
            name = m_name.group(1)
        else:
            m_name2 = re.search(r'class="vWM94c">([^<]+)</div>', chunk)
            if m_name2:
                name = m_name2.group(1)
            else:
                m_label = re.search(r'aria-label="([^"]+)"', content[max(0, idx-100):idx+200])
                if m_label:
                    name = m_label.group(1)
        if not name:
            name = pkg.split(".")[-1].capitalize()

        dev = ""
        m_dev = re.search(r'class="wMUdtb">([^<]+)</span>', chunk)
        if m_dev:
            dev = m_dev.group(1)
        else:
            m_dev2 = re.search(r'class="LbQbAe">([^<]+)</div>', chunk)
            if m_dev2:
                dev = m_dev2.group(1)

        rating = ""
        m_rat = re.search(r'class="w2kbF">([0-9,.]+)</span>', chunk)
        if m_rat:
            rating = m_rat.group(1)
        else:
            m_rat2 = re.search(r'role="img" aria-label="[^"]*?([0-9,.]+)\s*bintang', chunk)
            if m_rat2:
                rating = m_rat2.group(1)

        icon = ""
        m_ico = re.search(r'<img [^>]*src="(https://play-lh\.googleusercontent\.com/[^"]+=(?:s64|s128)[^"]*)"', chunk)
        if not m_ico:
            m_ico = re.search(r'<img [^>]*src="(https://play-lh\.googleusercontent\.com/[^"]+)"', chunk)
        if m_ico:
            icon = m_ico.group(1)

        results.append({
            "pkg": pkg,
            "name": html.unescape(name).strip(),
            "cat": "Play Store",
            "dev": html.unescape(dev).strip(),
            "rating": f"⭐ {rating}" if rating else "",
            "desc": f"Pengembang: {dev}" if dev else "Aplikasi Resmi Android",
            "icon_url": icon
        })
        if len(results) >= limit:
            break

    return results

def fetch_icon_async(icon_url, pkg_id, image_widget, target_size=46):
    """Asynchronously downloads and caches remote icon without blocking GTK UI."""
    local_icon = os.path.join(SYSTEM_ICONS_DIR, f"{pkg_id}.png")
    if os.path.exists(local_icon):
        try:
            import gi
            gi.require_version("GdkPixbuf", "2.0")
            from gi.repository import GdkPixbuf
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(local_icon, target_size, target_size, True)
            image_widget.set_from_pixbuf(pixbuf)
            return
        except Exception:
            pass

    if not icon_url:
        return

    url_hash = hashlib.md5(icon_url.encode("utf-8")).hexdigest()
    cached_path = os.path.join(ICON_CACHE_DIR, f"{pkg_id}_{url_hash}.png")

    def _worker():
        if not os.path.exists(cached_path) or os.path.getsize(cached_path) < 300:
            try:
                req = urllib.request.Request(icon_url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
                with urllib.request.urlopen(req, timeout=6) as resp:
                    data = resp.read()
                    with open(cached_path, "wb") as f:
                        f.write(data)
            except Exception:
                return
        try:
            from gi.repository import GdkPixbuf, GLib
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(cached_path, target_size, target_size, True)
            GLib.idle_add(image_widget.set_from_pixbuf, pixbuf)
        except Exception:
            pass

    threading.Thread(target=_worker, daemon=True).start()

def action_download(pkg_or_url, install=False, progress_cb=None):
    """Resolves and downloads APK/XAPK with integrity and Content-Length validation."""
    target = pkg_or_url.strip()
    pkg = target

    # Extract ID if Play Store link
    if "play.google.com" in target or "id=" in target:
        m = re.search(r"id=([A-Za-z0-9_.]+)", target)
        if m:
            pkg = m.group(1)

    # Check if package is already downloaded and valid
    for existing in glob.glob(os.path.join(APK_STORAGE_DIR, f"*{pkg}*")):
        if (existing.endswith(".apk") or existing.endswith(".xapk")) and zipfile.is_zipfile(existing):
            print(f"[flowork-apk] Paket valid sudah ada di penyimpanan lokal: {existing}")
            if install:
                return action_install(existing, progress_cb)
            return existing

    if progress_cb:
        progress_cb(f"Menghubungi CDN tercepat untuk '{pkg}'...", 0.1)

    # Try XAPK first for modern split APK packages, fallback to standalone APK
    resp = None
    last_err = None
    for dl_type in ["XAPK", "APK"]:
        cdn_url = f"https://d.apkpure.net/b/{dl_type}/{pkg}?version=latest"
        req = urllib.request.Request(cdn_url, headers={
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        })
        try:
            resp = urllib.request.urlopen(req, timeout=25)
            break
        except Exception as e:
            last_err = e
            continue

    if not resp:
        raise RuntimeError(f"Gagal mengunduh package '{pkg}' dari CDN: {last_err}")

    with resp:
        fname = resp.headers.get_filename() or f"{pkg}.apk"
        fname = urllib.parse.unquote(fname).replace("+", "_")
        dest_path = os.path.join(APK_STORAGE_DIR, fname)
        total_size = int(resp.headers.get("Content-Length", 0))

        if progress_cb:
            progress_cb(f"Mengunduh {fname}...", 0.15)

        with open(dest_path, "wb") as out_f:
            downloaded = 0
            while True:
                chunk = resp.read(1024 * 512)
                if not chunk:
                    break
                out_f.write(chunk)
                downloaded += len(chunk)
                if total_size > 0 and progress_cb:
                    pct = 0.15 + 0.65 * (downloaded / total_size)
                    progress_cb(f"Mengunduh {downloaded/(1024*1024):.1f}/{total_size/(1024*1024):.1f} MB ({int(pct*100)}%)...", pct)

        # Integrity verification
        if total_size > 0 and downloaded < total_size:
            if os.path.exists(dest_path):
                os.remove(dest_path)
            raise RuntimeError(f"Unduhan terputus: hanya {downloaded/(1024*1024):.1f} MB dari {total_size/(1024*1024):.1f} MB. Berkas rusak dihapus.")

        if not zipfile.is_zipfile(dest_path):
            if os.path.exists(dest_path):
                os.remove(dest_path)
            raise RuntimeError(f"Berkas '{fname}' rusak atau tidak lengkap (arsip zip/apk tidak valid). Berkas telah dibersihkan.")

    print(f"[flowork-apk] Berhasil mengunduh dan memvalidasi integritas: {dest_path}")
    if install:
        return action_install(dest_path, progress_cb)
    return dest_path

def action_install_xapk(xapk_path, progress_cb=None):
    """Installs split-APK bundle (.xapk) into the Android Desktop Subsystem."""
    import tempfile
    if progress_cb:
        progress_cb("Mengekstrak paket XAPK...", 0.1)

    if not zipfile.is_zipfile(xapk_path):
        try:
            os.remove(xapk_path)
        except Exception:
            pass
        raise RuntimeError("Berkas XAPK rusak atau terpotong.")

    temp_dir = tempfile.mkdtemp(prefix="flowork_xapk_")
    try:
        with zipfile.ZipFile(xapk_path, "r") as z:
            z.extractall(temp_dir)

        apk_files = [os.path.join(temp_dir, f) for f in os.listdir(temp_dir) if f.lower().endswith(".apk")]
        if not apk_files:
            raise RuntimeError("Tidak ada berkas APK ditemukan di dalam arsip XAPK.")

        base_apk = None
        for f in apk_files:
            basename = os.path.basename(f)
            if basename == "base.apk" or not basename.startswith("config."):
                base_apk = f
                break
        if not base_apk:
            base_apk = apk_files[0]

        meta = extract_apk_metadata(base_apk)
        package = meta["package"]
        label = meta["label"]

        if progress_cb:
            progress_cb(f"Mendaftarkan '{label}' ke Menu & Launchpad Flowork...", 0.3)
        create_desktop_entry(meta)
        reg = load_registry()
        reg[package] = meta
        save_registry(reg)

        boot_subsystem(progress_cb)

        if progress_cb:
            progress_cb(f"Memasang {label} (Split APKs)...", 0.7)

        cmd = [ADB_BIN, "install-multiple", "-r", "-i", "com.android.vending"] + apk_files
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            raise RuntimeError(f"ADB install-multiple gagal: {res.stderr or res.stdout}")

        # Bring app to foreground
        subprocess.run([ADB_BIN, "shell", "monkey", "-p", package, "-c", "android.intent.category.LAUNCHER", "1"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        launch_seamless_window(label, package)

        subprocess.run(["notify-send", "-i", meta["icon"], f"{label} Terpasang",
                        f"Aplikasi Android '{label}' siap digunakan di Flowork OS."],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if progress_cb:
            progress_cb(f"{label} siap!", 1.0)
        return meta
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

def action_install(target_path, progress_cb=None):
    if not os.path.exists(target_path):
        raise FileNotFoundError(f"File not found: {target_path}")

    if not zipfile.is_zipfile(target_path):
        try:
            os.remove(target_path)
        except Exception:
            pass
        raise RuntimeError(f"Berkas '{os.path.basename(target_path)}' rusak atau terpotong. Berkas rusak telah dibersihkan.")

    if target_path.lower().endswith(".xapk"):
        return action_install_xapk(target_path, progress_cb)

    if progress_cb:
        progress_cb("Mengekstrak metadata & ikon APK...", 0.1)
    meta = extract_apk_metadata(target_path)
    package = meta["package"]
    label = meta["label"]

    if progress_cb:
        progress_cb(f"Mendaftarkan '{label}' ke Menu & Launchpad Flowork...", 0.2)
    dest_storage = os.path.join(APK_STORAGE_DIR, f"{package}.apk")
    if os.path.abspath(target_path) != os.path.abspath(dest_storage):
        try:
            shutil.copyfile(target_path, dest_storage)
            os.chmod(dest_storage, 0o644)
            meta["apk_path"] = dest_storage
        except Exception:
            pass

    create_desktop_entry(meta)

    reg = load_registry()
    reg[package] = meta
    save_registry(reg)

    boot_subsystem(progress_cb)

    if progress_cb:
        progress_cb(f"Memasang {label} ke Android Subsystem...", 0.7)

    res = subprocess.run([ADB_BIN, "install", "-r", "-i", "com.android.vending", os.path.abspath(target_path)],
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if res.returncode != 0:
        raise RuntimeError(f"ADB install gagal: {res.stderr.strip() or res.stdout.strip()}")

    if progress_cb:
        progress_cb(f"Membuka jendela native untuk {label}...", 0.95)

    # Bring app to foreground
    subprocess.run([ADB_BIN, "shell", "monkey", "-p", package, "-c", "android.intent.category.LAUNCHER", "1"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    launch_seamless_window(label, package)

    subprocess.run(["notify-send", "-i", meta["icon"], f"{label} Terpasang",
                    f"Aplikasi Android '{label}' siap digunakan di Flowork OS."],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    if progress_cb:
        progress_cb(f"{label} siap!", 1.0)

    return meta

def get_friendly_label(pkg, default=None):
    friendly_map = {
        "com.shopee.id": "Shopee Indonesia",
        "com.lemon.lvoverseas": "CapCut Video Editor",
        "com.openai.chatgpt": "ChatGPT",
        "com.facebook.lite": "Facebook Lite",
        "com.zhiliaoapp.musically.go": "TikTok Lite",
        "com.whatsapp": "WhatsApp Messenger",
        "com.worldance.drama": "Melolo",
        "com.android.vending": "Google Play Store"
    }
    if pkg in friendly_map:
        return friendly_map[pkg]
    parts = pkg.split(".")
    return parts[-1].capitalize() if parts else (default or pkg)

def ensure_app_permissions(package):
    """Automatically provisions comprehensive media, storage, camera, audio and AppOps permissions."""
    if not package or not is_adb_online():
        return
    runtime_perms = [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
    ]
    for perm in runtime_perms:
        subprocess.run([ADB_BIN, "shell", "pm", "grant", package, perm],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    appops_modes = [
        ("MANAGE_EXTERNAL_STORAGE", "allow"),
        ("NO_ISOLATED_STORAGE", "allow"),
        ("LEGACY_STORAGE", "allow"),
        ("READ_EXTERNAL_STORAGE", "allow"),
        ("WRITE_EXTERNAL_STORAGE", "allow"),
        ("READ_MEDIA_AUDIO", "allow"),
        ("READ_MEDIA_VIDEO", "allow"),
        ("READ_MEDIA_IMAGES", "allow"),
        ("WRITE_MEDIA_AUDIO", "allow"),
        ("WRITE_MEDIA_VIDEO", "allow"),
        ("WRITE_MEDIA_IMAGES", "allow"),
        ("CAMERA", "allow"),
        ("RECORD_AUDIO", "allow")
    ]
    for op, mode in appops_modes:
        subprocess.run([ADB_BIN, "shell", "appops", "set", package, op, mode],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run([ADB_BIN, "shell", "appops", "write-settings"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def action_launch(package, progress_cb=None):
    boot_subsystem(progress_cb)
    reg = load_registry()
    meta = reg.get(package, {})
    label = meta.get("label") or get_friendly_label(package)
    activity = meta.get("activity", "")

    # Automatically grant full storage, media, camera, and appops permissions
    ensure_app_permissions(package)

    # Sync host media into guest storage and broadcast media scanner
    try:
        bridge = StorageBridge()
        bridge.sync_once()
        subprocess.run([ADB_BIN, "shell", "for f in /sdcard/Pictures/* /sdcard/Movies/* /sdcard/Download/*; do [ -f \"$f\" ] && am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d \"file://$f\"; done"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # Regional location and locale provisioning for drama and regional apps
    if package in ["com.worldance.drama", "asia.dramapendek.melolo", "com.storymatrix.drama"]:
        try:
            subprocess.run([ADB_BIN, "emu", "geo", "fix", "106.8456", "-6.2088", "10"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([ADB_BIN, "shell", "cmd", "locale", "set-app-locales", package, "--locales", "id-ID,in-ID,id"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    # Verify package is installed in Android subsystem; auto-install from local APK cache if needed (e.g. fresh Live ISO boot)
    try:
        chk = subprocess.run([ADB_BIN, "shell", "pm", "path", package], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=5)
        if not chk.stdout.strip():
            apk_candidates = [
                meta.get("apk_path"),
                os.path.join(APK_STORAGE_DIR, f"{package}.apk"),
                os.path.join(FLOWORK_ROOT, f"apk/{package}.apk")
            ]
            for apk_cand in apk_candidates:
                if apk_cand and os.path.isfile(apk_cand):
                    if progress_cb:
                        progress_cb(f"Memasang {label} ke Android Subsystem...", 0.6)
                    subprocess.run([ADB_BIN, "install", "-r", "-i", "com.android.vending", apk_cand],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
                    ensure_app_permissions(package)
                    break
    except Exception as e:
        print(f"[flowork-apk] Warning during package presence verification: {e}")

    if progress_cb:
        progress_cb(f"Membuka {label}...", 0.8)

    # Ensure Android screen is awake and unlocked
    try:
        subprocess.run([ADB_BIN, "shell", "input", "keyevent", "224"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([ADB_BIN, "shell", "input", "keyevent", "82"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    launch_seamless_window(label, package)

    if progress_cb:
        progress_cb(f"{label} aktif", 1.0)


def action_uninstall(package):
    print(f"[flowork-apk] Uninstalling {package}...")
    subprocess.run([ADB_BIN, "uninstall", package], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    reg = load_registry()
    if package in reg:
        del reg[package]
        save_registry(reg)

    desktop_name = f"flowork-apk-{package}.desktop"
    for p in [os.path.join(USER_APPS_DIR, desktop_name), os.path.join(SYSTEM_APPS_DIR, desktop_name)]:
        if os.path.exists(p):
            try:
                os.remove(p)
            except Exception:
                pass

    subprocess.run(["update-desktop-database", USER_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"✓ Application '{package}' uninstalled successfully.")

def action_stop():
    print("[flowork-apk] Menghentikan Android Subsystem...")
    try:
        subprocess.run([ADB_BIN, "emu", "kill"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(1)
    except Exception:
        pass
    subprocess.run(["pkill", "-f", f"qemu-system-.*{AVD_NAME}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["pkill", "-f", "scrcpy"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("✓ Android Subsystem dimatikan.")

def action_status():
    running = is_emulator_running()
    adb_ready = is_adb_online()
    reg = load_registry()
    profile = get_hardware_profile()

    print("==================================================")
    print("👑 FLOWORK ANDROID SUBSYSTEM STATUS")
    print("==================================================")
    print(f"• Runtime State     : {'🟢 RUNNING' if running else '🔴 STOPPED'}")
    print(f"• ADB Connectivity  : {'🟢 CONNECTED' if adb_ready else '🔴 OFFLINE'}")
    print(f"• Hardware Profile  : {profile['cores']} Cores, {profile['ram']}MB RAM, GPU: {profile['gpu']}")
    print(f"• Screen Layout     : 1600x1000 Landscape (213 DPI) / 720x1280 Portrait")
    print(f"• Windowing Mode    : Direct Hardware Scrcpy Native Window")
    print(f"• Installed Apps    : {len(reg)}")
    for pkg, info in reg.items():
        print(f"    - {info.get('label', pkg)} ({pkg})")
    if adb_ready:
