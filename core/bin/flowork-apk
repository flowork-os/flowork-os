        except Exception:
            pass
    print("==================================================")

def action_volume(val=None):
    """Sets or queries Android volume levels."""
    if not is_adb_online():
        print("[flowork-apk] Error: Android Subsystem is offline.")
        return 1
    if val is None or val in ["max", "100", "15"]:
        vol_cmd = (
            "settings put system volume_music 15; "
            "settings put system volume_music_speaker 15; "
            "settings put system volume_ring 7; "
            "settings put system volume_system 7; "
            "settings put system volume_alarm 7; "
            "settings put system volume_notification 7; "
            "settings put system volume_voice 5; "
            "settings put system volume_bluetooth_sco 15; "
            "settings put global audio_safe_volume_state 0; "
            "input keyevent 24 24 24 24 24 24 24 24 24 24 24 24 24 24 24"
        )
        subprocess.run([ADB_BIN, "shell", vol_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("✓ Volume Android diatur ke level MAKSIMAL (100% / index 15/15).")
        return 0
    elif val in ["status", "get"]:
        try:
            out = subprocess.check_output([ADB_BIN, "shell", "cmd media_session volume --stream 3 --get"], text=True)
            for line in out.splitlines():
                if "volume is" in line:
                    print(f"Android Media Volume: {line.strip().replace('[V] ', '')}")
            return 0
        except Exception as e:
            print(f"Error checking volume: {e}")
            return 1
    else:
        try:
            level = int(val)
            level = max(0, min(15, level))
            vol_cmd = (
                f"settings put system volume_music {level}; "
                f"settings put system volume_music_speaker {level}; "
                "settings put global audio_safe_volume_state 0"
            )
            subprocess.run([ADB_BIN, "shell", vol_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            down_keys = " ".join(["25"] * 15)
            up_keys = " ".join(["24"] * level)
            subprocess.run([ADB_BIN, "shell", f"input keyevent {down_keys}; input keyevent {up_keys}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"✓ Volume Android diatur ke level {level}/15.")
            return 0
        except ValueError:
            print("Penggunaan: flowork-apk volume [max|get|<0-15>]")
            return 1

class StorageBridge:
    """Bi-directional seamless bridge between Host PC folders and Android Subsystem."""
    def __init__(self, adb_bin=ADB_BIN):
        self.adb = adb_bin
        self.mappings = [
            (os.path.join(HOME_DIR, "Pictures"), "/sdcard/Pictures", True),
            (os.path.join(HOME_DIR, "Music"), "/sdcard/Music", True),
            (os.path.join(HOME_DIR, "Videos"), "/sdcard/Movies", True),
            (os.path.join(HOME_DIR, "Downloads"), "/sdcard/Download", False),
            (os.path.join(HOME_DIR, "Documents"), "/sdcard/Documents", False)
        ]
        self.synced_host_files = {}
        self.synced_guest_files = set()
        self._running = False
        self._dirs_ensured = False

    def ensure_guest_dirs(self):
        if not self._dirs_ensured and is_adb_online():
            try:
                subprocess.run([self.adb, "shell", "mkdir", "-p",
                                "/sdcard/Pictures", "/sdcard/Music", "/sdcard/Movies",
                                "/sdcard/Download", "/sdcard/Documents"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self._dirs_ensured = True
            except Exception:
                pass

    def sync_once(self):
        if not is_adb_online():
            return
        self.ensure_guest_dirs()
        for host_dir, guest_dir, is_media in self.mappings:
            os.makedirs(host_dir, exist_ok=True)
            try:
                # 1. Host -> Guest sync
                for entry in os.scandir(host_dir):
                    if entry.is_file() and not entry.name.startswith("."):
                        mtime = entry.stat().st_mtime
                        size = entry.stat().st_size
                        if size > 512 * 1024 * 1024:
                            continue
                        last_sync = self.synced_host_files.get((host_dir, entry.name))
                        if last_sync is None or mtime > last_sync + 1:
                            target_guest = f"{guest_dir}/{entry.name}"
                            subprocess.run([self.adb, "push", entry.path, target_guest],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            if is_media:
                                subprocess.run([self.adb, "shell", "am", "broadcast", "-a",
                                                "android.intent.action.MEDIA_SCANNER_SCAN_FILE",
                                                "-d", f"file://{target_guest}"],
                                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            self.synced_host_files[(host_dir, entry.name)] = mtime
                            self.synced_guest_files.add((guest_dir, entry.name))

                # 2. Guest -> Host sync
                out = subprocess.check_output([self.adb, "shell", f"ls -1 {guest_dir} 2>/dev/null"],
                                             text=True, stderr=subprocess.DEVNULL).strip()
                if out:
                    for fname in out.splitlines():
                        fname = fname.strip()
                        if not fname or fname.startswith(".") or (guest_dir, fname) in self.synced_guest_files:
                            continue
                        dest_local = os.path.join(host_dir, fname)
                        if not os.path.exists(dest_local):
                            subprocess.run([self.adb, "pull", f"{guest_dir}/{fname}", dest_local],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            if os.path.exists(dest_local):
                                self.synced_host_files[(host_dir, fname)] = os.path.getmtime(dest_local)
                                self.synced_guest_files.add((guest_dir, fname))
            except Exception:
                pass

    def run_loop(self):
        self._running = True
        while self._running:
            time.sleep(3)
            self.sync_once()

    def start(self):
        t = threading.Thread(target=self.run_loop, daemon=True)
        t.start()
        return t

class PlayStorePackageWatcher:
    """Monitors Android subsystem for packages installed via Google Play Store or APK installs.
    Automatically pulls raw APK to /opt/floworkos/apk/, extracts icon, generates .desktop entry,
    and updates Linux menus so the app is immediately available as a native Linux application."""
    def __init__(self, adb_bin=ADB_BIN):
        self.adb = adb_bin
        self.apk_dir = APK_STORAGE_DIR
        self._running = False
        self.known_packages = set()

    def get_installed_third_party_packages(self):
        ignored = {
            "com.android.vending", "com.google.android.safetycore",
            "com.google.android.contactkeys", "com.google.android.verifier",
            "com.google.android.gms", "com.google.android.gsf"
        }
        try:
            res = subprocess.run([self.adb, "shell", "pm", "list", "packages", "-3"],
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
            if res.returncode != 0:
                return set()
            pkgs = set()
            for line in res.stdout.splitlines():
                line = line.strip()
                if line.startswith("package:"):
                    pkg = line[len("package:"):].strip()
                    if pkg and pkg not in ignored:
                        pkgs.add(pkg)
            return pkgs
        except Exception:
            return set()

    def sync_new_packages(self):
        if not is_adb_online():
            return

        current_pkgs = self.get_installed_third_party_packages()
        for pkg in current_pkgs:
            dest_apk = os.path.join(self.apk_dir, f"{pkg}.apk")
            if not os.path.exists(dest_apk):
                try:
                    self.archive_package(pkg)
                    self.known_packages.add(pkg)
                except Exception as e:
                    print(f"[flowork-apk] Error archiving package {pkg}: {e}")

    def archive_package(self, pkg):
        print(f"[flowork-apk] New Play Store package detected: {pkg}")
        try:
            out = subprocess.check_output([self.adb, "shell", "pm", "path", pkg], text=True, stderr=subprocess.DEVNULL).strip()
        except Exception:
            return

        apk_guest_paths = []
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("package:"):
                apk_guest_paths.append(line[len("package:"):].strip())

        if not apk_guest_paths:
            return

        base_path = apk_guest_paths[0]
        for p in apk_guest_paths:
            if "base.apk" in p:
                base_path = p
                break

        tmp_pull = f"/tmp/{pkg}_playstore.apk"
        try:
            subprocess.run([self.adb, "pull", base_path, tmp_pull],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
            if not os.path.exists(tmp_pull) or os.path.getsize(tmp_pull) == 0:
                return

            dest_apk = os.path.join(self.apk_dir, f"{pkg}.apk")
            shutil.copyfile(tmp_pull, dest_apk)
            try:
                os.chmod(dest_apk, 0o644)
            except Exception:
                pass
            if os.path.exists(tmp_pull):
                os.remove(tmp_pull)

            meta = extract_apk_metadata(dest_apk)
            create_desktop_entry(meta)

            reg = load_registry()
            reg[pkg] = meta
            save_registry(reg)

            app_title = meta.get("label", pkg)
            subprocess.run([
                "notify-send", "-i", meta.get("icon", DEFAULT_ICON),
                f"{app_title} Terpasang",
                f"Aplikasi Play Store '{app_title}' otomatis diarsipkan ke /opt/floworkos/apk dan siap dibuka dari Menu Linux."
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"[flowork-apk] Successfully archived {app_title} to {dest_apk} and registered to desktop.")
        except Exception as e:
            print(f"[flowork-apk] Failed to archive {pkg}: {e}")
            if os.path.exists(tmp_pull):
                try:
                    os.remove(tmp_pull)
                except Exception:
                    pass

    def run_loop(self):
        self._running = True
        while self._running:
            time.sleep(5)
            self.sync_new_packages()

    def start(self):
        t = threading.Thread(target=self.run_loop, daemon=True)
        t.start()
        return t

def auto_restore_archived_apks():
    """Restores any APKs present in /opt/floworkos/apk into the Android subsystem if not installed."""
    if not is_adb_online():
        return
    try:
        res = subprocess.run([ADB_BIN, "shell", "pm", "list", "packages", "-3"],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        installed = set()
        for line in res.stdout.splitlines():
            if line.startswith("package:"):
                installed.add(line[len("package:"):].strip())

        for apk_path in glob.glob(os.path.join(APK_STORAGE_DIR, "*.apk")):
            try:
                pkg_name = os.path.splitext(os.path.basename(apk_path))[0]
                if pkg_name not in installed:
                    meta = extract_apk_metadata(apk_path)
                    actual_pkg = meta.get("package", pkg_name)
                    if actual_pkg not in installed:
                        print(f"[flowork-apk] Restoring archived APK into subsystem: {actual_pkg}...")
                        subprocess.run([ADB_BIN, "install", "-r", "-g", "-i", "com.android.vending", apk_path],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        create_desktop_entry(meta)
            except Exception:
                pass
    except Exception:
        pass

def action_daemon():
    """Runs the Android Subsystem in standby daemon mode for instant cold app launches."""
    print("[flowork-apk] Starting Flowork Android Subsystem Standby Daemon...")
    ready_file = f"/run/user/{os.getuid()}/flowork-apk-ready"
    if os.path.exists(ready_file):
        try:
            os.remove(ready_file)
        except Exception:
            pass

    boot_subsystem()
    with open(ready_file, "w") as f:
        f.write("1\n")
    print("[flowork-apk] Android Subsystem is warm and ready for instant app launches.")

    # Launch storage bridge for real-time Pictures, Downloads, Music, Videos & Documents synchronization
    bridge = StorageBridge()
    bridge.start()
    print("[flowork-apk] Storage Bridge online: ~/Pictures, ~/Downloads, ~/Music, ~/Videos & ~/Documents seamlessly integrated.")

    # Launch Play Store automatic package archiver
    watcher = PlayStorePackageWatcher()
    watcher.start()
    print("[flowork-apk] Play Store Watcher online: New installs automatically archived to /opt/floworkos/apk.")

    # Auto-restore any archived APKs into the running subsystem in background
    threading.Thread(target=auto_restore_archived_apks, daemon=True).start()

    try:
        while True:
            time.sleep(10)
            if not is_emulator_running() or not is_adb_online():
                print("[flowork-apk] Notice: Subsystem dropped, auto-recovering...")
                if os.path.exists(ready_file):
                    try:
                        os.remove(ready_file)
                    except Exception:
                        pass
                boot_subsystem()
                with open(ready_file, "w") as f:
                    f.write("1\n")
                threading.Thread(target=auto_restore_archived_apks, daemon=True).start()
    except KeyboardInterrupt:
        print("[flowork-apk] Subsystem daemon stopping...")
        if os.path.exists(ready_file):
            try:
                os.remove(ready_file)
            except Exception:
                pass



