#!/opt/floworkos/apps/camoufox/venv/bin/python3
"""
Flowork OS - Thin L0 Cognitive Router & SLM CLI Client (flowork-slm / flowork-archon)
Routes prompts, triage, privacy redaction, and on-demand GGUF management to flowork-sysd (:18090).
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

SYSD_URL = os.environ.get("FLOWORK_SYSD_URL", "http://127.0.0.1:18090").rstrip("/")
MODELS_DIR = os.environ.get("FLOWORK_MODELS_DIR", "/opt/floworkos/models")

MODEL_PRESETS = {
    "qwen2.5-0.5b": (
        "https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf"
    ),
    "qwen2.5-coder-1.5b": (
        "https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf"
    ),
}


def http_json(method: str, path: str, payload: dict | None = None, timeout: float = 12.0) -> dict | None:
    url = f"{SYSD_URL}{path}"
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    headers = {"Accept": "application/json"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, ValueError, OSError):
        return None


def local_failsafe_infer(prompt: str, model_name: str) -> dict:
    p = prompt.strip()
    p_lower = p.lower()
    tool_traces = []
    if "remix" in p_lower or "modifikasi app" in p_lower:
        words = p_lower.split()
        target_app = "crypto-radar"
        for i, w in enumerate(words):
            if w == "remix" and i + 1 < len(words):
                target_app = "".join(c for c in words[i + 1] if c.isalnum() or c == "-") or "crypto-radar"
                break
        res = subprocess.run(["/opt/floworkos/bin/flowpkg", "remix", target_app, "--inspect"], capture_output=True, text=True)
        response = f"[L0 Offline Failsafe] Initiated Remix Studio for [{target_app}]:\n{res.stdout.strip()}"
        tool_traces.append({"tool": "flowpkg_remix", "target": target_app, "status": "success"})
    elif any(k in p_lower for k in ["layar", "screenshot", "screen", "tangkapan layar"]):
        query = p.strip() or "Desktop"
        res = subprocess.run(["/opt/floworkos/bin/flowfs-search", "--screen", query, "--json"], capture_output=True, text=True)
        matches = []
        if res.returncode == 0:
            try:
                matches = json.loads(res.stdout).get("results", [])
            except Exception:
                pass
        response = f"[L0 Offline Failsafe] FlowFS Screen Memory retrieved {len(matches)} visual moment(s)."
        tool_traces.append({"tool": "flowfs_screen_search", "query": query, "matches": matches})
    elif any(k in p_lower for k in ["cari file", "temukan dokumen", "search file", "find file"]):
        query = p.strip() or "flowork"
        res = subprocess.run(["/opt/floworkos/bin/flowfs-search", query, "--json"], capture_output=True, text=True)
        matches = []
        if res.returncode == 0:
            try:
                matches = json.loads(res.stdout).get("results", [])
            except Exception:
                pass
        response = f"[L0 Offline Failsafe] FlowFS found {len(matches)} relevant document(s)."
        tool_traces.append({"tool": "flowfs_search", "query": query, "matches": matches})
    elif any(k in p_lower for k in ["cek sistem", "audit", "health", "kesehatan"]):
        res = subprocess.run(["/opt/floworkos/bin/flowork-sentinel-daemon", "--audit"], capture_output=True, text=True)
        response = f"[L0 Offline Failsafe] Flowork Sentinel Diagnostic Audit:\n{res.stdout.strip()}"
        tool_traces.append({"tool": "sentinel_audit", "status": "healthy"})
    else:
        response = (
            "[Flowork OS L0 Embedded SLM - Failsafe Mode]\n"
            f"Prompt received: \"{p}\"\n"
            "flowork-sysd (:18090) was unreachable; running in isolated CLI failsafe mode."
        )
    return {
        "success": True,
        "response": response,
        "tool_traces": tool_traces,
        "model": f"{model_name}-failsafe",
        "backend": "cli-failsafe",
    }


def mem_available_mb() -> int:
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemAvailable:"):
                    parts = line.split()
                    if len(parts) >= 2:
                        return int(parts[1]) // 1024
    except OSError:
        pass
    return 0


def cmd_pull_model(preset: str, custom_url: str | None, dest: str | None, dry_run: bool, force: bool, json_mode: bool) -> int:
    url = custom_url or MODEL_PRESETS.get(preset)
    if not url:
        print(f"Unknown preset '{preset}'. Available: {', '.join(MODEL_PRESETS.keys())}", file=sys.stderr)
        return 1

    target_dir = os.path.dirname(dest) if dest else MODELS_DIR
    target_path = dest or os.path.join(MODELS_DIR, "l0-router.gguf")
    os.makedirs(target_dir, exist_ok=True)

    avail_mb = mem_available_mb()
    free_bytes = shutil.disk_usage(target_dir).free
    free_mb = free_bytes // (1024 * 1024)

    if avail_mb and avail_mb < 1200 and not force:
        err = f"Memory pressure guard: MemAvailable={avail_mb} MB (< 1200 MB). Pass --force to override."
        if json_mode:
            print(json.dumps({"success": False, "error": err, "mem_available_mb": avail_mb}, indent=2))
        else:
            print(err, file=sys.stderr)
        return 1

    if free_mb < 1500 and not force:
        err = f"Insufficient disk space in {target_dir}: {free_mb} MB free (< 1500 MB). Pass --force to override."
        if json_mode:
            print(json.dumps({"success": False, "error": err, "disk_free_mb": free_mb}, indent=2))
        else:
            print(err, file=sys.stderr)
        return 1

    if dry_run:
        info = {
            "success": True,
            "dry_run": True,
            "preset": preset,
            "url": url,
            "destination": target_path,
            "mem_available_mb": avail_mb,
            "disk_free_mb": free_mb,
        }
        if json_mode:
            print(json.dumps(info, indent=2))
        else:
            print(f"[Dry-Run] Would download {preset} from {url} -> {target_path} (MemAvailable={avail_mb} MB, Free={free_mb} MB)")
        return 0

    tmp_path = f"{target_path}.downloading.tmp"
    print(f"[Flowork SLM] Downloading L0 model ({preset}) -> {target_path}")
    print(f"              Source: {url}")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "FloworkOS-SLM-Fetcher/1.0"})
        with urllib.request.urlopen(req, timeout=60) as resp:
            total = int(resp.headers.get("Content-Length") or 0)
            downloaded = 0
            chunk_size = 1024 * 1024
            with open(tmp_path, "wb") as out_f:
                first_chunk = True
                while True:
                    chunk = resp.read(chunk_size)
                    if not chunk:
                        break
                    if first_chunk:
                        if not chunk.startswith(b"GGUF"):
                            raise ValueError("Downloaded stream does not start with valid GGUF magic header")
                        first_chunk = False
                    out_f.write(chunk)
                    downloaded += len(chunk)
                    if sys.stdout.isatty() and total > 0:
                        pct = (downloaded * 100) // total
                        print(f"\r              Progress: {downloaded // (1024*1024)} MB / {total // (1024*1024)} MB ({pct}%)", end="", flush=True)
            if sys.stdout.isatty():
                print()
        os.replace(tmp_path, target_path)
    except Exception as exc:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
        if json_mode:
            print(json.dumps({"success": False, "error": str(exc)}, indent=2))
        else:
            print(f"[Flowork SLM] Download failed: {exc}", file=sys.stderr)
        return 1

    size_mb = os.path.getsize(target_path) // (1024 * 1024)
    status = http_json("GET", "/api/agent/l0/status")
    result = {
        "success": True,
        "preset": preset,
        "destination": target_path,
        "size_mb": size_mb,
        "sysd_status": status,
    }
    if json_mode:
        print(json.dumps(result, indent=2))
    else:
        print(f"[Flowork SLM] Installed {target_path} ({size_mb} MB).")
    return 0


def emit(data: dict, json_mode: bool, primary_key: str = "response") -> int:
    if json_mode:
        print(json.dumps(data, indent=2))
    else:
        val = data.get(primary_key)
        if val is None:
            print(json.dumps(data, indent=2))
        else:
            print(val)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Flowork Sovereign L0 Embedded SLM Client (:18090)")
    parser.add_argument("prompt", nargs="?", default="", help="Natural language prompt or command")
    parser.add_argument("--json", action="store_true", help="Output result as JSON object")
    parser.add_argument("--model", default="l0-router", help="Model identifier")
    parser.add_argument("--triage", action="store_true", help="Run L0 intent triage only without local execution")
    parser.add_argument("--redact", action="store_true", help="Run Privacy Shield secret scrubbing on input text")
    parser.add_argument("--status", action="store_true", help="Query live flowork-sysd L0 SLM runtime status")
    parser.add_argument("--unload", action="store_true", help="Unload cached GGUF weights from flowork-sysd RAM")
    parser.add_argument("--pull-model", action="store_true", help="Download lightweight Q4 GGUF model to /opt/floworkos/models/l0-router.gguf")
    parser.add_argument("--preset", default="qwen2.5-0.5b", choices=list(MODEL_PRESETS.keys()), help="GGUF preset for --pull-model")
    parser.add_argument("--url", default=None, help="Custom GGUF download URL for --pull-model")
    parser.add_argument("--dest", default=None, help="Custom output path for --pull-model")
    parser.add_argument("--dry-run", action="store_true", help="Check prerequisites without downloading")
    parser.add_argument("--force", action="store_true", help="Bypass memory/disk safety guard")

    args = parser.parse_args()

    if args.pull_model:
        return cmd_pull_model(args.preset, args.url, args.dest, args.dry_run, args.force, args.json)

    if args.status:
        res = http_json("GET", "/api/agent/l0/status")
        if res is None:
            res = {
                "success": False,
                "sysd_online": False,
                "models_dir": MODELS_DIR,
                "mem_available_mb": mem_available_mb(),
            }
            emit(res, args.json, primary_key="sysd_online")
            return 1
        return emit(res, args.json, primary_key="model_path")

    if args.unload:
        res = http_json("POST", "/api/agent/l0/unload", {})
        if res is None:
            print("flowork-sysd (:18090) unreachable.", file=sys.stderr)
            return 1
        return emit(res, args.json, primary_key="success")

    if args.redact:
        if not args.prompt.strip():
            parser.print_help()
            return 0
        res = http_json("POST", "/api/agent/privacy/redact", {"text": args.prompt})
        if res is None:
            print("flowork-sysd (:18090) unreachable for privacy redaction.", file=sys.stderr)
            return 1
        return emit(res, args.json, primary_key="sanitized_text")

    if not args.prompt.strip():
        parser.print_help()
        return 0

    if args.triage:
        res = http_json("POST", "/api/agent/l0/triage", {"prompt": args.prompt, "execute": False})
        if res is None:
            print("flowork-sysd (:18090) unreachable for triage.", file=sys.stderr)
            return 1
        return emit(res, args.json, primary_key="intent")

    res = http_json("POST", "/api/agent/ai/chat", {"prompt": args.prompt, "model": args.model})
    if res and res.get("success") is True:
        return emit(res, args.json, primary_key="response")

    fallback = local_failsafe_infer(args.prompt, args.model)
    return emit(fallback, args.json, primary_key="response")


if __name__ == "__main__":
    sys.exit(main())
