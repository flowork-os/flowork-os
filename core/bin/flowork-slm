#!/opt/floworkos/apps/camoufox/venv/bin/python3
"""
👑 FLOWORK OS — EMBEDDED SOVEREIGN OFFLINE SLM RUNNER (flowork-slm / flowork-archon)
Air-Gapped Natural Language Tool Routing & Intent Synthesis Engine
"""

import os
import sys
import json
import argparse
import subprocess

def run_offline_slm(prompt: str, model_name: str = "flowork-offline-slm", json_mode: bool = False):
    p = prompt.strip()
    p_lower = p.lower()
    tool_traces = []
    response = ""

    # 1. App Remix Intent
    if "remix" in p_lower or "modifikasi app" in p_lower:
        words = p_lower.split()
        target_app = "crypto-radar"
        for i, w in enumerate(words):
            if w == "remix" and i + 1 < len(words):
                target_app = "".join(c for c in words[i+1] if c.isalnum() or c == '-')
                break

        res = subprocess.run(["/opt/floworkos/bin/flowpkg", "remix", target_app, "--inspect"], capture_output=True, text=True)
        response = f"🛠️ [Offline SLM] Initiated Remix Studio for [{target_app}]:\n{res.stdout.strip()}"
        tool_traces.append({"tool": "flowpkg_remix", "target": target_app, "status": "success"})

    # 2. Screen Memory Intent
    elif any(k in p_lower for k in ["layar", "screenshot", "screen"]):
        clean_q = p_lower
        for word in ["cari layar", "ingat layar", "screen", "screenshot"]:
            clean_q = clean_q.replace(word, "")
        query = clean_q.strip() or "Desktop"

        res = subprocess.run(["/opt/floworkos/bin/flowfs-search", "--screen", query, "--json"], capture_output=True, text=True)
        matches = []
        if res.returncode == 0:
            try:
                data = json.loads(res.stdout)
                matches = data.get("results", [])
            except Exception:
                pass
        response = f"👁️ [Offline SLM] FlowFS Screen Memory retrieved {len(matches)} visual moment(s) for query '{query}'."
        tool_traces.append({"tool": "flowfs_screen_search", "query": query, "matches": matches})

    # 3. File Semantic Search Intent
    elif any(k in p_lower for k in ["cari file", "temukan dokumen", "search file"]):
        clean_q = p_lower
        for word in ["cari file", "temukan dokumen", "search file"]:
            clean_q = clean_q.replace(word, "")
        query = clean_q.strip() or "flowork"

        res = subprocess.run(["/opt/floworkos/bin/flowfs-search", query, "--json"], capture_output=True, text=True)
        matches = []
        if res.returncode == 0:
            try:
                data = json.loads(res.stdout)
                matches = data.get("results", [])
            except Exception:
                pass
        response = f"🧠 [Offline SLM] FlowFS found {len(matches)} relevant document(s) for '{query}'."
        tool_traces.append({"tool": "flowfs_search", "query": query, "matches": matches})

    # 4. System Health / Sentinel Audit
    elif any(k in p_lower for k in ["cek sistem", "audit", "health", "kesehatan"]):
        res = subprocess.run(["/opt/floworkos/bin/flowork-sentinel-daemon", "--audit"], capture_output=True, text=True)
        response = f"🛡️ [Offline SLM] Flowork Sentinel Diagnostic Audit:\n{res.stdout.strip()}"
        tool_traces.append({"tool": "sentinel_audit", "status": "healthy"})

    # 5. Application Launch
    elif p_lower.startswith(("buka ", "jalankan ", "launch ")):
        words = p.split()
        app_name = words[1] if len(words) > 1 else "cadcraft"
        subprocess.Popen(["/opt/floworkos/bin/flowork-launch", app_name])
        response = f"🚀 [Offline SLM] Dispatched launch command for [{app_name}] detached via flowork-launch."
        tool_traces.append({"tool": "flowork_launch", "app": app_name, "detached": True})

    # 6. Default Fallback
    else:
        response = (
            f"👑 [Flowork OS Offline SLM — Air-Gapped Mode]\n"
            f"Prompt received: \"{p}\"\n"
            f"Network status: Air-Gapped Sovereign Fallback\n"
            f"Supported intent prefixes:\n"
            f"  • \"cari file <keyword>\" (FlowFS Semantic Search)\n"
            f"  • \"cari layar <context>\" (FlowFS Screen Memory)\n"
            f"  • \"remix <app_id>\" (Instant App Remix Studio)\n"
            f"  • \"buka <app_id>\" (Detached Application Launch)\n"
            f"  • \"cek sistem\" (Kernel Sentinel Diagnostics)"
        )

    output_payload = {
        "success": True,
        "response": response,
        "tool_traces": tool_traces,
        "model": f"{model_name}-airgapped"
    }

    if json_mode:
        print(json.dumps(output_payload, indent=2))
    else:
        print(response)

    return 0


def main():
    parser = argparse.ArgumentParser(description="Flowork Sovereign Embedded Offline SLM Runner")
    parser.add_argument("prompt", nargs="?", default="", help="Natural language prompt or task directive")
    parser.add_argument("--json", action="store_true", help="Output result as JSON object")
    parser.add_argument("--model", default="flowork-offline-slm", help="Model identifier")

    args = parser.parse_args()
    if not args.prompt.strip():
        parser.print_help()
        return 0

    return run_offline_slm(args.prompt, model_name=args.model, json_mode=args.json)


if __name__ == "__main__":
    sys.exit(main())
