def resolve_user_home():
    """Dynamically resolves the current active user home path without hardcoding."""
    home = os.environ.get("HOME")
    if not home or not os.path.exists(home):
        home = str(Path.home())
    return home

def find_devto_config():
    """Locates devto.txt or devto in user's Downloads directory."""
    home = resolve_user_home()
    downloads_dir = os.path.join(home, "Downloads")
    
    candidates = [
        os.path.join(downloads_dir, "devto.txt"),
        os.path.join(downloads_dir, "devto")
    ]
    
    for c in candidates:
        if os.path.exists(c):
            return c
    return None

def parse_devto_file(file_path):
    """Extracts API key and existing published titles from devto.txt."""
    if not file_path or not os.path.exists(file_path):
        return None, []
        
    api_key = ""
    existing_titles = []
    
    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
        lines = [l.strip() for l in f if l.strip()]
        
    for line in lines:
        if line.startswith("#"):
            continue
        # Check if line looks like Dev.to API Key (24 alphanumeric chars)
        if not api_key and len(line) >= 20 and len(line) <= 32 and " " not in line and not line.startswith("-"):
            api_key = line
            continue
        # Extract titles
        clean_title = line.lstrip("- *0123456789.)").strip()
        if clean_title and clean_title != api_key:
            # Also strip optional [url] or date suffix
            clean_title = clean_title.split(" (http")[0].split(" | ")[0].strip()
            if len(clean_title) > 5:
                existing_titles.append(clean_title.lower())
                
    return api_key, existing_titles

def record_published_title(title, article_url, used_file_path):
    """Records the newly published title in devto.txt to avoid duplicate themes."""
    home = resolve_user_home()
    downloads_dir = os.path.join(home, "Downloads")
    devtotxt = os.path.join(downloads_dir, "devto.txt")
    devto_bare = os.path.join(downloads_dir, "devto")
    
    target_files = set()
    if used_file_path and os.path.exists(used_file_path):
        target_files.add(used_file_path)
    target_files.add(devtotxt)
    
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    entry_line = f"- {title} | {article_url} ({timestamp})\n"
    
    for tf in target_files:
        try:
            if not os.path.exists(tf):
                # Initialize with API key if copying from another
                api_key, _ = parse_devto_file(used_file_path)
                with open(tf, "w", encoding="utf-8") as f:
                    if api_key:
                        f.write(f"{api_key}\n\n")
                    f.write("# Published Article Titles (Deduplication History):\n")
                    
            with open(tf, "a", encoding="utf-8") as f:
                f.write(entry_line)
        except Exception as e:
            print(f"{AMBER}[WARN] Failed to write history to {tf}: {e}{RESET}")

def emit_active_watchdog_signal(title, article_url):
    """Notifies Mr. Flow via active watchdog IPC signal."""
    try:
        now_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()
        payload = {
            "active": True,
            "source": "DEVTO_SEO_AUTOPUBLISHER",
            "instruction": f"⚡ DEV.TO ARTICLE PUBLISHED: '{title}' is now live with backlinks to floworkos.com and GitHub! Live URL: {article_url}",
            "timestamp": now_iso
        }
        with open(ACTIVE_TRIGGER_FILE, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2)
    except Exception as e:
        print(f"{AMBER}[WARN] Failed to emit active watchdog signal: {e}{RESET}")

def pick_next_topic(existing_titles):
    """Picks a fresh, non-overlapping topic from the SEO catalog."""
    normalized_existing = [t.lower() for t in existing_titles]
    available = []
    
    for topic in ARTICLE_TOPICS:
        t_low = topic["title"].lower()
        # Check title overlap or partial similarity
        is_used = False
        for ex in normalized_existing:
            if t_low in ex or ex in t_low:
                is_used = True
                break
        if not is_used:
            available.append(topic)
            
    if available:
        return available[0]
    
    # If all curated topics used, generate dynamic variation
    variation_count = len(existing_titles) + 1
    base_topic = random.choice(ARTICLE_TOPICS)
    dyn_topic = dict(base_topic)
    dyn_topic["title"] = f"{base_topic['title']} (Part {variation_count})"
    return dyn_topic

def publish_article(api_key, topic):
    """Publishes the article directly to Dev.to API with published: true."""
    title = topic["title"]
    body = topic["content_generator"]()
    tags = topic.get("tags", ["ai", "linux", "opensource", "programming"])
    summary = topic.get("summary", "")
    
    payload = {
        "article": {
            "title": title,
            "published": True,
            "body_markdown": body,
            "tags": tags[:4],
            "description": summary
        }
    }
    
    req = urllib.request.Request(
        "https://dev.to/api/articles",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "api-key": api_key,
            "User-Agent": "Flowork-OS-DevTo-Publisher/1.0 (+https://floworkos.com)"
        },
        method="POST"
    )
    
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="ignore")
        raise RuntimeError(f"Dev.to API error HTTP {e.code}: {err_msg}")
    except Exception as e:
        raise RuntimeError(f"Network error communicating with Dev.to: {e}")

def main():
    print(f"{BOLD}{CYAN}================================================================{RESET}")
    print(f"{BOLD}{GREEN}  👑 FLOWORK OS — AUTONOMOUS DEV.TO SEO ARTICLE PUBLISHER       {RESET}")
    print(f"{BOLD}{CYAN}================================================================{RESET}")
    
    cfg_file = find_devto_config()
    if not cfg_file:
        print(f"{MUTED}[INFO] devto.txt not found in Downloads directory. Trigger inactive.{RESET}")
        sys.exit(0)
        
    api_key, existing_titles = parse_devto_file(cfg_file)
    if not api_key:
        print(f"{RED}[ERROR] devto.txt found at {cfg_file} but no valid API key was parsed.{RESET}")
        sys.exit(1)
        
    print(f"{CYAN}✓ Configuration located:{RESET} {cfg_file}")
    print(f"{CYAN}✓ API Key detected:{RESET} {api_key[:4]}...{api_key[-4:]}")
    print(f"{CYAN}✓ Previously published titles:{RESET} {len(existing_titles)}")
    for i, t in enumerate(existing_titles, 1):
        print(f"   {i}. {t}")
        
    # Check flags
    if "--check" in sys.argv:
        print(f"{GREEN}✓ Pre-flight check passed! Publisher is fully primed.{RESET}")
        sys.exit(0)
        
    selected_topic = pick_next_topic(existing_titles)
    print(f"\n{BOLD}{CYAN}[Topic Selected for Publication]:{RESET}")
    print(f"  {BOLD}Title:{RESET} {selected_topic['title']}")
    print(f"  {BOLD}Tags:{RESET}  {', '.join(selected_topic['tags'])}")
    print(f"  {BOLD}Links:{RESET} https://floworkos.com/ & https://github.com/flowork-os/flowork-os")
    
    if "--dry-run" in sys.argv:
        print(f"\n{AMBER}[DRY-RUN COMPLETE] Article generated without calling Dev.to API.{RESET}")
        sys.exit(0)
        
    print(f"\n{BOLD}{CYAN}[Publishing to Dev.to...]{RESET}")
    try:
        res = publish_article(api_key, selected_topic)
        article_url = res.get("url", f"https://dev.to/mr_flow/{res.get('slug', '')}")
        article_id = res.get("id")
        
        print(f"{BOLD}{GREEN}================================================================{RESET}")
        print(f"{BOLD}{GREEN}  ✓ ARTICLE PUBLISHED DIRECTLY TO DEV.TO!                       {RESET}")
        print(f"  {BOLD}Title:{RESET}       {selected_topic['title']}")
        print(f"  {BOLD}Live URL:{RESET}    {article_url}")
        print(f"  {BOLD}Article ID:{RESET}  {article_id}")
        print(f"  {BOLD}Status:{RESET}      Published (Live)")
        print(f"{BOLD}{GREEN}================================================================{RESET}")
        
        record_published_title(selected_topic["title"], article_url, cfg_file)
        emit_active_watchdog_signal(selected_topic["title"], article_url)
        print(f"{GREEN}✓ Title recorded in devto.txt to avoid duplicate topics.{RESET}")
        print(f"{GREEN}✓ Active watchdog signal emitted to /tmp/flowork_active_trigger.json.{RESET}\n")
        
    except Exception as e:
        print(f"{RED}[ERROR] Failed to publish article: {e}{RESET}")
        sys.exit(1)

if __name__ == "__main__":
    main()
