#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — DownFlow Sovereign Accelerator & Torrent Manager
# ==============================================================================

set -e

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

BIN="/opt/floworkos/apps/downflow/misterdownloadmanager"

if [ ! -x "$BIN" ]; then
    echo "Error: DownFlow binary not found at $BIN" >&2
    exit 1
fi

exec "$BIN" "$@"
