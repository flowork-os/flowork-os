#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — SOVEREIGN UNIVERSAL DETACHED APPLICATION LAUNCHER (flowork-launch)
# Guarantees instant subshell fallback (<0.3s) and zero agent hanging.
# Detaches GUI apps, redirects file descriptors, and audits initial spawn health.
# ==============================================================================

set -e

if [ -z "$1" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "Usage: flowork-launch [--remix] <app_binary_or_id> [args...]"
    echo "Guarantees detached execution (<0.3s) and zero agent blocking."
    exit 0
fi

if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    echo "flowork-launch 1.2.0 (Flowork Sovereign OS)"
    exit 0
fi

# Intercept --remix action flag
if [ "$1" = "--remix" ] || [ "$1" = "-r" ]; then
    shift
    if [ -z "${1:-}" ]; then
        echo "Usage: flowork-launch --remix <app_id> [--inspect] [--prompt ...]" >&2
        exit 1
    fi
    RAW_TARGET="$1"
    shift
    APP_TARGET=$(basename "$RAW_TARGET" .desktop)
    APP_TARGET="${APP_TARGET#flowork-}"

    python3 -c 'import json,sys; print(json.dumps({"status":"remixing","app":sys.argv[1]}))' "$APP_TARGET"

    # 1. Desktop notification
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i "system-software-install" "Mr. Flow Remix Studio" "Opening remix session for $APP_TARGET..." >/dev/null 2>&1 || true
    fi

    # 2. Publish event over Neural Bus
    python3 -c "
import urllib.request, json, os, sys
try:
    port = os.environ.get('FLOWORK_BUS_PORT', '18095')
    url = f'http://127.0.0.1:{port}/api/bus/publish'
    req = urllib.request.Request(url, data=json.dumps({'type': 'app.open_remix_stage', 'app_id': sys.argv[1]}).encode('utf-8'))
    req.add_header('Content-Type', 'application/json')
    with urllib.request.urlopen(req, timeout=2) as _: pass
except Exception: pass
" "$APP_TARGET" >/dev/null 2>&1 || true

    # 3. Execute remix CLI studio forwarding extra flags (--inspect, --prompt, etc.)
    exec /opt/floworkos/bin/flowpkg remix "$APP_TARGET" "$@"
fi

TARGET="$1"
shift
ARGS=("$@")

# Resolve application target if given ID or relative name
CMD=""
if [ -x "$TARGET" ]; then
    CMD="$TARGET"
elif [ -x "/opt/floworkos/bin/$TARGET" ]; then
    CMD="/opt/floworkos/bin/$TARGET"
elif [ -x "/usr/local/bin/$TARGET" ]; then
    CMD="/usr/local/bin/$TARGET"
elif command -v "$TARGET" >/dev/null 2>&1; then
    CMD="$(command -v "$TARGET")"
else
    echo "❌ Error: Application executable '$TARGET' not found." >&2
    exit 127
fi

export DISPLAY="${DISPLAY:-:0}"
APP_ID=$(basename "$TARGET" .desktop)
APP_ID="${APP_ID#flowork-}"
MANIFEST_PATH="/opt/floworkos/apps/${APP_ID}/manifest.json"
if [ ! -f "$MANIFEST_PATH" ] && [ -f "/opt/floworkos/apps/${APP_ID}/app.json" ]; then
    MANIFEST_PATH="/opt/floworkos/apps/${APP_ID}/app.json"
fi

SANDBOX_BIN="/opt/floworkos/bin/flowork-sandbox-exec"
if [ -x "$SANDBOX_BIN" ] && [ -f "$MANIFEST_PATH" ]; then
    LAUNCH_ARGS=("${ARGS[@]}")
    if head -c 2 "$CMD" 2>/dev/null | grep -q '^#!' && grep -q -- '--foreground' "$CMD" 2>/dev/null; then
        if [ "${ARGS[0]:-}" != "--foreground" ] && [ "${ARGS[0]:-}" != "-f" ]; then
            LAUNCH_ARGS=("--foreground" "${ARGS[@]}")
        fi
    fi
    exec "$SANDBOX_BIN" --app-id "$APP_ID" --manifest "$MANIFEST_PATH" --detach -- "$CMD" "${LAUNCH_ARGS[@]}"
fi

LOG_DIR="${HOME}/.flowork/logs"
mkdir -p "$LOG_DIR"
chmod 700 "$LOG_DIR" 2>/dev/null || true
SAFE_LOG_ID=$(printf '%s' "$APP_ID" | tr -c 'A-Za-z0-9._-' '_')
LOG_FILE="${LOG_DIR}/flowork_launch_${SAFE_LOG_ID}.log"

# Clean previous log
: > "$LOG_FILE"
chmod 600 "$LOG_FILE" 2>/dev/null || true

# Spawn detached session with setsid, closing stdin, stdout, and stderr
setsid "$CMD" "${ARGS[@]}" >"$LOG_FILE" 2>&1 &
APP_PID=$!

# Instant health verification probe (0.25s)
sleep 0.25

if kill -0 "$APP_PID" 2>/dev/null; then
    python3 -c 'import json,sys; print(json.dumps({"status":"running","pid":int(sys.argv[1]),"cmd":sys.argv[2]}))' "$APP_PID" "$CMD"
    exit 0
else
    # Process died immediately; check error output
    ERR_MSG=$(head -n 5 "$LOG_FILE" 2>/dev/null || echo "Unknown crash")
    echo "❌ Launch failure for $CMD (PID $APP_PID exited immediately): $ERR_MSG" >&2
    exit 1
fi
