#!/usr/bin/env bash
# ==============================================================================
# Flowork Sovereign AI Connector Universal Launcher
# Compatible across all x86-64 CPU architectures (Ivy Bridge, Haswell, Zen, etc.)
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export FLOWORK_CONNECTOR_DIR="${FLOWORK_CONNECTOR_DIR:-$SCRIPT_DIR}"
export MRFLOW_CONNECTOR_DIR="${MRFLOW_CONNECTOR_DIR:-$SCRIPT_DIR}"
export NODE_ENV="${NODE_ENV:-production}"
export PORT="${PORT:-9099}"
export HOST="${HOST:-127.0.0.1}"

# Primary runner: System Node.js runtime
if command -v node >/dev/null 2>&1; then
    exec node "$SCRIPT_DIR/server/index.js" "$@"
elif [ -x "/usr/local/bin/node" ]; then
    exec /usr/local/bin/node "$SCRIPT_DIR/server/index.js" "$@"
elif [ -x "/usr/bin/node" ]; then
    exec /usr/bin/node "$SCRIPT_DIR/server/index.js" "$@"
fi

# Fallback: Compiled binary if CPU supports required instruction sets
if [ -x "$SCRIPT_DIR/bin/flowork-connector.bun-avx2" ]; then
    exec "$SCRIPT_DIR/bin/flowork-connector.bun-avx2" "$@"
fi

echo "[Flowork Connector] FATAL: Node.js runtime not found." >&2
exit 1
