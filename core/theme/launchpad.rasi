configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "⚡";
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "Inter 11";
    bg: #141b2b;
    bg-card: rgba(255, 255, 255, 0.05);
    bg-card-hover: rgba(0, 229, 255, 0.15);
    bg-input: rgba(255, 255, 255, 0.08);
    border-glass: rgba(255, 255, 255, 0.18);
    border-glow: #00e5ff;
    fg-main: #ffffff;
    fg-dim: rgba(255, 255, 255, 0.65);
    accent: #00e5ff;
    
    background-color: transparent;
    text-color: @fg-main;
    margin: 0;
    padding: 0;
    spacing: 0;
    border: 0;
}

window {
    location: center;
    anchor: center;
    width: 860px;
    height: 520px;
    background-color: @bg;
    border: 1px;
    border-color: @border-glass;
    border-radius: 24px;
    padding: 28px 32px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 24px;
}

inputbar {
    background-color: @bg-input;
    border: 1px;
    border-color: @border-glass;
    border-radius: 16px;
    padding: 12px 20px;
    spacing: 12px;
    margin: 0px 30px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    font: "Inter Bold 13";
    vertical-align: 0.5;
}

entry {
    background-color: transparent;
    placeholder: "Search applications or tools...";
    placeholder-color: @fg-dim;
    text-color: #ffffff;
    cursor: text;
    vertical-align: 0.5;
    font: "Inter 11";
}

listview {
    background-color: transparent;
    columns: 5;
    lines: 3;
    cycle: true;
    dynamic: true;
    layout: vertical;
    spacing: 16px;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 16px 10px;
    border-radius: 16px;
    spacing: 10px;
    background-color: transparent;
    cursor: pointer;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @fg-main;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @bg-card-hover;
    text-color: @accent;
    border: 1px;
    border-color: @border-glow;
    border-radius: 16px;
}

element-icon {
    background-color: transparent;
    size: 52px;
    horizontal-align: 0.5;
    cursor: pointer;
}

element-text {
    background-color: transparent;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    font: "Inter Medium 11";
    cursor: pointer;
}

element selected.normal element-text,
element selected.active element-text {
    background-color: transparent;
    text-color: @accent;
    font: "Inter Bold 11";
}
