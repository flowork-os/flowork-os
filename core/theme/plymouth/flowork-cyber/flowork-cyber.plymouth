[Plymouth Theme]
Name=Flowork Cyber
Description=Cybernetic animated boot splash for Flowork OS Sovereign Neural Desktop
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Ubuntu Light 28
ImageDir=/usr/share/plymouth/themes/flowork-cyber
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.48
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.92
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x08090d
BackgroundEndColor=0x08090d
ProgressBarBackgroundColor=0x151922
ProgressBarForegroundColor=0x00f3ff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Sovereign Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Flowork OS Core...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Updating Hardware Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting Flowork OS Enclave...
SubTitle=Do not turn off your computer
